/* app.wxss - 全局样式 */

page {
  background-color: #F6F8FB;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: #17212B;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 通用卡片样式 */
.section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
  box-shadow: 0 10rpx 28rpx rgba(23, 33, 43, 0.05);
  position: relative;
  overflow: hidden;
}

.section-card::before {
  display: none;
}

/* 通用按钮样式 */
.btn-primary {
  background: #12B7A8;
  color: #FFFFFF;
  border-radius: 18rpx;
  padding: 24rpx 32rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 10rpx 24rpx rgba(18, 183, 168, 0.22);
  transition: all 0.2s ease;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(18, 183, 168, 0.18);
}

/* 通用标题样式 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #17212B;
  letter-spacing: 0;
}

/* 通用文本颜色 */
.text-secondary {
  color: #7A8794;
}

.text-primary {
  color: #17212B;
}
