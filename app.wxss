/* app.wxss - 全局样式 */

page {
  background-color: #FFF9F5;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  color: #4A4A4A;
  font-size: 28rpx;
  line-height: 1.5;
}

/* 通用卡片样式 - 增加层次感和阴影 */
.section-card {
  background: linear-gradient(145deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 44rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 4rpx 20rpx rgba(154, 151, 170, 0.15),
    0 1rpx 3rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
}

/* 卡片顶部高光 */
.section-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
}

/* 通用按钮样式 - 增加立体感和交互反馈 */
.btn-primary {
  background: linear-gradient(180deg, #B8FFF7 0%, #A7FBF5 50%, #96F0E8 100%);
  color: #4A4A4A;
  border-radius: 60rpx;
  padding: 24rpx 0;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  box-shadow: 
    0 4rpx 12rpx rgba(167, 251, 245, 0.4),
    0 2rpx 4rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  transition: all 0.2s ease;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: translateY(2rpx);
  box-shadow: 
    0 2rpx 6rpx rgba(167, 251, 245, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}

/* 通用标题样式 */
.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A4A4A;
  letter-spacing: 0.5rpx;
}

/* 通用文本颜色 */
.text-secondary {
  color: #9A97AA;
}

.text-primary {
  color: #4A4A4A;
}
