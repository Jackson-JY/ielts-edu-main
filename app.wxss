/* app.wxss - 全局样式
 * 设计系统：借鉴 Apple 设计语言，保留品牌薄荷绿 #12B7A8
 * 文档参考：IELTS-MiniProgram-UI-Optimization-Plan.md
 */

page {
  /* 中性背景：银雾灰，替代冷灰蓝 */
  background-color: #F5F5F7;
  /* 字体栈：优先 SF Pro，回退到 system */
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
  /* 主文字色：Apple System Primary */
  color: #1D1D1F;
  font-size: 28rpx;
  line-height: 1.5;
}

/* ==================== 通用卡片 ==================== */
/* 用边框定义边界，阴影极克制 */
.section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  position: relative;
  overflow: hidden;
}

.section-card::before {
  display: none;
}

/* ==================== 通用按钮：胶囊形 ==================== */
.btn-primary {
  height: 88rpx;
  line-height: 88rpx;
  padding: 0 48rpx;
  border-radius: 999px;
  background: #12B7A8;
  color: #FFFFFF;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  /* 无投影，按压用亮度反馈 */
  box-shadow: none;
  transition: filter 0.18s ease;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  filter: brightness(0.92);
}

.btn-primary[disabled],
.btn-primary.is-disabled {
  background: #12B7A8;
  opacity: 0.42;
}

/* 次按钮：浅灰填充 */
.btn-secondary {
  height: 80rpx;
  line-height: 80rpx;
  padding: 0 40rpx;
  border-radius: 999px;
  background: #F2F2F7;
  color: #12B7A8;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: filter 0.18s ease;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  filter: brightness(0.96);
  background: #E5E5EA;
}

/* 文字按钮 */
.btn-text {
  height: 64rpx;
  line-height: 64rpx;
  padding: 0 8rpx;
  background: transparent;
  color: #12B7A8;
  font-size: 28rpx;
  font-weight: 500;
  border: none;
}

.btn-text::after {
  border: none;
}

.btn-text:active {
  opacity: 0.6;
}

/* ==================== 通用标题 ==================== */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.01em;
}

/* 大标题：负字距增强紧凑感 */
.display-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

/* eyebrow 标签：全大写、字距展开 */
.eyebrow {
  font-size: 20rpx;
  font-weight: 600;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

/* ==================== 通用文本颜色 ==================== */
.text-primary {
  color: #1D1D1F;
}

.text-secondary {
  color: #6E6E73;
}

.text-tertiary {
  color: #8E8E93;
}

/* 品牌强调色 */
.text-brand {
  color: #12B7A8;
}

.text-brand-dark {
  color: #0E8C81;
}

.text-error {
  color: #FF3B30;
}

/* ==================== 通用输入框 ==================== */
.input-field {
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  font-size: 30rpx;
  color: #1D1D1F;
  box-sizing: border-box;
}

.input-field:focus {
  border-color: #12B7A8;
}

.input-field::placeholder {
  color: #8E8E93;
}

/* ==================== 通用 chip 标签 ==================== */
.chip {
  display: inline-flex;
  align-items: center;
  height: 48rpx;
  padding: 0 20rpx;
  border-radius: 999px;
  background: #F2F2F7;
  color: #6E6E73;
  font-size: 24rpx;
  font-weight: 500;
}

.chip-active {
  background: #12B7A8;
  color: #FFFFFF;
}

/* ==================== 通用分割 ==================== */
.divider {
  height: 1rpx;
  background: #E5E5EA;
}

/* ==================== 按压态通用 ==================== */
.tap-state {
  transition: background-color 0.15s ease;
}

.tap-state:active {
  background: rgba(0, 0, 0, 0.04);
}
