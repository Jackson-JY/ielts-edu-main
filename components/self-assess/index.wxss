/* components/self-assess/index.wxss */
.sa-wrap {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 顶部 */
.sa-header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sa-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.02em;
}

.sa-subtitle {
  font-size: 24rpx;
  color: #6E6E73;
  line-height: 1.5;
}

.sa-progress-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 8rpx;
}

.sa-progress-bar {
  flex: 1;
  height: 8rpx;
  background: #E5E5EA;
  border-radius: 999px;
  overflow: hidden;
}

.sa-progress-fill {
  height: 100%;
  background: #12B7A8;
  border-radius: 999px;
  transition: width 0.3s ease;
}

.sa-progress-text {
  font-size: 24rpx;
  color: #8E8E93;
  min-width: 80rpx;
  text-align: right;
  font-variant-numeric: tabular-nums;
}

/* 描述卡片 */
.sa-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  animation: sa-fade-in 0.25s ease-out;
}

@keyframes sa-fade-in {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

.sa-index {
  font-size: 22rpx;
  color: #6E6E73;
  background: #E6F7F5;
  padding: 8rpx 24rpx;
  border-radius: 999px;
}

.sa-statement {
  font-size: 32rpx;
  color: #1D1D1F;
  line-height: 1.7;
  text-align: center;
  min-height: 160rpx;
  display: flex;
  align-items: center;
}

/* 滑动条打分 */
.sa-slider-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.sa-slider-current {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.sa-slider-num {
  font-size: 72rpx;
  font-weight: 700;
  color: #0E8C81;
  line-height: 1.2;
  font-variant-numeric: tabular-nums;
}

.sa-slider-desc {
  font-size: 26rpx;
  color: #12B7A8;
  font-weight: 600;
}

.sa-slider-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  width: 100%;
  padding: 0 8rpx;
}

.sa-slider {
  flex: 1;
}

.sa-slider-end-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #8E8E93;
  min-width: 32rpx;
  text-align: center;
}

.sa-slider-ticks {
  display: flex;
  justify-content: space-between;
  width: 100%;
  padding: 0 8rpx;
}

.sa-tick {
  font-size: 22rpx;
  color: #8E8E93;
  width: 32rpx;
  text-align: center;
}

.sa-score-placeholder {
  color: #8E8E93;
  font-weight: 400;
}

/* 底部操作 */
.sa-actions {
  display: flex;
  gap: 24rpx;
}

.sa-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  transition: filter 0.18s ease;
}

.sa-btn-primary {
  background: #12B7A8;
  color: #FFFFFF;
}

.sa-btn-primary:active {
  filter: brightness(0.92);
}

.sa-btn-secondary {
  background: #F2F2F7;
  color: #12B7A8;
}

.sa-btn-secondary:active {
  background: #E5E5EA;
}

.sa-btn-disabled {
  opacity: 0.42;
}
