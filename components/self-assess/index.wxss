/* components/self-assess/index.wxss */
.sa-wrap {
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 顶部 */
.sa-header {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.sa-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.sa-subtitle {
  font-size: 24rpx;
  color: #9A97AA;
  line-height: 1.5;
}

.sa-progress-row {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-top: 8rpx;
}

.sa-progress-bar {
  flex: 1;
  height: 14rpx;
  background: #ECE8F4;
  border-radius: 8rpx;
  overflow: hidden;
}

.sa-progress-fill {
  height: 100%;
  background: #A7FBF5;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.sa-progress-text {
  font-size: 24rpx;
  color: #9A97AA;
  min-width: 80rpx;
  text-align: right;
}

/* 描述卡片 */
.sa-card {
  background: #FFFFFF;
  border-radius: 44rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(23, 33, 43, 0.06);
}

.sa-index {
  font-size: 22rpx;
  color: #9A97AA;
  background: #F5F0FF;
  padding: 8rpx 24rpx;
  border-radius: 24rpx;
}

.sa-statement {
  font-size: 32rpx;
  color: #4A4A4A;
  line-height: 1.7;
  text-align: center;
  min-height: 160rpx;
  display: flex;
  align-items: center;
}

/* 打分 */
.sa-scores {
  display: flex;
  gap: 16rpx;
  width: 100%;
  justify-content: center;
}

.sa-score-btn {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  background: #F6F8FB;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
}

.sa-score-num {
  font-size: 32rpx;
  font-weight: 600;
  color: #7A8794;
}

.sa-score-active {
  background: #A7FBF5;
  border-color: #12B7A8;
}

.sa-score-active .sa-score-num {
  color: #0E8C80;
}

.sa-score-label {
  font-size: 26rpx;
  color: #12B7A8;
  font-weight: 600;
}

.sa-score-placeholder {
  color: #B8BFC9;
  font-weight: 400;
}

/* 底部操作 */
.sa-actions {
  display: flex;
  gap: 24rpx;
}

.sa-btn {
  flex: 1;
  padding: 28rpx 0;
  border-radius: 60rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
}

.sa-btn-primary {
  background: #A7FBF5;
  color: #0E8C80;
}

.sa-btn-secondary {
  background: #F6F8FB;
  color: #4A4A4A;
}

.sa-btn-disabled {
  opacity: 0.4;
}
