<!-- components/self-assess/index.wxml -->
<view class="sa-wrap">
  <!-- 顶部进度 -->
  <view class="sa-header">
    <text class="sa-title">{{title}}</text>
    <text class="sa-subtitle">{{subtitle}}</text>
    <view class="sa-progress-row">
      <view class="sa-progress-bar">
        <view class="sa-progress-fill" style="width: {{(current + 1) / total * 100}}%"></view>
      </view>
      <text class="sa-progress-text">{{current + 1}}/{{total}}</text>
    </view>
  </view>

  <!-- 描述卡片 -->
  <view class="sa-card">
    <text class="sa-index">第 {{current + 1}} 条</text>
    <text class="sa-statement">{{items[current]}}</text>

    <!-- 0-5 滑动条打分 -->
    <view class="sa-slider-wrap">
      <view class="sa-slider-current">
        <text class="sa-slider-num">{{ratings[current] !== null ? ratings[current] : '--'}}</text>
        <text class="sa-slider-desc" wx:if="{{ratings[current] !== null}}">{{scoreLabels[ratings[current]]}}</text>
        <text class="sa-slider-desc sa-score-placeholder" wx:else>滑动打分</text>
      </view>
      <view class="sa-slider-row">
        <text class="sa-slider-end-label">0</text>
        <slider
          class="sa-slider"
          min="0"
          max="5"
          step="1"
          value="{{ratings[current] !== null ? ratings[current] : 0}}"
          show-value="{{false}}"
          block-size="28"
          block-color="#12B7A8"
          activeColor="#12B7A8"
          backgroundColor="#E5E5EA"
          bindchange="onSliderChange"
          bindchanging="onSliderChanging" />
        <text class="sa-slider-end-label">5</text>
      </view>
      <view class="sa-slider-ticks">
        <text class="sa-tick" wx:for="{{scores}}" wx:for-item="item" wx:key="*this">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 底部操作 -->
  <view class="sa-actions">
    <view class="sa-btn sa-btn-secondary {{current === 0 ? 'sa-btn-disabled' : ''}}" bindtap="goPrev">上一条</view>
    <view
      class="sa-btn sa-btn-secondary {{current >= total - 1 ? 'sa-btn-disabled' : ''}}"
      wx:if="{{current < total - 1}}"
      bindtap="goNext">下一条</view>
    <view class="sa-btn sa-btn-primary" wx:if="{{current === total - 1}}" bindtap="onFinish">完成自评</view>
  </view>
</view>
