<!-- components/self-assess/index.wxml -->
<view class="sa-wrap">
  <!-- 顶部进度 -->
  <view class="sa-header">
    <text class="sa-title">{{title}}</text>
    <text class="sa-subtitle">{{subtitle}}</text>
    <view class="sa-progress-row">
      <view class="sa-progress-bar">
        <view class="sa-progress-fill" style="width: {{(current + 1) / total * 100}}%"></view>
      </view>
      <text class="sa-progress-text">{{current + 1}}/{{total}}</text>
    </view>
  </view>

  <!-- 描述卡片 -->
  <view class="sa-card">
    <text class="sa-index">第 {{current + 1}} 条</text>
    <text class="sa-statement">{{items[current]}}</text>

    <!-- 0-5 打分 -->
    <view class="sa-scores">
      <view
        class="sa-score-btn {{ratings[current] === item ? 'sa-score-active' : ''}}"
        wx:for="{{scores}}"
        wx:for-item="item"
        wx:key="*this"
        bindtap="selectScore"
        data-score="{{item}}">
        <text class="sa-score-num">{{item}}</text>
      </view>
    </view>
    <text class="sa-score-label" wx:if="{{ratings[current] !== null}}">{{scoreLabels[ratings[current]]}}</text>
    <text class="sa-score-label sa-score-placeholder" wx:else>点击分数打分</text>
  </view>

  <!-- 底部操作 -->
  <view class="sa-actions">
    <view class="sa-btn sa-btn-secondary {{current === 0 ? 'sa-btn-disabled' : ''}}" bindtap="goPrev">上一条</view>
    <view
      class="sa-btn sa-btn-secondary {{current >= total - 1 ? 'sa-btn-disabled' : ''}}"
      wx:if="{{current < total - 1}}"
      bindtap="goNext">下一条</view>
    <view class="sa-btn sa-btn-primary" wx:if="{{current === total - 1}}" bindtap="onFinish">完成自评</view>
  </view>
</view>
