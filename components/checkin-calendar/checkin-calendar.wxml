<!--components/checkin-calendar/checkin-calendar.wxml-->
<!-- 打卡日历卡片（日历 + 图例） -->
<view class="section-card">
  <view class="section-header">
    <text class="section-title">打卡日历</text>
    <view class="checkin-btn" bindtap="showCheckinForm">
      <icon name="plus" color="#12B7A8" size="24rpx"/>
      <text class="checkin-btn-text">打卡</text>
    </view>
  </view>
  <view class="month-nav">
    <view class="month-btn" bindtap="prevMonth">
      <icon name="chevron-left" color="#1D1D1F" size="32rpx"/>
    </view>
    <text class="month-label">{{monthLabel}}</text>
    <view class="month-btn {{!canGoNext ? 'month-btn-disabled' : ''}}" bindtap="nextMonth">
      <icon name="chevron-right" color="#1D1D1F" size="32rpx"/>
    </view>
  </view>
  <view class="calendar-header">
    <text class="cal-day-label" wx:for="{{dayLabels}}" wx:key="index">{{item}}</text>
  </view>
  <view class="calendar-grid">
    <view
      class="calendar-cell {{item.hasCheckin ? 'has-checkin' : ''}} {{item.isToday ? 'today' : ''}}"
      wx:for="{{calendarDays}}"
      wx:key="day"
      style="background-color: {{item.heatColor}};"
      data-date="{{item.date}}"
      data-count="{{item.heatCount}}"
      bindtap="onTapCalendarCell"
    >
      <text class="cal-day-num {{item.isEmpty ? 'cal-day-empty' : (item.hasCheckin ? 'cal-day-active' : 'cal-day-inactive')}}">{{item.day}}</text>
      <view class="cal-type-bars" wx:if="{{!item.isEmpty}}">
        <view
          class="cal-type-bar"
          wx:for="{{item.types}}"
          wx:for-item="type"
          wx:key="index"
          style="background-color: {{type.color}};"
        ></view>
      </view>
    </view>
  </view>
  <!-- 热力图例：薄荷绿系 -->
  <view class="heatmap-legend">
    <text class="legend-label">少</text>
    <view class="legend-cell" style="background-color: #F2F2F7;"></view>
    <view class="legend-cell" style="background-color: #E6F7F5;"></view>
    <view class="legend-cell" style="background-color: #80DED5;"></view>
    <view class="legend-cell" style="background-color: #12B7A8;"></view>
    <view class="legend-cell" style="background-color: #0E8C81;"></view>
    <text class="legend-label">多</text>
  </view>
</view>

<!-- 打卡明细弹窗 -->
<view class="modal-overlay" wx:if="{{showCheckinDetail}}">
  <view class="modal-mask" bindtap="hideCheckinDetail"></view>
  <view class="modal-content checkin-detail-modal">
    <view class="modal-header">
      <text class="modal-title">{{selectedDate}} 打卡记录</text>
      <text class="modal-subtitle">共 {{selectedDateCheckins.length}} 次打卡</text>
    </view>

    <scroll-view class="checkin-detail-list" scroll-y>
      <block wx:if="{{selectedDateCheckins.length > 0}}">
        <view class="checkin-detail-item" wx:for="{{selectedDateCheckins}}" wx:key="id">
          <view class="detail-time">
            <icon name="clock" color="#8E8E93" size="20rpx"/>
            <text class="time-text">{{item.time}}</text>
          </view>
          <view class="detail-content">
            <view class="detail-types">
              <text class="detail-type-tag" wx:for="{{item.types}}" wx:for-item="type" wx:key="index" style="background-color: {{type.color}};">{{type.label}}</text>
              <text class="detail-duration-tag" wx:if="{{item.duration > 0}}">{{item.duration}} 分钟</text>
            </view>
            <text class="detail-text" wx:if="{{item.content}}">{{item.content}}</text>
          </view>
        </view>
      </block>
      <view class="checkin-detail-empty" wx:else>
        <view class="empty-icon-wrap">
          <icon name="calendar" color="#8E8E93" size="48rpx"/>
        </view>
        <text class="empty-text">该日期暂无打卡记录</text>
      </view>
    </scroll-view>

    <view class="modal-buttons">
      <view class="modal-btn confirm" bindtap="hideCheckinDetail">
        <text>关闭</text>
      </view>
    </view>
  </view>
</view>

<!-- 打卡表单弹窗 -->
<view class="modal-overlay" wx:if="{{showCheckinForm}}">
  <view class="modal-mask" bindtap="hideCheckinForm"></view>
  <view class="modal-content">
    <view class="modal-header">
      <text class="modal-title">今日打卡</text>
      <text class="modal-subtitle">记录今天的学习进度</text>
    </view>

    <view class="form-group">
      <text class="form-label">打卡类型（可多选）</text>
      <view class="checkin-type-grid">
        <view class="checkin-type-item {{item.selected ? 'selected' : ''}}"
              wx:for="{{checkinTypeList}}"
              wx:key="id"
              data-id="{{item.id}}"
              bindtap="toggleCheckinType">
          <view class="type-color" style="background-color: {{item.color}};"></view>
          <text class="type-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <view class="form-group">
      <text class="form-label">学习时长（分钟）</text>
      <input class="checkin-duration-input"
             type="number"
             placeholder="请输入本次学习时长"
             value="{{checkinDuration}}"
             bindinput="onCheckinDurationInput"/>
    </view>

    <view class="form-group">
      <text class="form-label">备注内容</text>
      <textarea class="checkin-textarea"
                placeholder="记录今天的学习心得"
                value="{{checkinContent}}"
                bindinput="onCheckinContentInput"
                maxlength="200"/>
      <text class="textarea-count">{{checkinContent.length}}/200</text>
    </view>

    <view class="modal-buttons">
      <view class="modal-btn cancel" bindtap="hideCheckinForm">
        <text>取消</text>
      </view>
      <view class="modal-btn confirm {{canSubmitCheckin ? '' : 'disabled'}}" bindtap="submitCheckin">
        <text>确认打卡</text>
      </view>
    </view>
  </view>
</view>
