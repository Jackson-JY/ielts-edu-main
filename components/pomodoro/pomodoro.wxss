/* components/pomodoro/pomodoro.wxss */

/* ====================== 遮罩 ====================== */
.pomodoro-mask {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.32);
  z-index: 900;
}

/* ====================== 抽屉主体 ====================== */
.pomodoro-drawer {
  position: fixed;
  left: 0; right: 0; bottom: 0;
  z-index: 901;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding: 0 36rpx 60rpx;
  animation: drawer-slide-up 0.25s ease-out;
}

@keyframes drawer-slide-up {
  from { transform: translateY(100%); }
  to   { transform: translateY(0);    }
}

/* ─── 顶部把手 ─── */
.drawer-handle-wrap {
  display: flex;
  justify-content: center;
  padding: 16rpx 0 4rpx;
}

.drawer-handle {
  width: 80rpx;
  height: 8rpx;
  border-radius: 999rpx;
  background: #E5E5EA;
}

/* ─── 标题栏 ─── */
.drawer-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0 8rpx;
}

.drawer-title-wrap {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.drawer-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.01em;
}

.close-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.close-btn:active {
  filter: brightness(0.92);
}

/* ====================== 圆环计时区 ====================== */
.timer-section {
  display: flex;
  justify-content: center;
  padding: 32rpx 0 24rpx;
}

.ring-wrap {
  position: relative;
  width: 300rpx;
  height: 300rpx;
}

/* 外圆：conic-gradient 画填充弧 */
.ring-track {
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F2F2F7;
}

.ring-fill {
  position: absolute;
  left: 0; top: 0;
  width: 300rpx;
  height: 300rpx;
  border-radius: 50%;
}

/* 内圆白色遮罩 → 空心环视觉 */
.ring-inner {
  position: relative;
  z-index: 2;
  width: 236rpx;
  height: 236rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
}

.timer-digits {
  font-size: 72rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.02em;
  line-height: 1;
}

.timer-phase {
  font-size: 24rpx;
  color: #6E6E73;
  font-weight: 500;
}

.round-badges {
  display: flex;
  gap: 4rpx;
  margin-top: 4rpx;
}

/* ====================== 操作按钮行 ====================== */
.ctrl-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.ctrl-btn {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  height: 88rpx;
  border-radius: 999rpx;
  box-sizing: border-box;
}

.ctrl-btn:active {
  filter: brightness(0.92);
}

/* 主按钮（大胶囊形） */
.ctrl-primary {
  padding: 0 40rpx;
  background: #12B7A8;
  color: #FFFFFF;
}

/* 休息态主按钮：系统绿 */
.ctrl-primary.ctrl-rest {
  background: #34C759;
}

/* 次级按钮（胶囊） */
.ctrl-secondary {
  padding: 0 24rpx;
  background: #F2F2F7;
  color: #12B7A8;
}

.ctrl-disabled {
  opacity: 0.5;
}

.ctrl-placeholder {
  visibility: hidden;
}

.ctrl-label {
  font-size: 26rpx;
  color: #12B7A8;
  font-weight: 600;
}

.ctrl-label-primary {
  font-size: 28rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ====================== 时长配置 ====================== */
.config-row {
  display: flex;
  gap: 32rpx;
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: #F5F5F7;
  border-radius: 24rpx;
}

.config-group {
  display: flex;
  flex-direction: column;
  gap: 10rpx;
}

.config-label {
  font-size: 22rpx;
  color: #6E6E73;
  font-weight: 600;
}

.config-chips {
  display: flex;
  flex-wrap: nowrap;
  gap: 12rpx;
}

.config-chip {
  height: 56rpx;
  padding: 0 22rpx;
  border-radius: 999rpx;
  background: #F2F2F7;
  color: #6E6E73;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  white-space: nowrap;  /* 禁止文字换行 */
  flex-shrink: 0;       /* 不被 flex 容器压缩宽度 */
}

.config-chip:active {
  filter: brightness(0.92);
}

.config-chip.selected {
  background: #12B7A8;
  color: #FFFFFF;
}

/* ====================== 关联作业 ====================== */
.homework-link-row {
  margin-bottom: 20rpx;
}

.link-label {
  display: block;
  font-size: 24rpx;
  color: #6E6E73;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.link-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
  padding: 18rpx 20rpx;
  background: #F2F2F7;
  border-radius: 24rpx;
}

.link-card:active {
  filter: brightness(0.96);
}

.link-card-inner {
  min-width: 0;
  flex: 1;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.link-subject-tag {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  color: #12B7A8;
  background: #E6F7F5;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.link-content {
  font-size: 24rpx;
  color: #1D1D1F;
  font-weight: 500;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.link-clear {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.link-clear:active {
  filter: brightness(0.92);
}

.link-empty {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 18rpx 20rpx;
  background: #F2F2F7;
  border-radius: 24rpx;
}

.link-empty:active {
  filter: brightness(0.96);
}

.link-empty-text {
  font-size: 24rpx;
  color: #8E8E93;
}

/* ─── 作业选择面板（Action Sheet 风格）─── */
.homework-picker {
  max-height: 300rpx;
  overflow-y: auto;
  border-radius: 32rpx 32rpx 0 0;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  margin-bottom: 16rpx;
}

.picker-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 24rpx;
  border-bottom: 1rpx solid #E5E5EA;
}

.picker-item:last-child {
  border-bottom: none;
}

.picker-item:active {
  background: rgba(0, 0, 0, 0.04);
}

.picker-subject {
  flex-shrink: 0;
  font-size: 20rpx;
  font-weight: 700;
  color: #12B7A8;
  background: #E6F7F5;
  border-radius: 999rpx;
  padding: 4rpx 12rpx;
}

.picker-content {
  font-size: 24rpx;
  color: #1D1D1F;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.picker-free .picker-content {
  color: #6E6E73;
}

/* ─── 分组标题 ─── */
.picker-group-label {
  padding: 14rpx 24rpx 6rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: #8E8E93;
  letter-spacing: 1rpx;
}

/* 任务标签：中性灰，与作业薄荷绿区分 */
.picker-subject-task {
  color: #6E6E73;
  background: #F2F2F7;
}

/* ─── 新建任务 ─── */
.picker-new-task {
  border-bottom: none;
}

.picker-new-task-text {
  color: #12B7A8;
  font-weight: 700;
}

.new-task-form {
  padding: 16rpx 24rpx 20rpx;
  border-bottom: 1rpx solid #E5E5EA;
}

.new-task-input {
  width: 100%;
  min-height: 72rpx;
  padding: 16rpx;
  border-radius: 16rpx;
  background: #F2F2F7;
  font-size: 26rpx;
  color: #1D1D1F;
  box-sizing: border-box;
  margin-bottom: 12rpx;
}

.new-task-ph {
  color: #8E8E93;
}

.new-task-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.new-task-time {
  flex: 1;
  min-width: 0;
  height: 72rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #F2F2F7;
  font-size: 25rpx;
  color: #1D1D1F;
  box-sizing: border-box;
}

.new-task-cancel {
  flex-shrink: 0;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #F2F2F7;
  color: #6E6E73;
  font-size: 25rpx;
  font-weight: 600;
}

.new-task-confirm {
  flex-shrink: 0;
  padding: 0 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  border-radius: 999rpx;
  background: #12B7A8;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 700;
}

.new-task-confirm:active {
  filter: brightness(0.92);
}

.new-task-confirm.disabled {
  opacity: 0.5;
}

/* ====================== 统计区（今日 + 累计）====================== */
.stats-block {
  background: #F5F5F7;
  border-radius: 24rpx;
  margin-top: 8rpx;
  overflow: hidden;
}

/* 今日行 / 累计行共用 */
.stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 18rpx 32rpx;
}

.stat-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 5rpx;
}

/* 今日数字：品牌色 */
.stat-value {
  font-size: 34rpx;
  font-weight: 700;
  color: #12B7A8;
  line-height: 1;
}

/* 累计数字：低对比度灰，区分今日 */
.stat-value-total {
  color: #8E8E93;
  font-size: 28rpx;
}

.stat-label {
  font-size: 20rpx;
  color: #6E6E73;
}

/* 今日/累计两行之间的横向分隔线 */
.stats-h-divider {
  height: 1rpx;
  background: #E5E5EA;
  margin: 0 24rpx;
}

/* 今日/累计同行内两列之间的竖向分隔线 */
.stat-divider {
  width: 1rpx;
  height: 44rpx;
  background: #E5E5EA;
  margin: 0 16rpx;
}
