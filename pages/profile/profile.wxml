<!-- pages/profile/profile.wxml -->
<wxs module="utils">
module.exports = {
  indexOf: function(arr, value) {
    return arr.indexOf(value);
  }
}
</wxs>
<view class="page">
  <!-- 个人信息卡片（点击头像/昵称可编辑资料） -->
  <view class="profile-card">
    <view class="profile-header">
      <view class="profile-info-left" bindtap="onTapEditProfile">
        <view class="avatar-wrap">
          <view class="avatar">
            <image class="avatar-icon" src="{{avatarUrl || defaultAvatarUrl || iconUser}}" mode="aspectFill"/>
          </view>
          <view class="avatar-edit-badge">
            <text class="avatar-edit-icon">✎</text>
          </view>
        </view>
        <view class="profile-info">
          <text class="user-name">{{userName}}</text>
          <text class="edit-profile-hint">点击修改资料</text>
        </view>
      </view>
      <!-- 退出按钮 -->
      <view class="login-action">
        <button wx:if="{{isLoggedIn}}" class="btn-logout" bindtap="handleLogout">退出登录</button>
      </view>
    </view>
  </view>

  <!-- 打卡统计 -->
  <view class="stats-card">
    <text class="streak-num">{{streakDays}}</text>
    <text class="streak-label">连续打卡天数</text>
    <view class="stats-row">
      <view class="stats-item">
        <text class="stats-value">{{weekCheckin}} / 7</text>
        <text class="stats-label">本周打卡</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <text class="stats-value">{{monthCheckin}} / 30</text>
        <text class="stats-label">本月打卡</text>
      </view>
    </view>
  </view>

  <!-- 番茄时钟入口卡片 -->
  <view class="pomodoro-entry-card" bindtap="onTapOpenPomodoro">
    <view class="pomodoro-entry-left">
      <text class="pomodoro-entry-icon">🍅</text>
      <view class="pomodoro-entry-info">
        <text class="pomodoro-entry-title">番茄时钟</text>
        <text class="pomodoro-entry-sub" wx:if="{{todayPomodoros > 0}}">今日 {{todayPomodoros}} 个 · 专注 {{todayFocusMinutes}} 分钟</text>
        <text class="pomodoro-entry-sub" wx:else>点击开始专注</text>
      </view>
    </view>
    <view class="pomodoro-entry-right">
      <text class="pomodoro-entry-arrow">›</text>
    </view>
  </view>

  <!-- 打卡日历（热力图） -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">打卡日历</text>
      <view class="checkin-btn" bindtap="showCheckinForm">
        <text class="checkin-btn-icon">+</text>
        <text class="checkin-btn-text">打卡</text>
      </view>
    </view>
    <!-- 月份选择导航 -->
    <view class="month-nav">
      <view class="month-btn" bindtap="prevMonth">
        <text class="month-arrow">‹</text>
      </view>
      <text class="month-label">{{monthLabel}}</text>
      <view class="month-btn {{!canGoNext ? 'month-btn-disabled' : ''}}" bindtap="nextMonth">
        <text class="month-arrow">›</text>
      </view>
    </view>
    <view class="calendar-header">
      <text class="cal-day-label" wx:for="{{dayLabels}}" wx:key="index">{{item}}</text>
    </view>
    <view class="calendar-grid">
      <view
        class="calendar-cell {{item.hasCheckin ? 'has-checkin' : ''}} {{item.isToday ? 'today' : ''}}"
        wx:for="{{calendarDays}}"
        wx:key="day"
        style="background-color: {{item.heatColor}};"
        data-date="{{item.date}}"
        data-count="{{item.heatCount}}"
        bindtap="onTapCalendarCell"
      >
        <text class="cal-day-num {{item.isEmpty ? 'cal-day-empty' : (item.hasCheckin ? 'cal-day-active' : 'cal-day-inactive')}}">{{item.day}}</text>
        <view class="cal-type-bars" wx:if="{{!item.isEmpty}}">
          <view
            class="cal-type-bar"
            wx:for="{{item.types}}"
            wx:for-item="type"
            wx:key="index"
            style="background-color: {{type.color}};"
          ></view>
        </view>
      </view>
    </view>
    <!-- 热力图例 -->
    <view class="heatmap-legend">
      <text class="legend-label">少</text>
      <view class="legend-cell" style="background-color: #FFF9F5;"></view>
      <view class="legend-cell" style="background-color: rgba(167,251,245,0.2);"></view>
      <view class="legend-cell" style="background-color: rgba(167,251,245,0.5);"></view>
      <view class="legend-cell" style="background-color: rgba(167,251,245,0.75);"></view>
      <view class="legend-cell" style="background-color: #A7FBF5;"></view>
      <text class="legend-label">多</text>
    </view>
  </view>

  <!-- 考试成绩记录 -->
  <view class="section-card">
    <view class="card-header">
      <text class="card-title">考试成绩记录</text>
      <view class="add-button" bindtap="showAddScoreModal">
        <text class="add-icon">+</text>
        <text class="add-text">添加成绩</text>
      </view>
    </view>
    
    <!-- 最新成绩 -->
    <block wx:if="{{examScores.length > 0}}">
      <view class="latest-score">
        <text class="score-date">最近一次考试 - {{examScores[0].date}}</text>
        <view class="total-score">
          <text class="score-value">{{examScores[0].total}}</text>
          <text class="score-label">总分</text>
        </view>
        <view class="score-details">
          <view class="score-item">
            <text class="score-label">听力</text>
            <text class="score-value">{{examScores[0].listening}}</text>
          </view>
          <view class="score-item">
            <text class="score-label">口语</text>
            <text class="score-value">{{examScores[0].speaking}}</text>
          </view>
          <view class="score-item">
            <text class="score-label">阅读</text>
            <text class="score-value">{{examScores[0].reading}}</text>
          </view>
          <view class="score-item">
            <text class="score-label">写作</text>
            <text class="score-value">{{examScores[0].writing}}</text>
          </view>
        </view>
      </view>
      
      <!-- 成绩趋势图 -->
      <view class="score-trend">
        <text class="trend-title">成绩趋势</text>
        <view class="trend-chart">
          <canvas type="2d" id="scoreTrendCanvas" class="trend-canvas"></canvas>
          <view class="trend-labels">
            <block wx:for="{{examScoresReverse}}" wx:key="index">
              <text class="trend-label">{{item.date}}</text>
            </block>
          </view>
        </view>
      </view>
    </block>
    
    <!-- 无成绩时的提示 -->
    <view class="empty-scores" wx:else>
      <text class="empty-text">暂无考试成绩记录</text>
      <text class="empty-sub">点击"添加成绩"记录您的雅思成绩</text>
    </view>
  </view>

  <!-- 管理员菜单 -->
  <view class="menu-list" wx:if="{{isAdmin}}">
    <view class="menu-item admin-menu" bindtap="goToScheduleManage">
      <view class="menu-icon">
        <image src="{{iconCalendar}}" mode="aspectFit" style="width: 48rpx; height: 48rpx;"/>
      </view>
      <text class="menu-label">排课管理</text>
      <text class="menu-arrow admin-badge">管理员</text>
    </view>
  </view>

  <!-- 菜单项 -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToAssessmentResult">
      <view class="menu-icon">
        <image src="{{iconTarget}}" mode="aspectFit" style="width: 48rpx; height: 48rpx;"/>
      </view>
      <text class="menu-label">测评结果</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goToLearningReport">
      <view class="menu-icon">
        <image src="{{iconChart}}" mode="aspectFit" style="width: 48rpx; height: 48rpx;"/>
      </view>
      <text class="menu-label">学习报告</text>
      <text class="menu-arrow">›</text>
    </view>

    <view class="menu-item" bindtap="goToAssessment">
      <view class="menu-icon">
        <image src="{{iconRefresh}}" mode="aspectFit" style="width: 48rpx; height: 48rpx;"/>
      </view>
      <text class="menu-label">重新测评</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 打卡明细弹窗 -->
  <view class="modal-overlay" wx:if="{{showCheckinDetail}}">
    <view class="modal-mask" bindtap="hideCheckinDetail"></view>
    <view class="modal-content checkin-detail-modal">
      <view class="modal-header">
        <text class="modal-title">{{selectedDate}} 打卡记录</text>
        <text class="modal-subtitle">共 {{selectedDateCheckins.length}} 次打卡</text>
      </view>
      
      <scroll-view class="checkin-detail-list" scroll-y>
        <block wx:if="{{selectedDateCheckins.length > 0}}">
          <view class="checkin-detail-item" wx:for="{{selectedDateCheckins}}" wx:key="id">
            <view class="detail-time">
              <image class="time-icon" src="{{iconCalendar}}" mode="aspectFit"/>
              <text class="time-text">{{item.time}}</text>
            </view>
            <view class="detail-content">
              <view class="detail-types">
                <text class="detail-type-tag" wx:for="{{item.types}}" wx:for-item="type" wx:key="index" style="background-color: {{type.color}};">{{type.label}}</text>
                <text class="detail-duration-tag" wx:if="{{item.duration > 0}}">⏱ {{item.duration}} 分钟</text>
              </view>
              <text class="detail-text" wx:if="{{item.content}}">{{item.content}}</text>
            </view>
          </view>
        </block>
        <view class="checkin-detail-empty" wx:else>
          <image class="empty-icon-img" src="{{iconDocument}}" mode="aspectFit"/>
          <text class="empty-text">该日期暂无打卡记录</text>
        </view>
      </scroll-view>
      
      <view class="modal-buttons">
        <view class="modal-btn confirm" bindtap="hideCheckinDetail">
          <text>关闭</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 打卡表单弹窗 -->
  <view class="modal-overlay" wx:if="{{showCheckinForm}}">
    <view class="modal-mask" bindtap="hideCheckinForm"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">今日打卡</text>
        <text class="modal-subtitle">记录今天的学习进度</text>
      </view>
      
      <!-- 打卡类型选择 -->
      <view class="form-group">
        <text class="form-label">打卡类型（可多选）</text>
        <view class="checkin-type-grid">
          <view class="checkin-type-item {{item.selected ? 'selected' : ''}}" 
                wx:for="{{checkinTypeList}}" 
                wx:key="id"
                data-id="{{item.id}}"
                bindtap="toggleCheckinType">
            <view class="type-color" style="background-color: {{item.color}};"></view>
            <text class="type-label">{{item.label}}</text>
          </view>
        </view>
      </view>
      
      <!-- 时长记录 -->
      <view class="form-group">
        <text class="form-label">学习时长（分钟）</text>
        <input class="checkin-duration-input"
               type="number"
               placeholder="请输入本次学习时长"
               value="{{checkinDuration}}"
               bindinput="onCheckinDurationInput"/>
      </view>

      <!-- 备注输入 -->
      <view class="form-group">
        <text class="form-label">备注内容</text>
        <textarea class="checkin-textarea" 
                  placeholder="记录今天的学习心得..."
                  value="{{checkinContent}}"
                  bindinput="onCheckinContentInput"
                  maxlength="200"/>
        <text class="textarea-count">{{checkinContent.length}}/200</text>
      </view>
      
      <view class="modal-buttons">
        <view class="modal-btn cancel" bindtap="hideCheckinForm">
          <text>取消</text>
        </view>
        <view class="modal-btn confirm {{canSubmitCheckin ? '' : 'disabled'}}" bindtap="submitCheckin">
          <text>确认打卡</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 编辑资料弹窗（一键登录后在此完善头像昵称） -->
  <view class="modal-overlay" wx:if="{{showEditProfile}}">
    <view class="modal-mask" bindtap="hideEditProfile"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">编辑资料</text>
        <text class="modal-subtitle">设置头像和昵称</text>
      </view>

      <!-- 头像选择（微信官方头像填写能力） -->
      <view class="form-group edit-avatar-group">
        <button class="edit-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onEditChooseAvatar">
          <image class="edit-avatar-img" src="{{editAvatarUrl || avatarUrl || defaultAvatarUrl || iconUser}}" mode="aspectFill"/>
          <view class="edit-avatar-badge">
            <text>✎</text>
          </view>
        </button>
        <text class="edit-avatar-hint">点击更换头像</text>
      </view>

      <!-- 昵称输入（微信官方昵称填写能力，自动联想微信昵称） -->
      <view class="form-group">
        <text class="form-label">昵称</text>
        <input
          class="edit-nickname-input"
          type="nickname"
          placeholder="请输入昵称"
          value="{{editNickName}}"
          bindinput="onEditNickNameInput"
        />
      </view>

      <view class="modal-buttons">
        <view class="modal-btn cancel" bindtap="hideEditProfile">
          <text>取消</text>
        </view>
        <view class="modal-btn confirm {{savingProfile ? 'disabled' : ''}}" bindtap="saveProfile">
          <text>{{savingProfile ? '保存中...' : '保存'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加成绩弹窗 -->
  <view class="modal-overlay" wx:if="{{showAddScore}}">
    <view class="modal-mask" bindtap="hideAddScoreModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">添加考试成绩</text>
        <text class="modal-subtitle">记录你的雅思模考成绩</text>
      </view>
      
      <!-- 日期选择 -->
      <view class="form-group">
        <text class="form-label">考试日期</text>
        <picker mode="date" value="{{newScore.date}}" start="2020-01-01" end="{{maxDate}}" bindchange="onDateChange">
          <view class="date-picker {{newScore.date ? 'date-picker-active' : ''}}">
            <image class="date-icon-img" src="{{iconCalendar}}" mode="aspectFit"/>
            <text class="date-text">{{newScore.date ? newScore.date : '请选择考试日期'}}</text>
            <text class="date-arrow">›</text>
          </view>
        </picker>
      </view>
      
      <!-- 分数输入 -->
      <view class="form-group">
        <text class="form-label">各项分数 (0-9分)</text>
        <view class="score-inputs">
          <view class="score-input-item">
            <view class="score-icon listening">
              <image src="{{iconHeadphones}}" mode="aspectFit" style="width: 36rpx; height: 36rpx;" />
            </view>
            <input 
              class="score-input" 
              type="digit" 
              placeholder="0.0" 
              value="{{newScore.listening}}"
              bindinput="onScoreInput"
              data-type="listening"
            />
            <text class="score-name">听力</text>
          </view>
          
          <view class="score-input-item">
            <view class="score-icon speaking">
              <image src="{{iconMic}}" mode="aspectFit" style="width: 36rpx; height: 36rpx;" />
            </view>
            <input 
              class="score-input" 
              type="digit" 
              placeholder="0.0" 
              value="{{newScore.speaking}}"
              bindinput="onScoreInput"
              data-type="speaking"
            />
            <text class="score-name">口语</text>
          </view>
          
          <view class="score-input-item">
            <view class="score-icon reading">
              <image src="{{iconBook}}" mode="aspectFit" style="width: 36rpx; height: 36rpx;" />
            </view>
            <input 
              class="score-input" 
              type="digit" 
              placeholder="0.0" 
              value="{{newScore.reading}}"
              bindinput="onScoreInput"
              data-type="reading"
            />
            <text class="score-name">阅读</text>
          </view>
          
          <view class="score-input-item">
            <view class="score-icon writing">
              <image src="{{iconPen}}" mode="aspectFit" style="width: 36rpx; height: 36rpx;" />
            </view>
            <input 
              class="score-input" 
              type="digit" 
              placeholder="0.0" 
              value="{{newScore.writing}}"
              bindinput="onScoreInput"
              data-type="writing"
            />
            <text class="score-name">写作</text>
          </view>
        </view>
      </view>
      
      <!-- 总分输入 -->
      <view class="form-group">
        <text class="form-label">总分 (0-9分)</text>
        <view class="total-input-wrap">
          <input 
            class="total-input" 
            type="digit" 
            placeholder="请输入总分" 
            value="{{newScore.total}}"
            bindinput="onScoreInput"
            data-type="total"
          />
        </view>
      </view>
      
      <view class="modal-buttons">
        <view class="modal-btn cancel" bindtap="hideAddScoreModal">
          <text>取消</text>
        </view>
        <view class="modal-btn confirm" bindtap="saveScore">
          <text>保存成绩</text>
        </view>
      </view>
    </view>
  </view>

</view>

<!-- 番茄时钟组件（固定浮层，在 page 外部挂载以避免被 scroll-view 裁切） -->
<pomodoro
  visible="{{showPomodoro}}"
  homeworkOptions="{{pomodoroHomeworkOptions}}"
  taskOptions="{{pomodoroTaskOptions}}"
  bind:close="onPomodoroClose"
  bind:sessionSaved="onPomodoroSessionSaved"
  bind:taskCreated="onPomodoroTaskCreated"
/>
