<!-- pages/profile/profile.wxml -->
<view class="page">
  <!-- 个人信息卡片：白色简洁卡片 -->
  <view class="profile-card">
    <view class="profile-header">
      <view class="profile-info-left" bindtap="onTapEditProfile">
        <view class="avatar-wrap">
          <view class="avatar">
            <image class="avatar-icon" src="{{avatarUrl || defaultAvatarUrl}}" mode="aspectFill"/>
          </view>
          <view class="avatar-edit-badge">
            <icon name="pen" color="#FFFFFF" size="20rpx"/>
          </view>
        </view>
        <view class="profile-info">
          <text class="user-name">{{userName}}</text>
          <text class="edit-profile-hint">点击修改资料</text>
        </view>
      </view>
      <view class="login-action">
        <button wx:if="{{isLoggedIn}}" class="btn-logout" bindtap="handleLogout">退出登录</button>
      </view>
    </view>
  </view>

  <!-- 打卡统计：超大数字 + 两列数据 -->
  <view class="stats-card">
    <text class="streak-num">{{streakDays}}</text>
    <text class="streak-label">连续打卡天数</text>
    <view class="stats-row">
      <view class="stats-item">
        <text class="stats-value">{{weekCheckin}} / 7</text>
        <text class="stats-label">本周打卡</text>
      </view>
      <view class="stats-divider"></view>
      <view class="stats-item">
        <text class="stats-value">{{monthCheckin}} / 30</text>
        <text class="stats-label">本月打卡</text>
      </view>
    </view>
  </view>

  <!-- 番茄专注入口：去掉 emoji，改时钟图标 -->
  <view class="pomodoro-entry-card" bindtap="onTapOpenPomodoro">
    <view class="pomodoro-entry-left">
      <view class="pomodoro-entry-icon-wrap">
        <icon name="clock" color="#12B7A8" size="36rpx"/>
      </view>
      <view class="pomodoro-entry-info">
        <text class="pomodoro-entry-title">番茄专注</text>
        <text class="pomodoro-entry-sub" wx:if="{{todayPomodoros > 0}}">今日 {{todayPomodoros}} 次 · 专注 {{todayFocusMinutes}} 分钟</text>
        <text class="pomodoro-entry-sub" wx:else>点击开始专注</text>
      </view>
    </view>
    <view class="pomodoro-entry-right">
      <icon name="chevron-right" color="#8E8E93" size="32rpx"/>
    </view>
  </view>

  <!-- 打卡日历（热力图 + 明细弹窗 + 打卡表单），逻辑内聚在组件中 -->
  <checkin-calendar bind:checkinsuccess="onCheckinSuccess" />

  <!-- 考试成绩记录 -->
  <view class="section-card">
    <view class="card-header">
      <text class="card-title">考试成绩记录</text>
      <view class="add-button" bindtap="showAddScoreModal">
        <icon name="plus" color="#12B7A8" size="24rpx"/>
        <text class="add-text">添加成绩</text>
      </view>
    </view>

    <!-- 最新成绩：薄荷绿总分大数字 + 四科分数横向排列 -->
    <block wx:if="{{examScores.length > 0}}">
      <view class="latest-score">
        <text class="score-date">最近一次考试 · {{examScores[0].date}}</text>
        <view class="total-score">
          <text class="score-value-total">{{examScores[0].total}}</text>
          <text class="score-label">总分</text>
        </view>
        <view class="score-details">
          <view class="score-item">
            <text class="score-item-label">听力</text>
            <text class="score-item-value">{{examScores[0].listening}}</text>
          </view>
          <view class="score-item">
            <text class="score-item-label">口语</text>
            <text class="score-item-value">{{examScores[0].speaking}}</text>
          </view>
          <view class="score-item">
            <text class="score-item-label">阅读</text>
            <text class="score-item-value">{{examScores[0].reading}}</text>
          </view>
          <view class="score-item">
            <text class="score-item-label">写作</text>
            <text class="score-item-value">{{examScores[0].writing}}</text>
          </view>
        </view>
      </view>

      <!-- 成绩趋势图 -->
      <view class="score-trend">
        <text class="trend-title">成绩趋势</text>
        <view class="trend-chart">
          <canvas type="2d" id="scoreTrendCanvas" class="trend-canvas"></canvas>
          <view class="trend-labels">
            <block wx:for="{{examScoresReverse}}" wx:key="index">
              <text class="trend-label">{{item.date}}</text>
            </block>
          </view>
        </view>
      </view>
    </block>

    <view class="empty-scores" wx:else>
      <view class="empty-icon-wrap">
        <icon name="trophy" color="#8E8E93" size="48rpx"/>
      </view>
      <text class="empty-text">暂无考试成绩记录</text>
      <text class="empty-sub">点击「添加成绩」记录你的雅思模考成绩</text>
    </view>
  </view>

  <!-- 管理员菜单 -->
  <view class="menu-list" wx:if="{{isAdmin}}">
    <view class="menu-item admin-menu" bindtap="goToScheduleManage">
      <view class="menu-icon-wrap">
        <icon name="calendar" color="#12B7A8" size="32rpx"/>
      </view>
      <text class="menu-label">排课管理</text>
      <text class="menu-arrow admin-badge">管理员</text>
    </view>
  </view>

  <!-- 菜单项：无边框列表项，左侧图标，右侧 chevron -->
  <view class="menu-list">
    <view class="menu-item" bindtap="goToAssessmentResult">
      <view class="menu-icon-wrap">
        <icon name="target" color="#12B7A8" size="32rpx"/>
      </view>
      <text class="menu-label">测评结果</text>
      <view class="menu-arrow-wrap">
        <icon name="chevron-right" color="#8E8E93" size="28rpx"/>
      </view>
    </view>

    <view class="menu-item" bindtap="goToLearningReport">
      <view class="menu-icon-wrap">
        <icon name="chart" color="#12B7A8" size="32rpx"/>
      </view>
      <text class="menu-label">学习报告</text>
      <view class="menu-arrow-wrap">
        <icon name="chevron-right" color="#8E8E93" size="28rpx"/>
      </view>
    </view>

    <view class="menu-item" bindtap="goToAssessment">
      <view class="menu-icon-wrap">
        <icon name="reset" color="#12B7A8" size="32rpx"/>
      </view>
      <text class="menu-label">重新测评</text>
      <view class="menu-arrow-wrap">
        <icon name="chevron-right" color="#8E8E93" size="28rpx"/>
      </view>
    </view>
  </view>

  <!-- 编辑资料弹窗 -->
  <view class="modal-overlay" wx:if="{{showEditProfile}}">
    <view class="modal-mask" bindtap="hideEditProfile"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">编辑资料</text>
        <text class="modal-subtitle">设置头像和昵称</text>
      </view>

      <view class="form-group edit-avatar-group">
        <button class="edit-avatar-btn" open-type="chooseAvatar" bindchooseavatar="onEditChooseAvatar">
          <image class="edit-avatar-img" src="{{editAvatarUrl || avatarUrl || defaultAvatarUrl}}" mode="aspectFill"/>
          <view class="edit-avatar-badge">
            <icon name="pen" color="#FFFFFF" size="20rpx"/>
          </view>
        </button>
        <text class="edit-avatar-hint">点击更换头像</text>
      </view>

      <view class="form-group">
        <text class="form-label">昵称</text>
        <input
          class="edit-nickname-input"
          type="nickname"
          placeholder="请输入昵称"
          value="{{editNickName}}"
          bindinput="onEditNickNameInput"
        />
      </view>

      <view class="modal-buttons">
        <view class="modal-btn cancel" bindtap="hideEditProfile">
          <text>取消</text>
        </view>
        <view class="modal-btn confirm {{savingProfile ? 'disabled' : ''}}" bindtap="saveProfile">
          <text>{{savingProfile ? '保存中' : '保存'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 添加成绩弹窗 -->
  <view class="modal-overlay" wx:if="{{showAddScore}}">
    <view class="modal-mask" bindtap="hideAddScoreModal"></view>
    <view class="modal-content">
      <view class="modal-header">
        <text class="modal-title">添加考试成绩</text>
        <text class="modal-subtitle">记录你的雅思模考成绩</text>
      </view>

      <view class="form-group">
        <text class="form-label">考试日期</text>
        <picker mode="date" value="{{newScore.date}}" start="2020-01-01" end="{{maxDate}}" bindchange="onDateChange">
          <view class="date-picker {{newScore.date ? 'date-picker-active' : ''}}">
            <icon name="calendar" color="#8E8E93" size="22rpx"/>
            <text class="date-text">{{newScore.date ? newScore.date : '请选择考试日期'}}</text>
            <view class="date-arrow-wrap">
              <icon name="chevron-right" color="#8E8E93" size="22rpx"/>
            </view>
          </view>
        </picker>
      </view>

      <view class="form-group">
        <text class="form-label">各项分数 (0-9分)</text>
        <view class="score-inputs">
          <view class="score-input-item">
            <view class="score-icon-wrap listening">
              <icon name="headphones" color="#12B7A8" size="24rpx"/>
            </view>
            <input
              class="score-input"
              type="digit"
              placeholder="0.0"
              value="{{newScore.listening}}"
              bindinput="onScoreInput"
              data-type="listening"
            />
            <text class="score-name">听力</text>
          </view>

          <view class="score-input-item">
            <view class="score-icon-wrap speaking">
              <icon name="mic" color="#12B7A8" size="24rpx"/>
            </view>
            <input
              class="score-input"
              type="digit"
              placeholder="0.0"
              value="{{newScore.speaking}}"
              bindinput="onScoreInput"
              data-type="speaking"
            />
            <text class="score-name">口语</text>
          </view>

          <view class="score-input-item">
            <view class="score-icon-wrap reading">
              <icon name="book" color="#12B7A8" size="24rpx"/>
            </view>
            <input
              class="score-input"
              type="digit"
              placeholder="0.0"
              value="{{newScore.reading}}"
              bindinput="onScoreInput"
              data-type="reading"
            />
            <text class="score-name">阅读</text>
          </view>

          <view class="score-input-item">
            <view class="score-icon-wrap writing">
              <icon name="pen" color="#12B7A8" size="24rpx"/>
            </view>
            <input
              class="score-input"
              type="digit"
              placeholder="0.0"
              value="{{newScore.writing}}"
              bindinput="onScoreInput"
              data-type="writing"
            />
            <text class="score-name">写作</text>
          </view>
        </view>
      </view>

      <view class="form-group">
        <text class="form-label">总分 (0-9分)</text>
        <view class="total-input-wrap">
          <input
            class="total-input"
            type="digit"
            placeholder="请输入总分"
            value="{{newScore.total}}"
            bindinput="onScoreInput"
            data-type="total"
          />
        </view>
      </view>

      <view class="modal-buttons">
        <view class="modal-btn cancel" bindtap="hideAddScoreModal">
          <text>取消</text>
        </view>
        <view class="modal-btn confirm" bindtap="saveScore">
          <text>保存成绩</text>
        </view>
      </view>
    </view>
  </view>

</view>

<!-- 番茄时钟组件（固定浮层） -->
<pomodoro
  visible="{{showPomodoro}}"
  homeworkOptions="{{pomodoroHomeworkOptions}}"
  taskOptions="{{pomodoroTaskOptions}}"
  bind:close="onPomodoroClose"
  bind:sessionSaved="onPomodoroSessionSaved"
  bind:taskCreated="onPomodoroTaskCreated"
/>
