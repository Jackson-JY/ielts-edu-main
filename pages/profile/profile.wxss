/* pages/profile/profile.wxss */

.page {
  background: linear-gradient(180deg, #FFF9F5 0%, #FFF5F0 100%);
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
}

/* 个人信息卡片 */
.profile-card {
  background: linear-gradient(145deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 44rpx;
  padding: 40rpx;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 4rpx 20rpx rgba(154, 151, 170, 0.15),
    0 1rpx 3rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
}

.profile-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.login-action {
  margin-left: auto;
  flex-shrink: 0;
}

.btn-login {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  border: none;
  line-height: 1.5;
}

.btn-login::after {
  border: none;
}

.btn-logout {
  background: #f5f5f5;
  color: #999;
  font-size: 22rpx;
  padding: 6rpx 12rpx;
  border-radius: 30rpx;
  border: none;
  line-height: 1.5;
  height: 48rpx;
  box-sizing: border-box;
  width: auto !important;
  min-width: 0 !important;
  max-width: none !important;
}

.btn-logout::after {
  border: none;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #F0D8FA 0%, #E8D4F8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 
    0 4rpx 16rpx rgba(232, 212, 248, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  overflow: hidden;
}

.avatar-icon {
  width: 100%;
  height: 100%;
}

.profile-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
}

.stats-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 24rpx;
  align-items: center;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
}

.stat-divider {
  width: 1rpx;
  height: 64rpx;
  background: rgba(154, 151, 170, 0.3);
}

/* 打卡统计卡片 */
.stats-card {
  background: linear-gradient(145deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 44rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  margin-bottom: 24rpx;
  box-shadow: 
    0 4rpx 20rpx rgba(154, 151, 170, 0.15),
    0 1rpx 3rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
}
.stats-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
}
.streak-num { 
  display: block; 
  font-size: 96rpx; 
  font-weight: 800; 
  background: linear-gradient(180deg, #F0D8FA 0%, #E8D4F8 100%); 
  -webkit-background-clip: text; 
  -webkit-text-fill-color: transparent; 
  line-height: 1.1; 
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05); 
}
.streak-label { 
  display: block; 
  font-size: 30rpx; 
  color: #4A4A4A; 
  margin-bottom: 36rpx; 
}
.stats-row { 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  gap: 40rpx; 
}
.stats-item { 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  gap: 8rpx; 
}
.stats-value { 
  font-size: 32rpx; 
  font-weight: 700; 
  color: #4A4A4A; 
}
.stats-label { 
  font-size: 24rpx; 
  color: #9A97AA; 
}
.stats-divider { 
  width: 2rpx; 
  height: 60rpx; 
  background: rgba(154,151,170,0.3); 
}

/* 月份导航 */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 28rpx;
}
.month-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #FFFDFB 0%, #FFF9F5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(154, 151, 170, 0.1);
  transition: all 0.15s;
}
.month-btn:active { opacity: 0.6; transform: scale(0.9); }
.month-btn-disabled {
  opacity: 0.3;
  pointer-events: none;
}
.month-arrow { font-size: 36rpx; color: #4A4A4A; line-height: 1; }
.month-label { font-size: 30rpx; font-weight: 600; color: #4A4A4A; min-width: 200rpx; text-align: center; }

/* 日历热力图 */
.calendar-header { 
  display: grid; 
  grid-template-columns: repeat(7, 1fr); 
  gap: 8rpx; 
  margin-bottom: 12rpx; 
}
.cal-day-label { 
  text-align: center; 
  font-size: 24rpx; 
  color: #9A97AA; 
}
.calendar-grid { 
  display: grid; 
  grid-template-columns: repeat(7, 1fr); 
  gap: 8rpx; 
}
.calendar-cell {
  height: 80rpx;
  padding: 8rpx 4rpx 4rpx;
  border-radius: 14rpx;
  border: 2rpx solid rgba(0,0,0,0.04);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
  overflow: hidden;
  box-shadow: 
    inset 0 1rpx 0 rgba(255,255,255,0.8),
    0 1rpx 3rpx rgba(0,0,0,0.05);
  position: relative;
}

.calendar-cell::after {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  border-radius: 14rpx;
  border: 2rpx solid transparent;
  transition: border-color 0.2s;
  pointer-events: none;
}

.calendar-cell:active { 
  transform: scale(0.92); 
  box-shadow: 
    inset 0 2rpx 4rpx rgba(0,0,0,0.1),
    0 1rpx 2rpx rgba(0,0,0,0.05);
}

.calendar-cell:active::after {
  border-color: rgba(167, 251, 245, 0.6);
}

.calendar-cell.has-checkin {
  box-shadow: 
    inset 0 1rpx 0 rgba(255,255,255,0.6),
    0 2rpx 6rpx rgba(167, 251, 245, 0.3);
}

.calendar-cell.today {
  border-color: #A7FBF5;
  box-shadow: 
    inset 0 1rpx 0 rgba(255,255,255,0.8),
    0 0 0 2rpx rgba(167, 251, 245, 0.4);
}
.cal-day-num { 
  font-size: 24rpx; 
  font-weight: 600; 
  margin-bottom: 4rpx; 
}
.cal-day-active { color: #4A4A4A; }
.cal-day-inactive { color: #9A97AA; }
.cal-day-empty { color: transparent; }
.cal-type-bars { 
  display: flex; 
  flex-direction: column; 
  gap: 3rpx; 
  width: 85%; 
  flex: 1; 
  justify-content: flex-end; 
}
.cal-type-bar { 
  height: 6rpx; 
  border-radius: 6rpx; 
  width: 100%; 
  box-shadow: 0 1rpx 2rpx rgba(0,0,0,0.05); 
}

/* 热力图例 */
.heatmap-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 12rpx;
}
.legend-label {
  font-size: 20rpx;
  color: #9A97AA;
}
.legend-cell {
  width: 28rpx;
  height: 28rpx;
  border-radius: 4rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.1);
}

/* 考试成绩记录 */
.section-card {
  background: linear-gradient(145deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 44rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 4rpx 20rpx rgba(154, 151, 170, 0.15),
    0 1rpx 3rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
}

.section-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.add-button {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(180deg, #B8FFF7 0%, #A7FBF5 50%, #96F0E8 100%);
  border-radius: 40rpx;
  border: none;
  box-shadow: 
    0 4rpx 12rpx rgba(167, 251, 245, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  transition: all 0.2s ease;
}

.add-button:active {
  transform: translateY(2rpx);
  box-shadow: 
    0 2rpx 6rpx rgba(167, 251, 245, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}

.add-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.add-text {
  font-size: 24rpx;
  color: #4A4A4A;
  font-weight: 600;
}

/* 最新成绩 */
.latest-score {
  background: linear-gradient(145deg, #FFFDFB 0%, #FFF9F5 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 2rpx 12rpx rgba(154, 151, 170, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.score-date {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 16rpx;
}

.total-score {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.total-score .score-value {
  font-size: 72rpx;
  font-weight: 700;
  background: linear-gradient(180deg, #F0D8FA 0%, #E8D4F8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}

.total-score .score-label {
  font-size: 24rpx;
  color: #9A97AA;
}

.score-details {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  text-align: center;
}

.score-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.score-item .score-label {
  font-size: 24rpx;
  color: #9A97AA;
}

.score-item .score-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
}

/* 成绩趋势图 */
.score-trend {
  background: linear-gradient(145deg, #FFFDFB 0%, #FFF9F5 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 
    0 2rpx 12rpx rgba(154, 151, 170, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.trend-title {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 24rpx;
}

.trend-chart {
  height: 320rpx;
  display: flex;
  flex-direction: column;
}

.trend-canvas {
  width: 100%;
  height: 260rpx;
}

.trend-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 20rpx;
  margin-top: 10rpx;
}

.trend-label {
  font-size: 18rpx;
  color: #9A97AA;
  text-align: center;
}

/* 空状态 */
.empty-scores {
  padding: 48rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
}

/* 菜单列表 */
.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.menu-item {
  background: linear-gradient(145deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 44rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: none;
  box-shadow: 
    0 4rpx 16rpx rgba(154, 151, 170, 0.12),
    0 1rpx 3rpx rgba(0, 0, 0, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  transition: all 0.2s ease;
}

.menu-item:active {
  transform: translateY(2rpx);
  box-shadow: 
    0 2rpx 8rpx rgba(154, 151, 170, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #4A4A4A;
  font-weight: 600;
}

.menu-arrow {
  font-size: 32rpx;
  color: #9A97AA;
}

/* 添加成绩弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  backdrop-filter: blur(4rpx);
  z-index: 0;
}

.modal-content {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  background: linear-gradient(180deg, #FFFDFB 0%, #FFF9F5 100%);
  border-radius: 44rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  box-shadow: 
    0 24rpx 80rpx rgba(0,0,0,0.25),
    0 8rpx 24rpx rgba(0,0,0,0.1);
  z-index: 1;
  animation: modalPopIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalPopIn {
  from {
    opacity: 0;
    transform: scale(0.85) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.modal-header {
  text-align: center;
  margin-bottom: 8rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #9A97AA;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.form-label {
  font-size: 26rpx;
  color: #4A4A4A;
  font-weight: 600;
}

/* 日期选择器样式 */
.date-picker {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #F8F4FF 0%, #F0E8FF 100%);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.date-picker-active {
  background: linear-gradient(180deg, #FFFDFB 0%, #FFF9F5 100%);
  border-color: #E8D4F8;
}

.date-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, #F0D8FA 0%, #E8D4F8 100%);
  border-radius: 12rpx;
}

.date-icon-text {
  font-size: 24rpx;
  margin-right: 8rpx;
}

.date-text {
  flex: 1;
  font-size: 28rpx;
  color: #9A97AA;
}

.date-picker-active .date-text {
  color: #4A4A4A;
  font-weight: 500;
}

.date-arrow {
  font-size: 28rpx;
  color: #9A97AA;
}

/* 分数输入区域 */
.score-inputs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.score-input-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.score-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.score-icon.listening {
  background: linear-gradient(135deg, #FFE4E1 0%, #FFD5D0 100%);
}

.score-icon.speaking {
  background: linear-gradient(135deg, #E8F5E9 0%, #D4EDDA 100%);
}

.score-icon.reading {
  background: linear-gradient(135deg, #E3F2FD 0%, #BBDEFB 100%);
}

.score-icon.writing {
  background: linear-gradient(135deg, #FFF3E0 0%, #FFE0B2 100%);
}

.score-input {
  width: 100%;
  height: 80rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
  background: linear-gradient(180deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 20rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.score-input:focus {
  border-color: #E8D4F8;
  background: linear-gradient(180deg, #FFFDFB 0%, #FFF9F5 100%);
}

.score-name {
  font-size: 22rpx;
  color: #9A97AA;
}

/* 总分输入 */
.total-input-wrap {
  padding: 24rpx;
  background: linear-gradient(180deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 24rpx;
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}

.total-input {
  width: 100%;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #4A4A4A;
  background: transparent;
}

.total-input::placeholder {
  font-size: 28rpx;
  font-weight: 400;
  color: #9A97AA;
}

.modal-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 8rpx;
}

.modal-btn {
  padding: 24rpx 0;
  border-radius: 60rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s ease;
}

.modal-btn.cancel {
  background: linear-gradient(180deg, #F8F4FF 0%, #F0E8FF 100%);
  color: #4A4A4A;
  box-shadow: 0 2rpx 8rpx rgba(154, 151, 170, 0.1);
}

.modal-btn.confirm {
  background: linear-gradient(180deg, #B8FFF7 0%, #A7FBF5 50%, #96F0E8 100%);
  color: #4A4A4A;
  box-shadow: 
    0 4rpx 12rpx rgba(167, 251, 245, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.modal-btn:active {
  transform: translateY(2rpx);
}

.modal-btn::after {
  border: none;
}

/* 打卡日历区域头部 */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-header .section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A4A4A;
}

/* 打卡按钮 */
.checkin-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 10rpx 16rpx;
  background: linear-gradient(135deg, #A7FBF5 0%, #7DF5EC 50%, #5AEDE0 100%);
  border-radius: 32rpx;
  border: none;
  box-shadow: 
    0 4rpx 12rpx rgba(90, 237, 224, 0.4),
    0 1rpx 4rpx rgba(90, 237, 224, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  position: relative;
  overflow: hidden;
  flex-shrink: 0;
  width: auto;
}

.checkin-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: -100%;
  width: 100%;
  height: 100%;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
  transition: left 0.5s;
}

.checkin-btn:active {
  transform: translateY(1rpx) scale(0.97);
  box-shadow: 
    0 2rpx 8rpx rgba(90, 237, 224, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}

.checkin-btn:active::before {
  left: 100%;
}

.checkin-btn-icon {
  font-size: 24rpx;
  font-weight: 700;
  color: #2D6B64;
  text-shadow: 0 1rpx 0 rgba(255,255,255,0.3);
}

.checkin-btn-text {
  font-size: 22rpx;
  color: #2D6B64;
  font-weight: 600;
  text-shadow: 0 1rpx 0 rgba(255,255,255,0.3);
}

/* 打卡明细弹窗 */
.checkin-detail-modal {
  max-height: 75vh;
  animation: modalSlideUp 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

@keyframes modalSlideUp {
  from {
    opacity: 0;
    transform: translateY(40rpx) scale(0.95);
  }
  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.checkin-detail-list {
  max-height: 55vh;
  margin-bottom: 24rpx;
}

.checkin-detail-item {
  display: flex;
  gap: 20rpx;
  padding: 28rpx;
  margin-bottom: 16rpx;
  background: linear-gradient(145deg, #FFFDFB 0%, #FFF9F5 100%);
  border-radius: 20rpx;
  border: 1rpx solid rgba(0,0,0,0.04);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
  transition: transform 0.2s, box-shadow 0.2s;
}

.checkin-detail-item:last-child {
  margin-bottom: 0;
}

.checkin-detail-item:active {
  transform: translateY(2rpx);
  box-shadow: 0 1rpx 4rpx rgba(0,0,0,0.02);
}

.detail-time {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex-shrink: 0;
  padding: 8rpx 16rpx;
  background: linear-gradient(135deg, #F0F0F0 0%, #E8E8E8 100%);
  border-radius: 24rpx;
}

.time-icon {
  font-size: 22rpx;
}

.time-text {
  font-size: 22rpx;
  color: #666;
  font-weight: 500;
}

.detail-content {
  flex: 1;
}

.detail-types {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.detail-type-tag {
  font-size: 22rpx;
  color: #4A4A4A;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  font-weight: 600;
  box-shadow: 0 2rpx 6rpx rgba(0,0,0,0.08);
  text-shadow: 0 1rpx 0 rgba(255,255,255,0.5);
}

.detail-text {
  font-size: 26rpx;
  color: #4A4A4A;
  line-height: 1.6;
  padding: 16rpx;
  background: rgba(248, 244, 255, 0.5);
  border-radius: 12rpx;
}

.checkin-detail-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 0;
}

.checkin-detail-empty .empty-icon {
  font-size: 100rpx;
  margin-bottom: 24rpx;
  opacity: 0.8;
}

.checkin-detail-empty .empty-text {
  font-size: 28rpx;
  color: #9A97AA;
  font-weight: 500;
}

.checkin-detail-empty .empty-hint {
  font-size: 24rpx;
  color: #BBB;
  margin-top: 12rpx;
}

/* 打卡表单样式 */
.checkin-type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}

.checkin-type-item {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 20rpx 28rpx;
  background: linear-gradient(145deg, #F8F8F8 0%, #F0F0F0 100%);
  border-radius: 32rpx;
  border: 2rpx solid transparent;
  transition: all 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}

.checkin-type-item:active {
  transform: scale(0.95);
}

.checkin-type-item.selected {
  background: linear-gradient(145deg, rgba(167, 251, 245, 0.3) 0%, rgba(167, 251, 245, 0.15) 100%);
  border-color: #A7FBF5;
  box-shadow: 
    0 4rpx 16rpx rgba(167, 251, 245, 0.4),
    inset 0 1rpx 0 rgba(255,255,255,0.8);
}

.type-color {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  box-shadow: 0 2rpx 4rpx rgba(0,0,0,0.1);
}

.type-label {
  font-size: 26rpx;
  color: #666;
  font-weight: 500;
  transition: all 0.2s;
}

.checkin-type-item.selected .type-label {
  color: #2D6B64;
  font-weight: 700;
}

.checkin-textarea {
  width: 100%;
  height: 220rpx;
  padding: 28rpx;
  background: linear-gradient(180deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 24rpx;
  font-size: 28rpx;
  color: #4A4A4A;
  box-sizing: border-box;
  border: 2rpx solid transparent;
  transition: all 0.2s;
  line-height: 1.6;
}

.checkin-textarea:focus {
  border-color: #E8D4F8;
  background: linear-gradient(180deg, #FFFDFB 0%, #FFF9F5 100%);
  box-shadow: 0 4rpx 16rpx rgba(232, 212, 248, 0.2);
}

.textarea-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #9A97AA;
  margin-top: 12rpx;
  font-weight: 500;
}

.modal-btn.disabled {
  opacity: 0.4;
  pointer-events: none;
  filter: grayscale(0.5);
}
