/* pages/profile/profile.wxss */

.page {
  background: linear-gradient(180deg, #FFF9F5 0%, #FFF5F0 100%);
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
}

/* 个人信息卡片 */
.profile-card {
  background: linear-gradient(145deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 44rpx;
  padding: 40rpx;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 4rpx 20rpx rgba(154, 151, 170, 0.15),
    0 1rpx 3rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
}

.profile-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
  margin-bottom: 32rpx;
}

.login-action {
  margin-left: auto;
}

.btn-login {
  background: linear-gradient(135deg, #4facfe 0%, #00f2fe 100%);
  color: #fff;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  border: none;
  line-height: 1.5;
}

.btn-login::after {
  border: none;
}

.btn-logout {
  background: #f5f5f5;
  color: #999;
  font-size: 24rpx;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  border: none;
  line-height: 1.5;
}

.btn-logout::after {
  border: none;
}

.avatar {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #F0D8FA 0%, #E8D4F8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 
    0 4rpx 16rpx rgba(232, 212, 248, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  overflow: hidden;
}

.avatar-icon {
  width: 80rpx;
  height: 80rpx;
}

.profile-info {
  flex: 1;
}

.user-name {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
  margin-bottom: 8rpx;
}

.user-id {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
}

.stats-row {
  display: grid;
  grid-template-columns: 1fr auto 1fr;
  gap: 24rpx;
  align-items: center;
}

.stat-item {
  text-align: center;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
  margin-bottom: 8rpx;
}

.stat-label {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
}

.stat-divider {
  width: 1rpx;
  height: 64rpx;
  background: rgba(154, 151, 170, 0.3);
}

/* 考试成绩记录 */
.section-card {
  background: linear-gradient(145deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 44rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 4rpx 20rpx rgba(154, 151, 170, 0.15),
    0 1rpx 3rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
}

.section-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.add-button {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: linear-gradient(180deg, #B8FFF7 0%, #A7FBF5 50%, #96F0E8 100%);
  border-radius: 40rpx;
  border: none;
  box-shadow: 
    0 4rpx 12rpx rgba(167, 251, 245, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  transition: all 0.2s ease;
}

.add-button:active {
  transform: translateY(2rpx);
  box-shadow: 
    0 2rpx 6rpx rgba(167, 251, 245, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}

.add-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.add-text {
  font-size: 24rpx;
  color: #4A4A4A;
  font-weight: 600;
}

/* 最新成绩 */
.latest-score {
  background: linear-gradient(145deg, #FFFDFB 0%, #FFF9F5 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 
    0 2rpx 12rpx rgba(154, 151, 170, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.score-date {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 16rpx;
}

.total-score {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.total-score .score-value {
  font-size: 72rpx;
  font-weight: 700;
  background: linear-gradient(180deg, #F0D8FA 0%, #E8D4F8 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}

.total-score .score-label {
  font-size: 24rpx;
  color: #9A97AA;
}

.score-details {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  text-align: center;
}

.score-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.score-item .score-label {
  font-size: 24rpx;
  color: #9A97AA;
}

.score-item .score-value {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
}

/* 成绩趋势图 */
.score-trend {
  background: linear-gradient(145deg, #FFFDFB 0%, #FFF9F5 100%);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 
    0 2rpx 12rpx rgba(154, 151, 170, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.trend-title {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 24rpx;
}

.trend-chart {
  height: 256rpx;
  display: flex;
  align-items: flex-end;
  justify-content: space-around;
  gap: 16rpx;
}

.trend-bar-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  height: 100%;
  justify-content: flex-end;
}

.trend-bar {
  width: 100%;
  background: linear-gradient(180deg, #F0D8FA 0%, #E8D4F8 100%);
  border-radius: 8rpx 8rpx 0 0;
  min-height: 8rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.1);
}

.trend-value {
  font-size: 20rpx;
  color: #9A97AA;
}

/* 空状态 */
.empty-scores {
  padding: 48rpx 0;
  text-align: center;
}

.empty-text {
  font-size: 28rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
}

/* 菜单列表 */
.menu-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.menu-item {
  background: linear-gradient(145deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 44rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  gap: 24rpx;
  border: none;
  box-shadow: 
    0 4rpx 16rpx rgba(154, 151, 170, 0.12),
    0 1rpx 3rpx rgba(0, 0, 0, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  transition: all 0.2s ease;
}

.menu-item:active {
  transform: translateY(2rpx);
  box-shadow: 
    0 2rpx 8rpx rgba(154, 151, 170, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.menu-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.menu-label {
  flex: 1;
  font-size: 28rpx;
  color: #4A4A4A;
  font-weight: 600;
}

.menu-arrow {
  font-size: 32rpx;
  color: #9A97AA;
}

/* 添加成绩弹窗 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  padding: 48rpx;
}

.modal-content {
  width: 100%;
  max-width: 640rpx;
  background: linear-gradient(180deg, #FFFDFB 0%, #FFF9F5 100%);
  border-radius: 44rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  box-shadow: 0 20rpx 60rpx rgba(0,0,0,0.3);
}

.modal-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
  margin-bottom: 8rpx;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-label {
  font-size: 24rpx;
  color: #9A97AA;
}

.form-input {
  width: 100%;
  padding: 24rpx;
  border-radius: 24rpx;
  background: linear-gradient(180deg, #F8F4FF 0%, #F0E8FF 100%);
  font-size: 28rpx;
  color: #4A4A4A;
  border: none;
  box-sizing: border-box;
  box-shadow: inset 0 1rpx 3rpx rgba(0,0,0,0.05);
}

.score-inputs {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.score-input-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-input.small {
  padding: 20rpx;
  font-size: 28rpx;
}

.modal-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  margin-top: 16rpx;
}

.modal-btn {
  padding: 24rpx 0;
  border-radius: 60rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  transition: all 0.2s ease;
}

.modal-btn.cancel {
  background: linear-gradient(180deg, #F8F4FF 0%, #F0E8FF 100%);
  color: #4A4A4A;
  box-shadow: 0 2rpx 8rpx rgba(154, 151, 170, 0.1);
}

.modal-btn.confirm {
  background: linear-gradient(180deg, #B8FFF7 0%, #A7FBF5 50%, #96F0E8 100%);
  color: #4A4A4A;
  box-shadow: 
    0 4rpx 12rpx rgba(167, 251, 245, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.modal-btn:active {
  transform: translateY(2rpx);
}

.modal-btn::after {
  border: none;
}
