/* pages/profile/profile.wxss
   重构：Apple 风格 + 品牌薄荷绿
   设计 Tokens：
     背景 #F5F5F7 / 主文字 #1D1D1F / 次文字 #6E6E73 / 辅助文字 #8E8E93
     边框 #E5E5EA / 品牌 #12B7A8 / 浅品牌 #E6F7F5 / 深品牌 #0E8C81 / 错误 #FF3B30
   卡片：1rpx #E5E5EA 边框 + 0 1px 2px 0 rgba(0,0,0,0.04) 阴影
   按钮：胶囊形 999px / 主 88rpx / 次 80rpx / 按压 filter: brightness(0.92)
   弹窗：32rpx 圆角 / 标题左对齐 / 阴影 0 24px 64px -12px rgba(0,0,0,0.12)
*/

.page {
  background: #F5F5F7;
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
}

/* ============ 个人信息卡片 ============ */
.profile-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-top: 24rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
}

.profile-header {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.profile-info-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
  transition: opacity 0.18s ease;
}

.profile-info-left:active {
  opacity: 0.7;
}

.avatar-wrap {
  position: relative;
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
  border: 1rpx solid #E5E5EA;
  box-sizing: border-box;
}

.avatar-icon {
  width: 100%;
  height: 100%;
}

.avatar-edit-badge {
  position: absolute;
  bottom: -2rpx;
  right: -2rpx;
  width: 32rpx;
  height: 32rpx;
  background: #12B7A8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFFFFF;
  box-sizing: border-box;
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.user-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1D1F;
  display: block;
  margin-bottom: 4rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.edit-profile-hint {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
}

.login-action {
  margin-left: auto;
  flex-shrink: 0;
}

.btn-logout {
  background: #F2F2F7;
  color: #6E6E73;
  font-size: 22rpx;
  padding: 8rpx 20rpx;
  border-radius: 999px;
  border: none;
  line-height: 1.5;
  height: 56rpx;
  box-sizing: border-box;
  width: auto !important;
  min-width: 0 !important;
  max-width: none !important;
  transition: filter 0.18s ease;
}

.btn-logout:active {
  filter: brightness(0.92);
}

.btn-logout::after {
  border: none;
}

/* ============ 打卡统计卡片 ============ */
.stats-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  margin-bottom: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
}

.streak-num {
  display: block;
  font-size: 72rpx;
  font-weight: 700;
  color: #1D1D1F;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.streak-label {
  display: block;
  font-size: 26rpx;
  color: #6E6E73;
  margin-top: 8rpx;
  margin-bottom: 32rpx;
}

.stats-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
}

.stats-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.stats-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.stats-label {
  font-size: 24rpx;
  color: #8E8E93;
}

.stats-divider {
  width: 1rpx;
  height: 56rpx;
  background: #E5E5EA;
}

/* ============ 番茄专注入口卡片 ============ */
.pomodoro-entry-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  transition: filter 0.18s ease;
}

.pomodoro-entry-card:active {
  filter: brightness(0.92);
}

.pomodoro-entry-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  flex: 1;
  min-width: 0;
}

.pomodoro-entry-icon-wrap {
  width: 72rpx;
  height: 72rpx;
  background: #E6F7F5;
  border-radius: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.pomodoro-entry-info {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.pomodoro-entry-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.pomodoro-entry-sub {
  font-size: 22rpx;
  color: #6E6E73;
}

.pomodoro-entry-right {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

/* ============ 通用 section 卡片 ============ */
.section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1D1D1F;
}

/* ============ 打卡按钮 ============ */
.checkin-btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  padding: 10rpx 20rpx;
  background: #E6F7F5;
  border-radius: 999px;
  border: none;
  flex-shrink: 0;
  width: auto;
  transition: filter 0.18s ease;
}

.checkin-btn:active {
  filter: brightness(0.92);
}

.checkin-btn-text {
  font-size: 24rpx;
  color: #0E8C81;
  font-weight: 600;
  line-height: 1;
}

/* ============ 月份导航 ============ */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  margin-bottom: 24rpx;
}

.month-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: filter 0.18s ease;
}

.month-btn:active {
  filter: brightness(0.92);
}

.month-btn-disabled {
  opacity: 0.3;
  pointer-events: none;
}

.month-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  min-width: 200rpx;
  text-align: center;
}

/* ============ 日历热力图 ============ */
.calendar-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.cal-day-label {
  text-align: center;
  font-size: 22rpx;
  color: #8E8E93;
}

.calendar-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.calendar-cell {
  height: 80rpx;
  padding: 8rpx 4rpx 4rpx;
  border-radius: 12rpx;
  border: 1rpx solid #E5E5EA;
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: filter 0.18s ease;
  overflow: hidden;
  position: relative;
  box-sizing: border-box;
}

.calendar-cell:active {
  filter: brightness(0.95);
}

.calendar-cell.today {
  border-color: #12B7A8;
  border-width: 2rpx;
}

.calendar-cell.today .cal-day-num {
  color: #0E8C81;
  font-weight: 700;
}

.cal-day-num {
  font-size: 24rpx;
  font-weight: 600;
  margin-bottom: 4rpx;
  color: #1D1D1F;
}

.cal-day-active {
  color: #1D1D1F;
}

.cal-day-inactive {
  color: #8E8E93;
}

.cal-day-empty {
  color: transparent;
}

.cal-type-bars {
  display: flex;
  flex-direction: column;
  gap: 3rpx;
  width: 85%;
  flex: 1;
  justify-content: flex-end;
}

.cal-type-bar {
  height: 6rpx;
  border-radius: 3rpx;
  width: 100%;
}

/* ============ 热力图例 ============ */
.heatmap-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 16rpx;
}

.legend-label {
  font-size: 20rpx;
  color: #8E8E93;
}

.legend-cell {
  width: 24rpx;
  height: 24rpx;
  border-radius: 4rpx;
}

/* ============ 成绩记录卡片 ============ */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1D1D1F;
}

.add-button {
  display: inline-flex;
  align-items: center;
  gap: 6rpx;
  padding: 8rpx 20rpx;
  background: #E6F7F5;
  border-radius: 999px;
  border: none;
  transition: filter 0.18s ease;
}

.add-button:active {
  filter: brightness(0.92);
}

.add-text {
  font-size: 24rpx;
  color: #0E8C81;
  font-weight: 600;
}

/* ============ 最新成绩 ============ */
.latest-score {
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
}

.score-date {
  font-size: 22rpx;
  color: #8E8E93;
  display: block;
  margin-bottom: 16rpx;
}

.total-score {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.score-value-total {
  font-size: 72rpx;
  font-weight: 700;
  color: #12B7A8;
  line-height: 1;
  letter-spacing: -0.02em;
}

.score-label {
  font-size: 24rpx;
  color: #6E6E73;
}

.score-details {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
  text-align: center;
}

.score-item {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.score-item-label {
  font-size: 22rpx;
  color: #8E8E93;
}

.score-item-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1D1F;
}

/* ============ 成绩趋势图 ============ */
.score-trend {
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 28rpx;
}

.trend-title {
  font-size: 22rpx;
  color: #6E6E73;
  display: block;
  margin-bottom: 20rpx;
}

.trend-chart {
  height: 320rpx;
  display: flex;
  flex-direction: column;
}

.trend-canvas {
  width: 100%;
  height: 260rpx;
}

.trend-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 20rpx;
  margin-top: 10rpx;
}

.trend-label {
  font-size: 18rpx;
  color: #8E8E93;
  text-align: center;
}

/* ============ 空状态 ============ */
.empty-scores {
  padding: 48rpx 0 32rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.empty-icon-wrap {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  color: #6E6E73;
  display: block;
  margin-bottom: 8rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #8E8E93;
  display: block;
}

/* ============ 菜单列表 ============ */
.menu-list {
  display: flex;
  flex-direction: column;
  margin-bottom: 24rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  overflow: hidden;
}

.menu-item {
  background: #FFFFFF;
  padding: 28rpx 32rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
  border-bottom: 1rpx solid #E5E5EA;
  transition: background 0.15s ease;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-item:active {
  background: #F2F2F7;
}

.menu-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #E6F7F5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.menu-label {
  flex: 1;
  font-size: 30rpx;
  color: #1D1D1F;
  font-weight: 500;
  min-width: 0;
}

.menu-arrow {
  flex-shrink: 0;
}

.menu-arrow-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

/* 管理员菜单 */
.admin-badge {
  background: #FF9500;
  color: #FFFFFF;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 999px;
  font-weight: 500;
  margin-right: 8rpx;
}

/* ============ 弹窗通用 ============ */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx;
  animation: fadeIn 0.2s ease;
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 0;
}

.modal-content {
  position: relative;
  width: 100%;
  max-width: 640rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  box-shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.12);
  z-index: 1;
  animation: modalPopIn 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes modalPopIn {
  from {
    opacity: 0;
    transform: scale(0.85) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: scale(1) translateY(0);
  }
}

.modal-header {
  text-align: left;
  margin-bottom: 4rpx;
}

.modal-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1D1D1F;
  display: block;
  margin-bottom: 8rpx;
}

.modal-subtitle {
  font-size: 24rpx;
  color: #8E8E93;
}

.form-group {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.form-label {
  font-size: 26rpx;
  color: #6E6E73;
  font-weight: 500;
}

/* ============ 日期选择器 ============ */
.date-picker {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #F2F2F7;
  border: 1rpx solid #E5E5EA;
  transition: border-color 0.18s ease, background 0.18s ease;
}

.date-picker-active {
  background: #FFFFFF;
  border-color: #12B7A8;
}

.date-text {
  flex: 1;
  font-size: 28rpx;
  color: #8E8E93;
}

.date-picker-active .date-text {
  color: #1D1D1F;
  font-weight: 500;
}

.date-arrow-wrap {
  flex-shrink: 0;
  display: flex;
  align-items: center;
}

/* ============ 分数输入区 ============ */
.score-inputs {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.score-input-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.score-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #E6F7F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.score-input {
  width: 100%;
  height: 80rpx;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  background: #FFFFFF;
  border-radius: 16rpx;
  border: 1rpx solid #E5E5EA;
  box-sizing: border-box;
  transition: border-color 0.18s ease;
}

.score-input:focus {
  border-color: #12B7A8;
}

.score-name {
  font-size: 22rpx;
  color: #8E8E93;
}

/* ============ 总分输入 ============ */
.total-input-wrap {
  padding: 0 24rpx;
  background: #F2F2F7;
  border-radius: 16rpx;
  border: 1rpx solid #E5E5EA;
}

.total-input {
  width: 100%;
  text-align: center;
  font-size: 40rpx;
  font-weight: 700;
  color: #1D1D1F;
  background: transparent;
  height: 88rpx;
  line-height: 88rpx;
}

.total-input::placeholder {
  font-size: 28rpx;
  font-weight: 400;
  color: #8E8E93;
}

/* ============ 弹窗按钮 ============ */
.modal-buttons {
  display: flex;
  gap: 20rpx;
  margin-top: 8rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999px;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: filter 0.18s ease;
}

.modal-btn.cancel {
  background: #F2F2F7;
  color: #6E6E73;
}

.modal-btn.confirm {
  background: #12B7A8;
  color: #FFFFFF;
}

.modal-btn:active {
  filter: brightness(0.92);
}

.modal-btn::after {
  border: none;
}

.modal-btn.disabled {
  opacity: 0.42;
  pointer-events: none;
}

/* ============ 打卡明细弹窗 ============ */
.checkin-detail-modal {
  max-height: 75vh;
}

.checkin-detail-list {
  max-height: 55vh;
  margin-bottom: 16rpx;
}

.checkin-detail-item {
  display: flex;
  gap: 20rpx;
  padding: 24rpx;
  margin-bottom: 12rpx;
  background: #F2F2F7;
  border-radius: 16rpx;
  border: 1rpx solid #E5E5EA;
}

.checkin-detail-item:last-child {
  margin-bottom: 0;
}

.detail-time {
  display: flex;
  align-items: center;
  gap: 6rpx;
  flex-shrink: 0;
  padding: 6rpx 14rpx;
  background: #FFFFFF;
  border-radius: 999px;
  border: 1rpx solid #E5E5EA;
  align-self: flex-start;
  box-sizing: border-box;
}

.time-text {
  font-size: 22rpx;
  color: #6E6E73;
  font-weight: 500;
}

.detail-content {
  flex: 1;
  min-width: 0;
}

.detail-types {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 12rpx;
}

.detail-type-tag {
  font-size: 22rpx;
  color: #1D1D1F;
  padding: 6rpx 16rpx;
  border-radius: 999px;
  font-weight: 500;
}

.detail-duration-tag {
  font-size: 22rpx;
  color: #0E8C81;
  padding: 6rpx 16rpx;
  border-radius: 999px;
  font-weight: 600;
  background: #E6F7F5;
}

.detail-text {
  font-size: 26rpx;
  color: #1D1D1F;
  line-height: 1.6;
  padding: 16rpx;
  background: #FFFFFF;
  border-radius: 12rpx;
  border: 1rpx solid #E5E5EA;
}

.checkin-detail-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.checkin-detail-empty .empty-icon-wrap {
  margin-bottom: 16rpx;
}

.checkin-detail-empty .empty-text {
  font-size: 28rpx;
  color: #6E6E73;
  font-weight: 500;
}

/* ============ 打卡表单 ============ */
.checkin-type-grid {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.checkin-type-item {
  display: flex;
  align-items: center;
  gap: 10rpx;
  padding: 16rpx 24rpx;
  background: #F2F2F7;
  border-radius: 999px;
  border: 1rpx solid #E5E5EA;
  transition: filter 0.18s ease, background 0.18s ease, border-color 0.18s ease;
}

.checkin-type-item:active {
  filter: brightness(0.95);
}

.checkin-type-item.selected {
  background: #E6F7F5;
  border-color: #12B7A8;
}

.type-color {
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
}

.type-label {
  font-size: 26rpx;
  color: #6E6E73;
  font-weight: 500;
  transition: color 0.18s;
}

.checkin-type-item.selected .type-label {
  color: #0E8C81;
  font-weight: 600;
}

.checkin-duration-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  font-size: 30rpx;
  color: #1D1D1F;
  box-sizing: border-box;
  border: 1rpx solid #E5E5EA;
  transition: border-color 0.18s ease;
}

.checkin-duration-input:focus {
  border-color: #12B7A8;
}

.checkin-textarea {
  width: 100%;
  height: 220rpx;
  padding: 24rpx;
  background: #FFFFFF;
  border-radius: 16rpx;
  font-size: 28rpx;
  color: #1D1D1F;
  box-sizing: border-box;
  border: 1rpx solid #E5E5EA;
  transition: border-color 0.18s ease;
  line-height: 1.6;
}

.checkin-textarea:focus {
  border-color: #12B7A8;
}

.textarea-count {
  display: block;
  text-align: right;
  font-size: 22rpx;
  color: #8E8E93;
  margin-top: 8rpx;
  font-weight: 500;
}

/* ============ 编辑资料弹窗 ============ */
.edit-avatar-group {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.edit-avatar-btn {
  position: relative;
  width: 128rpx !important;
  height: 128rpx !important;
  padding: 0 !important;
  margin: 0 !important;
  border: none !important;
  background: transparent !important;
  border-radius: 50% !important;
  line-height: 1;
}

.edit-avatar-btn::after {
  border: none !important;
}

.edit-avatar-img {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  border: 1rpx solid #E5E5EA;
  display: block;
  background: #F2F2F7;
  box-sizing: border-box;
}

.edit-avatar-badge {
  position: absolute;
  bottom: 0;
  right: 0;
  width: 36rpx;
  height: 36rpx;
  background: #12B7A8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFFFFF;
  box-sizing: border-box;
}

.edit-avatar-hint {
  font-size: 24rpx;
  color: #8E8E93;
}

.edit-nickname-input {
  width: 100%;
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1D1D1F;
  height: 88rpx;
  line-height: 88rpx;
  box-sizing: border-box;
  border: 1rpx solid #E5E5EA;
  transition: border-color 0.18s ease;
}

.edit-nickname-input:focus {
  border-color: #12B7A8;
}
