/* pages/agreement/agreement.wxss */
.page {
  min-height: 100vh;
  padding: 32rpx 32rpx 80rpx;
  background: #F5F5F7;
  box-sizing: border-box;
}

.doc-header {
  padding: 16rpx 0 32rpx;
  margin-bottom: 32rpx;
  animation: page-enter 250ms ease-out;
}

.doc-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.02em;
  margin-bottom: 12rpx;
}

.doc-updated {
  font-size: 24rpx;
  color: #8E8E93;
}

.doc-section {
  margin-bottom: 40rpx;
}

.doc-heading {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.01em;
  margin-bottom: 16rpx;
}

.doc-paragraph {
  display: block;
  font-size: 28rpx;
  color: #1D1D1F;
  line-height: 1.5;
  margin-bottom: 16rpx;
}

.doc-footer {
  margin-top: 48rpx;
  padding-top: 32rpx;
  border-top: 1rpx solid #E5E5EA;
}

.doc-footer-text {
  font-size: 24rpx;
  color: #6E6E73;
}

/* 入场动画 */
@keyframes page-enter {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
