<!--pages/homework-detail/homework-detail.wxml - 作业详情页-->
<view class="page">
  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack">
    <text class="back-icon">‹</text>
  </view>

  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <!-- 作业详情 -->
  <block wx:if="{{!loading && homework}}">
    <!-- 状态标签 -->
    <view class="status-badge {{homework.isOverdue ? 'status-overdue' : (homework.isUrgent ? 'status-urgent' : 'status-normal')}}">
      <text>{{homework.isOverdue ? '已逾期' : (homework.isUrgent ? '即将截止' : (homework.isCompleted ? '已完成' : '进行中'))}}</text>
    </view>

    <!-- 标题区域 -->
    <view class="title-section">
      <text class="subject-tag">{{homework.subjectLabel}}</text>
      <text class="homework-title">{{homework.title}}</text>
    </view>

    <!-- 信息卡片 -->
    <view class="info-card">
      <view class="info-item" wx:if="{{homework.courseName}}">
        <text class="info-label">📖 所属课程</text>
        <text class="info-value">{{homework.courseName}}</text>
      </view>

      <view class="info-item">
        <text class="info-label">📅 截止日期</text>
        <text class="info-value {{homework.isOverdue ? 'text-overdue' : (homework.isUrgent ? 'text-urgent' : '')}}">
          {{homework.deadlineFormatted}}
        </text>
      </view>
      
      <view class="info-item" wx:if="{{homework.daysLeft !== null}}">
        <text class="info-label">⏰ 剩余时间</text>
        <text class="info-value {{homework.isOverdue ? 'text-overdue' : (homework.isUrgent ? 'text-urgent' : '')}}">
          {{homework.isOverdue ? '已逾期 ' + Math.abs(homework.daysLeft) + ' 天' : (homework.daysLeft === 0 ? '今天截止' : '还剩 ' + homework.daysLeft + ' 天')}}
        </text>
      </view>

      <view class="info-item" wx:if="{{homework.createTimeFormatted}}">
        <text class="info-label">📝 布置时间</text>
        <text class="info-value">{{homework.createTimeFormatted}}</text>
      </view>

      <view class="info-item" wx:if="{{homework.score !== undefined && homework.score !== null}}">
        <text class="info-label">⭐ 得分</text>
        <text class="info-value">{{homework.score}}/{{homework.totalScore || 100}}</text>
      </view>
    </view>

    <!-- 作业内容 -->
    <view class="content-card" wx:if="{{homework.description}}">
      <text class="content-title">作业内容</text>
      <text class="content-text">{{homework.description}}</text>
    </view>

    <!-- 老师评语 -->
    <view class="content-card feedback-card" wx:if="{{homework.feedback}}">
      <text class="content-title">💬 老师评语</text>
      <text class="content-text">{{homework.feedback}}</text>
    </view>

    <!-- 附件列表 -->
    <view class="content-card" wx:if="{{homework.attachments && homework.attachments.length > 0}}">
      <text class="content-title">📎 附件资料</text>
      <view class="attachment-list">
        <view class="attachment-item" wx:for="{{homework.attachments}}" wx:key="index" bindtap="previewAttachment" data-url="{{item.url}}">
          <text class="attachment-icon">📄</text>
          <text class="attachment-name">{{item.name}}</text>
          <text class="attachment-arrow">›</text>
        </view>
      </view>
    </view>

    <!-- 完成按钮 -->
    <view class="action-section" wx:if="{{!homework.isCompleted}}">
      <button class="complete-btn" bindtap="markAsComplete">
        <text>标记为已完成</text>
      </button>
    </view>
    <view class="action-section" wx:else>
      <button class="complete-btn btn-completed" disabled>
        <text>✓ 已完成</text>
      </button>
    </view>
  </block>
</view>
