<!--pages/homework-detail/homework-detail.wxml - 作业详情页-->
<view class="page">
  <!-- 返回按钮 -->
  <view class="back-btn" bindtap="goBack" hover-class="back-btn-active">
    <icon name="chevron-left" color="#1D1D1F" size="36rpx"/>
  </view>

  <!-- 加载中 -->
  <view class="loading-container" wx:if="{{loading}}">
    <text class="loading-text">加载中</text>
  </view>

  <!-- 作业详情 -->
  <block wx:if="{{!loading && homework}}">
    <!-- 头部：科目 + 状态 + 标题 -->
    <view class="hw-hero">
      <view class="hw-hero-top">
        <view class="subject-tag" style="background-color: {{homework.subjectColor}}">
          <text class="subject-label">{{homework.subjectLabel}}</text>
        </view>
        <view class="status-pill {{homework.isCompleted ? 'done' : 'doing'}}">
          <text>{{homework.isCompleted ? '已完成' : '进行中'}}</text>
        </view>
      </view>
      <text class="hw-title">{{homework.title}}</text>
      <view class="hw-meta" wx:if="{{homework.courseName || homework.createTimeFormatted}}">
        <text class="hw-meta-item" wx:if="{{homework.courseName}}">{{homework.courseName}}</text>
        <text class="hw-meta-dot" wx:if="{{homework.courseName && homework.createTimeFormatted}}">·</text>
        <text class="hw-meta-item" wx:if="{{homework.createTimeFormatted}}">{{homework.createTimeFormatted}} 布置</text>
      </view>
    </view>

    <!-- 作业内容 -->
    <view class="section-card" wx:if="{{homework.description}}">
      <text class="card-label">作业内容</text>
      <text class="card-body">{{homework.description}}</text>
    </view>

    <!-- 完成进度 -->
    <view class="section-card">
      <text class="card-label">完成进度</text>
      <view class="progress-row">
        <view class="progress-track">
          <view class="progress-fill" style="width: {{homework.completion}}%;"></view>
        </view>
        <text class="progress-pct">{{homework.completion}}%</text>
      </view>

      <view class="stat-grid">
        <view class="stat-cell">
          <text class="stat-label">完成度</text>
          <view class="stat-input-wrap">
            <input class="stat-input" type="number" placeholder="0" value="{{homework.completion}}" bindinput="onCompletionInput" max="100" min="0"/>
            <text class="stat-suffix">%</text>
          </view>
        </view>
        <view class="stat-cell">
          <text class="stat-label">累计时长</text>
          <view class="stat-input-wrap">
            <input class="stat-input" type="number" placeholder="0" value="{{homework.timeSpent}}" bindinput="onTimeSpentInput" min="0"/>
            <text class="stat-suffix">分钟</text>
          </view>
        </view>
      </view>

      <view class="estimate-row" wx:if="{{homework.estimatedTime > 0}}">
        <text class="estimate-label">预估完成时间</text>
        <text class="estimate-value">{{homework.estimatedTime}} 分钟</text>
      </view>
    </view>

    <!-- 更新按钮 -->
    <view class="action-section">
      <button class="complete-btn" bindtap="updateHomeworkStatus" hover-class="btn-press">
        <text>保存更新</text>
      </button>
    </view>
  </block>
</view>
