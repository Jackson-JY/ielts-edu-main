/* pages/homework-detail/homework-detail.wxss - 作业详情页 */
.page {
  background: linear-gradient(180deg, #FFF9F5 0%, #FFF5F0 100%);
  min-height: 100vh;
  padding: 40rpx 32rpx;
  box-sizing: border-box;
  position: relative;
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  top: 40rpx;
  left: 32rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #FFFDFB 0%, #FFF9F5 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 2rpx 8rpx rgba(154, 151, 170, 0.15);
  z-index: 10;
}
.back-btn:active {
  opacity: 0.7;
  transform: scale(0.95);
}
.back-icon {
  font-size: 40rpx;
  color: #4A4A4A;
  line-height: 1;
  margin-top: -4rpx;
}

/* 加载中 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
}
.loading-text {
  font-size: 28rpx;
  color: #9A97AA;
}

/* 状态标签 */
.status-badge {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  padding: 12rpx 32rpx;
  border-radius: 32rpx;
  font-size: 26rpx;
  font-weight: 600;
  margin-bottom: 32rpx;
  margin-left: 80rpx;
}
.status-normal {
  background: rgba(167, 251, 245, 0.3);
  color: #2A9D8F;
}
.status-urgent {
  background: rgba(255, 152, 0, 0.15);
  color: #FF9800;
}
.status-overdue {
  background: rgba(255, 107, 107, 0.15);
  color: #FF6B6B;
}

/* 标题区域 */
.title-section {
  margin-bottom: 40rpx;
  padding-left: 80rpx;
}
.subject-tag {
  display: inline-flex;
  align-items: center;
  gap: 8rpx;
  font-size: 24rpx;
  color: #424242;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  margin-bottom: 16rpx;
}
.subject-label {
  font-weight: 500;
}
.homework-title {
  display: block;
  font-size: 44rpx;
  font-weight: 700;
  color: #4A4A4A;
  line-height: 1.3;
}

/* 信息卡片 */
.info-card {
  background: linear-gradient(145deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 
    0 4rpx 20rpx rgba(154, 151, 170, 0.15),
    0 1rpx 3rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}
.info-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid rgba(154, 151, 170, 0.15);
}
.info-item:last-child {
  border-bottom: none;
  padding-bottom: 0;
}
.info-item:first-child {
  padding-top: 0;
}
.info-label {
  font-size: 28rpx;
  color: #9A97AA;
}
.info-value {
  font-size: 28rpx;
  color: #4A4A4A;
  font-weight: 500;
}
.text-urgent {
  color: #FF9800;
  font-weight: 600;
}
.text-overdue {
  color: #FF6B6B;
  font-weight: 600;
}

/* 输入框样式 */
.input-item {
  padding: 16rpx 0;
}
.input-wrapper {
  display: flex;
  align-items: center;
}
.info-input {
  text-align: right;
  font-size: 28rpx;
  color: #4A4A4A;
  font-weight: 500;
  min-width: 120rpx;
  padding: 8rpx 12rpx;
  background: rgba(255, 255, 255, 0.6);
  border-radius: 12rpx;
  border: 1rpx solid rgba(154, 151, 170, 0.2);
}
.input-suffix {
  font-size: 28rpx;
  color: #9A97AA;
  margin-left: 8rpx;
}

/* 内容卡片 */
.content-card {
  background: linear-gradient(145deg, #FFFDFB 0%, #FFF9F5 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}
.content-card:last-of-type {
  margin-bottom: 48rpx;
}
.feedback-card {
  background: linear-gradient(145deg, #F0F8FF 0%, #E6F3FF 100%);
}
.content-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #4A4A4A;
  margin-bottom: 20rpx;
}
.content-text {
  display: block;
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
}

/* 附件列表 */
.attachment-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.attachment-item {
  display: flex;
  align-items: center;
  padding: 20rpx 24rpx;
  background: linear-gradient(180deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 16rpx;
  transition: all 0.2s ease;
}
.attachment-item:active {
  opacity: 0.7;
  transform: scale(0.98);
}
.attachment-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
}
.attachment-name {
  flex: 1;
  font-size: 28rpx;
  color: #4A4A4A;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.attachment-arrow {
  font-size: 32rpx;
  color: #9A97AA;
}

/* 操作区域 */
.action-section {
  padding: 0 20rpx;
}
.complete-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(180deg, #B8FFF7 0%, #A7FBF5 50%, #96F0E8 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 
    0 8rpx 32rpx rgba(167, 251, 245, 0.5),
    0 2rpx 4rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  border: none;
}
.complete-btn::after {
  border: none;
}
.complete-btn text {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
}
.complete-btn:active {
  opacity: 0.8;
  transform: translateY(2rpx);
}
.btn-completed {
  background: linear-gradient(180deg, #E8F5E9 0%, #C8E6C9 100%);
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.3);
}
.btn-completed text {
  color: #4CAF50;
}
