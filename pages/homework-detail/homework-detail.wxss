/* pages/homework-detail/homework-detail.wxss - 作业详情页（与全站风格统一） */
.page {
  background: #F5F5F7;
  min-height: 100vh;
  padding: 96rpx 32rpx 60rpx;
  box-sizing: border-box;
  position: relative;
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 10;
}
.back-btn-active {
  background: #F2F2F7;
}

/* 加载中 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
}
.loading-text {
  font-size: 28rpx;
  color: #8E8E93;
}

/* ========== 头部 Hero ========== */
.hw-hero {
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  animation: page-enter 250ms ease-out;
}
.hw-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.subject-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}
.subject-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #1D1D1F;
}
.status-pill {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}
.status-pill.done {
  background: #E6F7F5;
  color: #0E8C81;
}
.status-pill.doing {
  background: #F2F2F7;
  color: #6E6E73;
}
.hw-title {
  display: block;
  font-size: 38rpx;
  font-weight: 600;
  color: #1D1D1F;
  line-height: 1.35;
  letter-spacing: -0.02em;
}
.hw-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}
.hw-meta-item {
  font-size: 24rpx;
  color: #6E6E73;
}
.hw-meta-dot {
  font-size: 24rpx;
  color: #C4CDD6;
}

/* ========== 通用卡片 ========== */
.section-card {
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
}
.card-label {
  display: block;
  font-size: 26rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 20rpx;
  letter-spacing: -0.01em;
}
.card-body {
  display: block;
  font-size: 28rpx;
  color: #1D1D1F;
  line-height: 1.7;
}

/* ========== 完成进度 ========== */
.progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.progress-track {
  flex: 1;
  height: 12rpx;
  border-radius: 999rpx;
  background: #F2F2F7;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #12B7A8;
  transition: width 0.3s ease;
}
.progress-pct {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 600;
  color: #0E8C81;
  min-width: 80rpx;
  text-align: right;
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.stat-cell {
  background: #F5F5F7;
  border-radius: 16rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.stat-label {
  font-size: 24rpx;
  color: #6E6E73;
  font-weight: 500;
}
.stat-input-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.stat-input {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 600;
  color: #1D1D1F;
  line-height: 1.1;
}
.stat-suffix {
  font-size: 24rpx;
  color: #8E8E93;
  flex-shrink: 0;
}

.estimate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #E5E5EA;
}
.estimate-label {
  font-size: 26rpx;
  color: #6E6E73;
}
.estimate-value {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
}

/* ========== 更新按钮 ========== */
.action-section {
  margin-top: 12rpx;
}
.complete-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 999px;
  background: #12B7A8;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}
.complete-btn::after {
  border: none;
}
.complete-btn text {
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
}
.btn-press {
  filter: brightness(0.92);
}

/* 入场动画 */
@keyframes page-enter {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
