/* pages/homework-detail/homework-detail.wxss - 作业详情页（与全站风格统一） */
.page {
  background: #F6F8FB;
  min-height: 100vh;
  padding: 96rpx 32rpx 60rpx;
  box-sizing: border-box;
  position: relative;
}

/* 返回按钮 */
.back-btn {
  position: absolute;
  top: 32rpx;
  left: 32rpx;
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 18rpx rgba(23, 33, 43, 0.08);
  z-index: 10;
}
.back-btn:active {
  transform: scale(0.94);
}
.back-icon {
  font-size: 44rpx;
  color: #17212B;
  line-height: 1;
  margin-top: -4rpx;
}

/* 加载中 */
.loading-container {
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 400rpx;
}
.loading-text {
  font-size: 28rpx;
  color: #9AA5B1;
}

/* ========== 头部 Hero ========== */
.hw-hero {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
  box-shadow: 0 10rpx 28rpx rgba(23, 33, 43, 0.05);
}
.hw-hero-top {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.subject-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
}
.subject-label {
  font-size: 24rpx;
  font-weight: 700;
  color: #17212B;
}
.status-pill {
  padding: 8rpx 22rpx;
  border-radius: 999rpx;
  font-size: 23rpx;
  font-weight: 700;
}
.status-pill.done {
  background: rgba(18, 183, 168, 0.12);
  color: #12B7A8;
}
.status-pill.doing {
  background: #F2F5F8;
  color: #64717F;
}
.hw-title {
  display: block;
  font-size: 38rpx;
  font-weight: 800;
  color: #17212B;
  line-height: 1.35;
}
.hw-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 16rpx;
}
.hw-meta-item {
  font-size: 23rpx;
  color: #7A8794;
}
.hw-meta-dot {
  font-size: 23rpx;
  color: #C4CDD6;
}

/* ========== 通用卡片 ========== */
.section-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 20rpx;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
  box-shadow: 0 10rpx 28rpx rgba(23, 33, 43, 0.05);
}
.card-label {
  display: block;
  font-size: 26rpx;
  font-weight: 800;
  color: #17212B;
  margin-bottom: 20rpx;
}
.card-body {
  display: block;
  font-size: 28rpx;
  color: #4A5560;
  line-height: 1.7;
}

/* ========== 完成进度 ========== */
.progress-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 28rpx;
}
.progress-track {
  flex: 1;
  height: 16rpx;
  border-radius: 999rpx;
  background: #F2F5F8;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #12B7A8;
  transition: width 0.3s ease;
}
.progress-pct {
  flex-shrink: 0;
  font-size: 28rpx;
  font-weight: 800;
  color: #12B7A8;
  min-width: 80rpx;
  text-align: right;
}

.stat-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}
.stat-cell {
  background: #F6F8FB;
  border-radius: 18rpx;
  padding: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.stat-label {
  font-size: 23rpx;
  color: #7A8794;
  font-weight: 600;
}
.stat-input-wrap {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}
.stat-input {
  flex: 1;
  min-width: 0;
  font-size: 40rpx;
  font-weight: 800;
  color: #17212B;
  line-height: 1.1;
}
.stat-suffix {
  font-size: 24rpx;
  color: #9AA5B1;
  flex-shrink: 0;
}

.estimate-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid rgba(23, 33, 43, 0.06);
}
.estimate-label {
  font-size: 26rpx;
  color: #7A8794;
}
.estimate-value {
  font-size: 28rpx;
  font-weight: 700;
  color: #17212B;
}

/* ========== 更新按钮 ========== */
.action-section {
  margin-top: 12rpx;
}
.complete-btn {
  width: 100%;
  height: 92rpx;
  border-radius: 20rpx;
  background: #12B7A8;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 12rpx 28rpx rgba(18, 183, 168, 0.26);
  border: none;
}
.complete-btn::after {
  border: none;
}
.complete-btn text {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
}
.complete-btn:active {
  transform: translateY(2rpx);
  box-shadow: 0 6rpx 16rpx rgba(18, 183, 168, 0.22);
}
