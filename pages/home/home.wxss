/* pages/home/home.wxss */

.page {
  background: linear-gradient(180deg, #FFF9F5 0%, #FFF5F0 100%);
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
}

/* 顶部问候 */
.header {
  padding: 36rpx 0 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid #fff;
  box-shadow: 0 4rpx 16rpx rgba(154, 151, 170, 0.2);
  flex-shrink: 0;
}

.greeting {
  font-size: 38rpx;
  font-weight: 700;
  color: #4A4A4A;
  letter-spacing: 1rpx;
}

.date-text {
  font-size: 24rpx;
  color: #9A97AA;
}

/* 今日任务卡片 */
.task-card {
  margin-top: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.card-icon {
  width: 96rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 28rpx;
}

.card-sub {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 16rpx;
}

.icon {
  width: 72rpx;
  height: 72rpx;
}

.task-info {
  margin-bottom: 32rpx;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.task-label {
  font-size: 24rpx;
  color: #9A97AA;
}

.task-value {
  font-size: 24rpx;
  color: #4A4A4A;
  font-weight: 600;
}

.task-button {
  width: 100%;
  padding: 24rpx 0;
  background: linear-gradient(180deg, #B8FFF7 0%, #A7FBF5 50%, #96F0E8 100%);
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #4A4A4A;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 
    0 4rpx 12rpx rgba(167, 251, 245, 0.4),
    0 2rpx 4rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  transition: all 0.2s ease;
}

.task-button:active {
  transform: translateY(2rpx);
  box-shadow: 
    0 2rpx 6rpx rgba(167, 251, 245, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}

.arrow {
  font-size: 24rpx;
}

/* 能力概览 */
.ability-section {
  margin-bottom: 24rpx;
}

.ability-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.ability-item {
  background: linear-gradient(145deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 44rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
  box-shadow: 
    0 4rpx 16rpx rgba(154, 151, 170, 0.12),
    0 1rpx 3rpx rgba(0, 0, 0, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.ability-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(232, 212, 248, 0.4);
  border-radius: 18rpx;
  box-shadow: inset 0 1rpx 0 rgba(255,255,255,0.5);
}

.ability-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.ability-label {
  font-size: 24rpx;
  color: #9A97AA;
}

/* 预约试听课程 */
.trial-card {
  background: linear-gradient(145deg, #F0D8FA 0%, #E8D4F8 100%);
  box-shadow: 
    0 4rpx 20rpx rgba(232, 212, 248, 0.4),
    0 1rpx 3rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.trial-price {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.price {
  font-size: 48rpx;
  font-weight: 700;
  color: #4A4A4A;
  text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.05);
}

.price-note {
  font-size: 22rpx;
  color: #9A97AA;
}

.trial-button {
  width: 100%;
  padding: 24rpx 0;
  background: linear-gradient(180deg, #B8FFF7 0%, #A7FBF5 50%, #96F0E8 100%);
  border-radius: 60rpx;
  text-align: center;
  color: #4A4A4A;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 
    0 4rpx 12rpx rgba(167, 251, 245, 0.4),
    0 2rpx 4rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  transition: all 0.2s ease;
}

.trial-button:active {
  transform: translateY(2rpx);
  box-shadow: 
    0 2rpx 6rpx rgba(167, 251, 245, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}

/* 快速链接 */
.quick-links {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding-bottom: 24rpx;
}

.quick-link-item {
  background: linear-gradient(145deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 44rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  color: #4A4A4A;
  font-size: 28rpx;
  font-weight: 600;
  box-shadow: 
    0 4rpx 16rpx rgba(154, 151, 170, 0.12),
    0 1rpx 3rpx rgba(0, 0, 0, 0.04),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  transition: all 0.2s ease;
}

.quick-link-item:active {
  transform: translateY(2rpx);
  box-shadow: 
    0 2rpx 8rpx rgba(154, 151, 170, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}
