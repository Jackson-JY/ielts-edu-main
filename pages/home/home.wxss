/* pages/home/home.wxss */

.page {
  background: #FFF9F5;
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
}

/* 顶部问候 */
.header {
  padding: 36rpx 0 20rpx;
}

.header-text {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.greeting {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.date-text {
  font-size: 24rpx;
  color: #9A97AA;
}

/* 通用卡片样式 */
.section-card {
  background: #F5F0FF;
  border-radius: 44rpx;
  padding: 40rpx;
  margin-bottom: 24rpx;
}

/* 今日任务卡片 */
.task-card {
  margin-top: 24rpx;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.card-icon {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.card-sub {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 16rpx;
}

.icon {
  font-size: 36rpx;
}

.task-info {
  margin-bottom: 32rpx;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.task-label {
  font-size: 24rpx;
  color: #9A97AA;
}

.task-value {
  font-size: 24rpx;
  color: #4A4A4A;
  font-weight: 600;
}

.task-button {
  width: 100%;
  padding: 24rpx 0;
  background: #A7FBF5;
  border-radius: 60rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #4A4A4A;
  font-size: 28rpx;
  font-weight: 600;
}

.arrow {
  font-size: 24rpx;
}

/* 能力概览 */
.ability-section {
  margin-bottom: 24rpx;
}

.ability-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
}

.ability-item {
  background: #F5F0FF;
  border-radius: 44rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}

.ability-icon {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.ability-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.ability-label {
  font-size: 24rpx;
  color: #9A97AA;
}

/* 预约试听课程 */
.trial-card {
  background: #E8D4F8;
}

.trial-price {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.price {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.price-note {
  font-size: 22rpx;
  color: #9A97AA;
}

.trial-button {
  width: 100%;
  padding: 24rpx 0;
  background: #A7FBF5;
  border-radius: 60rpx;
  text-align: center;
  color: #4A4A4A;
  font-size: 28rpx;
  font-weight: 600;
}

/* 快速链接 */
.quick-links {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 24rpx;
  padding-bottom: 24rpx;
}

.quick-link-item {
  background: #F5F0FF;
  border-radius: 44rpx;
  padding: 32rpx 24rpx;
  text-align: center;
  color: #4A4A4A;
  font-size: 28rpx;
  font-weight: 600;
}
