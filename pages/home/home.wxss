/* pages/home/home.wxss */

.page {
  min-height: 100vh;
  padding: 0 32rpx 24rpx;
  background: #F5F5F7;
  box-sizing: border-box;
}

/* 首页内对通用卡片做紧凑化覆盖 */
.page .section-card {
  padding: 28rpx;
  margin-bottom: 24rpx;
}

/* ==================== 顶部问候 ==================== */
.header {
  padding: 24rpx 0 20rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  flex-shrink: 0;
  /* 无描边、无投影 */
}

.header-text {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.greeting {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.01em;
}

.date-text {
  font-size: 24rpx;
  color: #6E6E73;
}

/* ==================== 每日寄语：白色卡片 + 左侧薄荷绿竖线 ==================== */
.daily-quote {
  margin: 0 0 24rpx;
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  gap: 20rpx;
  /* 入场：仅一次淡入上滑，不循环 */
  animation: quote-in 0.25s ease-out;
}

.daily-quote-bar {
  flex-shrink: 0;
  width: 6rpx;
  height: 36rpx;
  border-radius: 3rpx;
  background: #12B7A8;
}

.daily-quote-text {
  flex: 1;
  font-size: 26rpx;
  font-weight: 500;
  color: #1D1D1F;
  line-height: 1.5;
}

@keyframes quote-in {
  0% { opacity: 0; transform: translateY(8rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

/* ==================== 今日任务卡片：白色 ==================== */
.task-card {
  background: #FFFFFF;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.card-header-text {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.eyebrow {
  font-size: 20rpx;
  font-weight: 600;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 0.08em;
}

.eyebrow-brand {
  color: #12B7A8;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  line-height: 1.2;
  letter-spacing: -0.01em;
}

.card-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #E6F7F5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.task-info {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.task-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.task-divider {
  width: 1rpx;
  height: 56rpx;
  background: #E5E5EA;
  margin: 0 24rpx;
}

.task-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #1D1D1F;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.task-label {
  font-size: 24rpx;
  color: #6E6E73;
}

.task-button {
  height: 88rpx;
  border-radius: 999px;
  background: #12B7A8;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  /* 无投影，按压用亮度反馈 */
  transition: filter 0.18s ease;
}

.task-button:active {
  filter: brightness(0.92);
}

/* ==================== 能力概览：无边框浅灰块 ==================== */
.ability-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.ability-item {
  padding: 20rpx 24rpx;
  border-radius: 24rpx;
  background: #F2F2F7;
  /* 无边框、无阴影 */
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  transition: filter 0.18s ease;
}

.ability-item:active {
  filter: brightness(0.97);
}

.ability-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 14rpx;
  background: #E6F7F5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.ability-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.ability-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1D1D1F;
  line-height: 1.2;
  letter-spacing: -0.01em;
}

.ability-label {
  font-size: 22rpx;
  color: #6E6E73;
}

/* ==================== 听说读写打卡模块 ==================== */
.checkin-section-sub {
  font-size: 22rpx;
  color: #8E8E93;
  flex-shrink: 0;
  padding-top: 4rpx;
}

.checkin-module-grid {
  margin-top: 20rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.checkin-module-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  padding: 20rpx 0 16rpx;
  border-radius: 20rpx;
  background: #F2F2F7;
  transition: background-color 0.18s ease;
}

.checkin-module-item:active {
  background: #E5E5EA;
}

.checkin-module-item.checked {
  background: #E6F7F5;
}

.checkin-module-icon-wrap {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkin-module-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.checkin-module-status {
  font-size: 20rpx;
  color: #8E8E93;
}

.checkin-module-item.checked .checkin-module-status {
  color: #0E8C81;
  font-weight: 500;
}

/* ==================== 打卡内容输入弹窗 ==================== */
.checkin-input-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkin-input-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.checkin-input-card {
  position: relative;
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.12);
  /* 弹窗入场：淡入 + 上滑 */
  animation: modal-in 0.25s ease-out;
  box-sizing: border-box;
}

@keyframes modal-in {
  0% { opacity: 0; transform: translateY(20rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.checkin-input-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.checkin-input-icon-wrap {
  flex-shrink: 0;
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #E6F7F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkin-input-titles {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.checkin-input-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.01em;
}

.checkin-input-sub {
  font-size: 24rpx;
  color: #8E8E93;
}

.checkin-input-textarea {
  width: 100%;
  min-height: 160rpx;
  max-height: 360rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  font-size: 28rpx;
  color: #1D1D1F;
  line-height: 1.5;
  box-sizing: border-box;
  margin-bottom: 28rpx;
}

.checkin-input-placeholder {
  color: #8E8E93;
}

.checkin-input-actions {
  display: flex;
  gap: 16rpx;
}

.checkin-input-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-size: 30rpx;
  font-weight: 600;
  box-sizing: border-box;
  transition: filter 0.18s ease;
}

.checkin-input-btn:active {
  filter: brightness(0.96);
}

.checkin-input-btn.cancel {
  background: #F2F2F7;
  color: #6E6E73;
}

.checkin-input-btn.confirm {
  background: #12B7A8;
  color: #FFFFFF;
}

.checkin-input-btn.confirm.disabled {
  opacity: 0.42;
}

/* ==================== 打卡成功弹窗 ==================== */
.celebration-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.celebration-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.celebration-card {
  position: relative;
  width: 580rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 56rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.12);
  /* 轻微缩放入场，无粒子飞散 */
  animation: celebration-in 0.25s ease-out;
}

@keyframes celebration-in {
  0% { opacity: 0; transform: scale(0.92); }
  100% { opacity: 1; transform: scale(1); }
}

.celebration-icon-wrap {
  width: 120rpx;
  height: 120rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.celebration-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 12rpx;
  letter-spacing: -0.01em;
}

.celebration-message {
  font-size: 26rpx;
  color: #6E6E73;
  text-align: center;
  line-height: 1.5;
  margin-bottom: 36rpx;
}

.celebration-actions {
  width: 100%;
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.celebration-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-size: 28rpx;
  font-weight: 600;
  line-height: 1;
  padding: 0;
  margin: 0;
}

.celebration-btn::after {
  border: none;
}

.celebration-btn.share-friend {
  background: #12B7A8;
  color: #FFFFFF;
}

.celebration-btn.share-timeline {
  background: #F2F2F7;
  color: #1D1D1F;
}

.celebration-close {
  font-size: 24rpx;
  color: #8E8E93;
  padding: 8rpx 16rpx;
}
