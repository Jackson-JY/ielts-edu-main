/* pages/home/home.wxss */

.page {
  min-height: 100vh;
  padding: 0 32rpx 24rpx;
  background: #F6F8FB;
  box-sizing: border-box;
}

/* 首页内对通用卡片做紧凑化覆盖（不影响其它页面的全局 .section-card） */
.page .section-card {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.header {
  padding: 20rpx 0 14rpx;
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.user-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  border: 4rpx solid #FFFFFF;
  box-shadow: 0 8rpx 24rpx rgba(23, 33, 43, 0.08);
  flex-shrink: 0;
}

.header-text {
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.greeting {
  font-size: 38rpx;
  font-weight: 700;
  color: #17212B;
  letter-spacing: 0;
}

.date-text {
  font-size: 24rpx;
  color: #7A8794;
}

/* 每日鼓励寄语横幅 */
.daily-quote-banner {
  position: relative;
  margin: 0 0 16rpx;
  padding: 18rpx 28rpx;
  border-radius: 24rpx;
  background: linear-gradient(120deg, rgba(18, 183, 168, 0.16), rgba(111, 183, 255, 0.12) 55%, rgba(180, 156, 255, 0.12));
  border: 1rpx solid rgba(18, 183, 168, 0.16);
  display: flex;
  align-items: center;
  gap: 14rpx;
  overflow: hidden;
  /* 入场：上滑 + 轻微回弹 */
  animation: quote-in 0.5s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 周期性掠过的高光 */
.daily-quote-shine {
  position: absolute;
  top: 0;
  left: -40%;
  width: 40%;
  height: 100%;
  background: linear-gradient(100deg, transparent, rgba(255, 255, 255, 0.55), transparent);
  transform: skewX(-18deg);
  animation: quote-shine 3.6s ease-in-out infinite;
}

/* 左侧装饰引号：轻微呼吸摆动 */
.daily-quote-mark {
  flex-shrink: 0;
  font-size: 56rpx;
  line-height: 0.8;
  font-weight: 800;
  color: rgba(18, 183, 168, 0.36);
  margin-top: 10rpx;
  transform-origin: center bottom;
  animation: quote-mark-wiggle 2.8s ease-in-out infinite;
}

.daily-quote-text {
  flex: 1;
  font-size: 27rpx;
  font-weight: 600;
  color: #0E8C81;
  line-height: 1.5;
  letter-spacing: 0.5rpx;
}

/* 右侧闪光：放大 + 旋转的活泼小动效 */
.daily-quote-spark {
  flex-shrink: 0;
  font-size: 30rpx;
  animation: quote-spark 2.2s ease-in-out infinite;
}

@keyframes quote-in {
  0% { opacity: 0; transform: translateY(16rpx) scale(0.96); }
  100% { opacity: 1; transform: translateY(0) scale(1); }
}

@keyframes quote-shine {
  0% { left: -40%; }
  60% { left: 120%; }
  100% { left: 120%; }
}

@keyframes quote-mark-wiggle {
  0%, 100% { transform: rotate(0deg); }
  25% { transform: rotate(-6deg); }
  75% { transform: rotate(6deg); }
}

@keyframes quote-spark {
  0%, 100% { transform: scale(1) rotate(0deg); opacity: 0.85; }
  50% { transform: scale(1.25) rotate(18deg); opacity: 1; }
}

.task-card {
  padding: 28rpx;
  background: #12212F;
  border: none;
  box-shadow: 0 16rpx 36rpx rgba(18, 33, 47, 0.18);
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 24rpx;
  margin-bottom: 20rpx;
}

.eyebrow {
  display: block;
  margin-bottom: 8rpx;
  font-size: 20rpx;
  font-weight: 700;
  color: rgba(255, 255, 255, 0.52);
}

.card-title {
  display: block;
  font-size: 32rpx;
  font-weight: 700;
  color: #17212B;
  line-height: 1.3;
}

.task-card .card-title {
  color: #FFFFFF;
}

.card-icon {
  width: 60rpx;
  height: 60rpx;
  padding: 12rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.1);
  flex-shrink: 0;
}

.task-info {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
  margin-bottom: 20rpx;
}

.task-item {
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: rgba(255, 255, 255, 0.08);
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.task-value {
  font-size: 38rpx;
  font-weight: 800;
  color: #FFFFFF;
  line-height: 1.1;
}

.task-label {
  font-size: 23rpx;
  color: rgba(255, 255, 255, 0.62);
}

.task-button {
  min-height: 76rpx;
  border-radius: 18rpx;
  background: #12B7A8;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 700;
  box-shadow: 0 10rpx 24rpx rgba(18, 183, 168, 0.22);
}

.task-button:active,
.ability-item:active {
  transform: translateY(2rpx);
}

.arrow {
  font-size: 24rpx;
}

.ability-section {
  margin: 0 0 16rpx;
}

.ability-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.ability-item {
  padding: 20rpx 24rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
  box-shadow: 0 8rpx 24rpx rgba(23, 33, 43, 0.04);
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
}

.ability-icon {
  width: 44rpx;
  height: 44rpx;
  padding: 10rpx;
  border-radius: 16rpx;
  background: rgba(18, 183, 168, 0.1);
  flex-shrink: 0;
}

.icon {
  width: 100%;
  height: 100%;
}

.ability-text {
  display: flex;
  flex-direction: column;
  min-width: 0;
}

.ability-value {
  font-size: 36rpx;
  font-weight: 800;
  color: #17212B;
  line-height: 1.2;
}

.ability-label {
  font-size: 22rpx;
  color: #7A8794;
}

/* ====================== 听说读写打卡模块 ====================== */
.checkin-section-sub {
  font-size: 22rpx;
  color: #7A8794;
}

.checkin-module-grid {
  margin-top: 18rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 14rpx;
}

.checkin-module-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 6rpx;
  padding: 16rpx 0 12rpx;
  border-radius: 20rpx;
  background: #F6F8FB;
  transition: all 0.2s ease;
}

.checkin-module-item:active {
  transform: scale(0.96);
}

.checkin-module-item.checked {
  background: rgba(18, 183, 168, 0.08);
}

.checkin-module-icon-wrap {
  position: relative;
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkin-module-icon {
  width: 38rpx;
  height: 38rpx;
}

.checkin-module-badge {
  position: absolute;
  right: -6rpx;
  bottom: -6rpx;
  width: 32rpx;
  height: 32rpx;
  border-radius: 50%;
  background: #12B7A8;
  color: #FFFFFF;
  font-size: 20rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 3rpx solid #FFFFFF;
}

.checkin-module-label {
  font-size: 24rpx;
  font-weight: 600;
  color: #17212B;
}

.checkin-module-status {
  font-size: 20rpx;
  color: #9AA5B1;
}

.checkin-module-item.checked .checkin-module-status {
  color: #12B7A8;
  font-weight: 600;
}

/* ====================== 打卡激励动效弹窗 ====================== */
/* ====================== 打卡内容输入弹窗 ====================== */
.checkin-input-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkin-input-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 33, 43, 0.5);
}

.checkin-input-card {
  position: relative;
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 30rpx 80rpx rgba(23, 33, 47, 0.28);
  animation: celebration-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-sizing: border-box;
}

.checkin-input-header {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 28rpx;
}

.checkin-input-icon-wrap {
  flex-shrink: 0;
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: rgba(18, 183, 168, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
}

.checkin-input-icon {
  width: 48rpx;
  height: 48rpx;
}

.checkin-input-titles {
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.checkin-input-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #17212B;
}

.checkin-input-sub {
  font-size: 24rpx;
  color: #9AA5B1;
}

.checkin-input-textarea {
  width: 100%;
  min-height: 160rpx;
  max-height: 360rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #F6F8FB;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
  font-size: 28rpx;
  color: #17212B;
  line-height: 1.6;
  box-sizing: border-box;
  margin-bottom: 32rpx;
}

.checkin-input-placeholder {
  color: #B5BEC8;
}

.checkin-input-actions {
  display: flex;
  gap: 16rpx;
}

.checkin-input-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
  box-sizing: border-box;
}

.checkin-input-btn:active {
  transform: scale(0.97);
}

.checkin-input-btn.cancel {
  background: #F6F8FB;
  color: #64717F;
  border: 1rpx solid rgba(23, 33, 43, 0.08);
}

.checkin-input-btn.confirm {
  background: #12B7A8;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(18, 183, 168, 0.22);
}

.checkin-input-btn.confirm.disabled {
  opacity: 0.6;
}

.celebration-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}

.celebration-mask {
  position: absolute;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(23, 33, 43, 0.5);
}

.celebration-card {
  position: relative;
  width: 580rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 56rpx 40rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 30rpx 80rpx rgba(23, 33, 47, 0.28);
  animation: celebration-pop 0.32s cubic-bezier(0.34, 1.56, 0.64, 1);
}

@keyframes celebration-pop {
  0% { transform: scale(0.6); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.celebration-burst {
  position: relative;
  width: 180rpx;
  height: 180rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}

.celebration-icon-wrap {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: rgba(18, 183, 168, 0.12);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 2;
}

.celebration-icon {
  width: 64rpx;
  height: 64rpx;
}

.celebration-check {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #12B7A8;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  border: 4rpx solid #FFFFFF;
}

.burst-dot {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #12B7A8;
  opacity: 0;
  animation: burst-fly 0.8s ease-out forwards;
}

.dot-1 { background: #12B7A8; transform: translate(-50%, -50%) rotate(0deg) translateY(-100rpx); animation-delay: 0.05s; }
.dot-2 { background: #FFC76B; transform: translate(-50%, -50%) rotate(60deg) translateY(-100rpx); animation-delay: 0.1s; }
.dot-3 { background: #FF8FA3; transform: translate(-50%, -50%) rotate(120deg) translateY(-100rpx); animation-delay: 0.02s; }
.dot-4 { background: #6FB7FF; transform: translate(-50%, -50%) rotate(180deg) translateY(-100rpx); animation-delay: 0.15s; }
.dot-5 { background: #B49CFF; transform: translate(-50%, -50%) rotate(240deg) translateY(-100rpx); animation-delay: 0.08s; }
.dot-6 { background: #12B7A8; transform: translate(-50%, -50%) rotate(300deg) translateY(-100rpx); animation-delay: 0.12s; }

@keyframes burst-fly {
  0% { opacity: 1; transform: translate(-50%, -50%) scale(0.4); }
  70% { opacity: 1; }
  100% { opacity: 0; transform: translate(-50%, -50%) scale(1.6) translateY(-40rpx); }
}

.celebration-title {
  font-size: 36rpx;
  font-weight: 800;
  color: #17212B;
  margin-bottom: 12rpx;
}

.celebration-message {
  font-size: 26rpx;
  color: #7A8794;
  text-align: center;
  line-height: 1.6;
  margin-bottom: 36rpx;
}

.celebration-actions {
  width: 100%;
  display: flex;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.celebration-btn {
  flex: 1;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1;
  padding: 0;
  margin: 0;
}

.celebration-btn::after {
  border: none;
}

.celebration-btn.share-friend {
  background: #12B7A8;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(18, 183, 168, 0.22);
}

.celebration-btn.share-timeline {
  background: #F6F8FB;
  color: #17212B;
  border: 1rpx solid rgba(23, 33, 43, 0.08);
}

.celebration-close {
  font-size: 24rpx;
  color: #9AA5B1;
}
