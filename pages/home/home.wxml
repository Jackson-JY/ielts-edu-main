<!-- pages/home/home.wxml -->
<view class="page">
  <!-- 顶部问候 -->
  <view class="header">
    <image class="user-avatar" src="{{userAvatar || '/images/default-avatar.png'}}" mode="aspectFill" />
    <view class="header-text">
      <text class="greeting">你好，{{userName}} 👋</text>
      <text class="date-text">{{currentDate}}</text>
    </view>
  </view>

  <!-- 今日任务卡片 -->
  <view class="section-card task-card">
    <view class="card-header">
      <text class="card-title">今日任务</text>
      <view class="card-icon">
        <image class="icon" src="{{iconBook}}" mode="aspectFit"/>
      </view>
    </view>
    <view class="task-info">
      <view class="task-item">
        <text class="task-label">今日课程：</text>
        <text class="task-value">{{todayCourses}} 节</text>
      </view>
      <view class="task-item">
        <text class="task-label">已提交作业：</text>
        <text class="task-value">{{submittedHomework}} / {{totalHomework}}</text>
      </view>
    </view>
    <view class="task-button" bindtap="goToCourses">
      <text>去学习</text>
      <text class="arrow">→</text>
    </view>
  </view>

  <!-- 能力概览 -->
  <view class="ability-section">
    <view class="ability-grid">
      <view class="ability-item">
        <view class="ability-icon">
          <image class="icon" src="{{iconTarget}}" mode="aspectFit"/>
        </view>
        <text class="ability-value">{{targetScore}}</text>
        <text class="ability-label">目标分数</text>
      </view>
      <view class="ability-item">
        <view class="ability-icon">
          <image class="icon" src="{{iconChart}}" mode="aspectFit"/>
        </view>
        <text class="ability-value">{{currentScore}}</text>
        <text class="ability-label">当前分数</text>
      </view>
      <view class="ability-item">
        <view class="ability-icon">
          <image class="icon" src="{{iconCalendar}}" mode="aspectFit"/>
        </view>
        <text class="ability-value">{{studyDays}}</text>
        <text class="ability-label">学习天数</text>
      </view>
      <view class="ability-item">
        <view class="ability-icon">
          <image class="icon" src="{{iconFire}}" mode="aspectFit"/>
        </view>
        <text class="ability-value">{{streakDays}}</text>
        <text class="ability-label">连续打卡</text>
      </view>
    </view>
  </view>

  <!-- 预约试听课程 -->
  <view class="section-card trial-card">
    <text class="card-title">预约试听课程</text>
    <text class="card-sub">体验专业雅思教学</text>
    <view class="trial-price">
      <text class="price">¥400</text>
      <text class="price-note">支持优惠码</text>
    </view>
    <view class="trial-button" bindtap="goToTrialBooking">
      <text>立即预约</text>
    </view>
  </view>

</view>
