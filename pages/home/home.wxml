<!-- pages/home/home.wxml -->
<view class="page">
  <!-- 顶部问候 -->
  <view class="header">
    <image class="user-avatar" src="{{userAvatar || defaultAvatarUrl}}" mode="aspectFill" />
    <view class="header-text">
      <text class="greeting">{{userName}}，你好</text>
      <text class="date-text">{{currentDate}}</text>
    </view>
  </view>

  <!-- 每日寄语：白色卡片 + 左侧薄荷绿竖线 -->
  <view class="daily-quote" wx:if="{{dailyQuote}}">
    <view class="daily-quote-bar"></view>
    <text class="daily-quote-text">{{dailyQuote}}</text>
  </view>

  <!-- 今日任务卡片：白色卡片 + eyebrow -->
  <view class="section-card task-card">
    <view class="card-header">
      <view class="card-header-text">
        <text class="eyebrow">TODAY</text>
        <text class="card-title">今日学习任务</text>
      </view>
      <view class="card-icon-wrap">
        <icon name="book" color="#12B7A8" size="36rpx"/>
      </view>
    </view>
    <view class="task-info">
      <view class="task-item">
        <text class="task-value">{{todayCourses}}</text>
        <text class="task-label">今日课程</text>
      </view>
      <view class="task-divider"></view>
      <view class="task-item">
        <text class="task-value">{{submittedHomework}}/{{totalHomework}}</text>
        <text class="task-label">作业进度</text>
      </view>
    </view>
    <view class="task-button" bindtap="goToCourses">
      <text>去学习</text>
      <icon name="arrow-right" color="#FFFFFF" size="28rpx"/>
    </view>
  </view>

  <!-- 能力测评入口：薄荷绿浅底卡片，点击进入测评引导页 -->
  <view class="assessment-entry" bindtap="goToAssessment">
    <view class="assessment-entry-left">
      <view class="assessment-entry-icon-wrap">
        <icon name="target" color="#12B7A8" size="40rpx"/>
      </view>
      <view class="assessment-entry-text">
        <text class="assessment-entry-title">英语能力测评</text>
        <text class="assessment-entry-sub">听说读写全面诊断 · 约 20 分钟</text>
      </view>
    </view>
    <view class="assessment-entry-btn">
      <text>开始测评</text>
      <icon name="arrow-right" color="#FFFFFF" size="24rpx"/>
    </view>
  </view>

  <!-- 能力概览：无边框浅灰块 -->
  <view class="ability-grid">
    <view class="ability-item">
      <view class="ability-icon-wrap">
        <icon name="calendar" color="#12B7A8" size="32rpx"/>
      </view>
      <view class="ability-text">
        <text class="ability-value">{{studyDays}}</text>
        <text class="ability-label">学习天数</text>
      </view>
    </view>
    <view class="ability-item">
      <view class="ability-icon-wrap">
        <icon name="flame" color="#12B7A8" size="32rpx"/>
      </view>
      <view class="ability-text">
        <text class="ability-value">{{streakDays}}</text>
        <text class="ability-label">连续打卡</text>
      </view>
    </view>
  </view>

  <!-- 今日打卡任务 -->
  <view class="section-card checkin-section">
    <view class="card-header">
      <view class="card-header-text">
        <text class="eyebrow eyebrow-brand">DAILY CHECK-IN</text>
        <text class="card-title">今日打卡</text>
      </view>
      <text class="checkin-progress" wx:if="{{dailyTask}}">已完成 {{completedCount}}/{{totalItems}} 项</text>
    </view>

    <!-- 未发布 -->
    <view class="task-empty" wx:if="{{!dailyTask && !dailyTaskLoading}}">
      <text class="task-empty-text">今日任务待发布</text>
    </view>

    <!-- 任务列表 -->
    <view class="task-list" wx:if="{{dailyTask}}">
      <view class="task-row {{item.done ? 'done' : ''}}"
            wx:for="{{taskItems}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onTapTaskItem">
        <view class="task-check">
          <view class="task-check-dot" wx:if="{{!item.done}}"></view>
          <view class="task-check-dot done" wx:else>
            <icon name="check" color="#FFFFFF" size="20rpx"/>
          </view>
        </view>
        <view class="task-row-body">
          <view class="task-row-top">
            <view class="task-subject-dot" style="background: {{item.subject === 'listening' ? '#5AC8FA' : item.subject === 'speaking' ? '#FF9500' : item.subject === 'reading' ? '#34C759' : '#AF52DE'}};"></view>
            <text class="task-content">{{item.content}}</text>
          </view>
          <view class="task-row-bottom">
            <text class="task-suggest">建议 {{item.suggestMinutes}} 分钟</text>
            <text class="task-actual" wx:if="{{item.done && item.actualMinutes > 0}}">实际 {{item.actualMinutes}} 分钟</text>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 实际用时输入弹窗 -->
  <view class="checkin-input-overlay" wx:if="{{showMinutesInput}}">
    <view class="checkin-input-mask" bindtap="closeMinutesInput"></view>
    <view class="checkin-input-card">
      <view class="checkin-input-header">
        <view class="checkin-input-icon-wrap">
          <icon name="clock" color="#12B7A8" size="44rpx"/>
        </view>
        <view class="checkin-input-titles">
          <text class="checkin-input-title">完成打卡</text>
          <text class="checkin-input-sub">{{minutesInputContent}}</text>
        </view>
      </view>

      <view class="minutes-input-wrap">
        <input class="minutes-input"
               type="number"
               placeholder="实际用时（分钟，可不填）"
               placeholder-class="checkin-input-placeholder"
               value="{{minutesInputValue}}"
               bindinput="onMinutesInput"
               maxlength="4" />
      </view>

      <view class="checkin-input-actions">
        <view class="checkin-input-btn cancel" bindtap="closeMinutesInput">
          <text>取消</text>
        </view>
        <view class="checkin-input-btn confirm {{minutesSubmitting ? 'disabled' : ''}}" bindtap="onConfirmMinutes">
          <text>{{minutesSubmitting ? '提交中' : '完成打卡'}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 全部完成庆祝弹窗 -->
  <view class="celebration-overlay" wx:if="{{showCelebration}}">
    <view class="celebration-mask" bindtap="hideCelebration"></view>
    <view class="celebration-card">
      <view class="celebration-icon-wrap">
        <icon name="check-circle" color="#12B7A8" size="120rpx"/>
      </view>
      <text class="celebration-title">今日任务全部完成</text>
      <text class="celebration-message">{{celebrationMessage}}</text>

      <view class="celebration-actions">
        <button class="celebration-btn share-friend" open-type="share">
          <text>一键转发到群聊</text>
        </button>
        <view class="celebration-btn poster-btn" bindtap="openPosterSheet">
          <text>生成打卡海报</text>
        </view>
      </view>

      <view class="celebration-close" bindtap="hideCelebration">
        <text>知道了</text>
      </view>
    </view>
  </view>

  <!-- 海报科目标签切换弹层 -->
  <view class="poster-sheet-overlay" wx:if="{{showPosterSheet}}">
    <view class="poster-sheet-mask" bindtap="closePosterSheet"></view>
    <view class="poster-sheet">
      <text class="poster-sheet-title">选择海报主题</text>
      <view class="poster-subject-row">
        <view class="poster-subject-chip {{posterSubject === 'all' ? 'active' : ''}}"
              data-subject="all" bindtap="onSelectPosterSubject">
          <text>全科</text>
        </view>
        <view class="poster-subject-chip {{posterSubject === item.subject ? 'active' : ''}}"
              wx:for="{{taskItems}}" wx:key="id"
              data-subject="{{item.subject}}" bindtap="onSelectPosterSubject">
          <text>{{item.subject === 'listening' ? '听力' : item.subject === 'speaking' ? '口语' : item.subject === 'reading' ? '阅读' : '写作'}}</text>
        </view>
      </view>
      <view class="poster-generate-btn {{posterGenerating ? 'disabled' : ''}}" bindtap="generatePoster">
        <text>{{posterGenerating ? '生成中…' : '生成海报'}}</text>
      </view>
    </view>
  </view>

  <!-- 海报结果页内预览 -->
  <view class="poster-preview-overlay" wx:if="{{showPosterPreview}}">
    <view class="poster-preview-mask" bindtap="closePosterPreview"></view>
    <view class="poster-preview-card">
      <image class="poster-preview-img" src="{{posterTempPath}}" mode="aspectFit" show-menu-by-longpress></image>
      <view class="poster-preview-actions">
        <view class="poster-preview-btn save {{posterSaving ? 'disabled' : ''}}" bindtap="savePosterToAlbum">
          <text>{{posterSaving ? '保存中…' : '保存到相册'}}</text>
        </view>
        <view class="poster-preview-btn done" bindtap="closePosterPreview">
          <text>完成</text>
        </view>
      </view>
      <text class="poster-preview-tip">长按图片可转发给好友</text>
    </view>
  </view>

  <!-- 离屏 Canvas（常驻页面，仅用于绘制海报） -->
  <canvas type="2d" id="posterCanvas" class="poster-canvas-hide"></canvas>

</view>
