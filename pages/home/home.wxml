<!-- pages/home/home.wxml -->
<view class="page">
  <!-- 顶部问候 -->
  <view class="header">
    <image class="user-avatar" src="{{userAvatar || defaultAvatarUrl || iconUser}}" mode="aspectFill" />
    <view class="header-text">
      <text class="greeting">你好，{{userName}}</text>
      <text class="date-text">{{currentDate}}</text>
    </view>
  </view>

  <!-- 今日任务卡片 -->
  <view class="section-card task-card">
    <view class="card-header">
      <view>
        <text class="eyebrow">TODAY</text>
        <text class="card-title">今日学习任务</text>
      </view>
      <image class="card-icon" src="{{iconBook}}" mode="aspectFit"/>
    </view>
    <view class="task-info">
      <view class="task-item">
        <text class="task-value">{{todayCourses}}</text>
        <text class="task-label">今日课程</text>
      </view>
      <view class="task-item">
        <text class="task-value">{{submittedHomework}}/{{totalHomework}}</text>
        <text class="task-label">作业进度</text>
      </view>
    </view>
    <view class="task-button" bindtap="goToCourses">
      <text>去学习</text>
      <text class="arrow">→</text>
    </view>
  </view>

  <!-- 能力概览 -->
  <view class="ability-section">
    <view class="ability-grid">
      <view class="ability-item">
        <view class="ability-icon">
          <image class="icon" src="{{iconTarget}}" mode="aspectFit"/>
        </view>
        <text class="ability-value">{{targetScore}}</text>
        <text class="ability-label">目标分数</text>
      </view>
      <view class="ability-item">
        <view class="ability-icon">
          <image class="icon" src="{{iconChart}}" mode="aspectFit"/>
        </view>
        <text class="ability-value">{{currentScore}}</text>
        <text class="ability-label">当前分数</text>
      </view>
      <view class="ability-item">
        <view class="ability-icon">
          <image class="icon" src="{{iconCalendar}}" mode="aspectFit"/>
        </view>
        <text class="ability-value">{{studyDays}}</text>
        <text class="ability-label">学习天数</text>
      </view>
      <view class="ability-item">
        <view class="ability-icon">
          <image class="icon" src="{{iconFire}}" mode="aspectFit"/>
        </view>
        <text class="ability-value">{{streakDays}}</text>
        <text class="ability-label">连续打卡</text>
      </view>
    </view>
  </view>

  <!-- 听说读写打卡 -->
  <view class="section-card checkin-section">
    <view class="card-header">
      <view>
        <text class="eyebrow">DAILY CHECK-IN</text>
        <text class="card-title">今天打卡了吗？</text>
      </view>
      <text class="checkin-section-sub">点一下，记录你的进步</text>
    </view>
    <view class="checkin-module-grid">
      <view class="checkin-module-item {{item.checkedToday ? 'checked' : ''}}"
            wx:for="{{checkinModules}}"
            wx:key="id"
            data-id="{{item.id}}"
            data-label="{{item.label}}"
            bindtap="onTapCheckinModule">
        <view class="checkin-module-icon-wrap" style="background-color: {{item.bgColor}};">
          <image class="checkin-module-icon" src="{{item.icon}}" mode="aspectFit"/>
          <view class="checkin-module-badge" wx:if="{{item.checkedToday}}">✓</view>
        </view>
        <text class="checkin-module-label">{{item.label}}</text>
        <text class="checkin-module-status">{{item.checkedToday ? '已打卡' : '去打卡'}}</text>
      </view>
    </view>
  </view>

  <!-- 打卡激励动效弹窗 -->
  <view class="celebration-overlay" wx:if="{{showCelebration}}">
    <view class="celebration-mask" bindtap="hideCelebration"></view>
    <view class="celebration-card">
      <!-- 庆祝光效/贴纸 -->
      <view class="celebration-burst">
        <view class="burst-dot dot-1"></view>
        <view class="burst-dot dot-2"></view>
        <view class="burst-dot dot-3"></view>
        <view class="burst-dot dot-4"></view>
        <view class="burst-dot dot-5"></view>
        <view class="burst-dot dot-6"></view>
        <view class="celebration-icon-wrap">
          <image class="celebration-icon" src="{{celebrationIcon}}" mode="aspectFit"/>
          <view class="celebration-check">✓</view>
        </view>
      </view>

      <text class="celebration-title">{{celebrationLabel}}打卡成功！</text>
      <text class="celebration-message">{{celebrationMessage}}</text>

      <view class="celebration-actions">
        <button class="celebration-btn share-friend" open-type="share" bindtap="onTapShareToFriend">
          <text>转发给好友</text>
        </button>
        <view class="celebration-btn share-timeline" bindtap="onTapShareToTimeline">
          <text>分享到朋友圈</text>
        </view>
      </view>

      <view class="celebration-close" bindtap="hideCelebration">
        <text>知道了</text>
      </view>
    </view>
  </view>

  <!-- 预约试听课程 -->
  <view class="section-card trial-card">
    <view class="trial-content">
      <view>
        <text class="card-title">预约试听课程</text>
        <text class="card-sub">体验专业雅思教学</text>
      </view>
      <view class="trial-price">
        <text class="price">¥400</text>
        <text class="price-note">支持优惠码</text>
      </view>
    </view>
    <view class="trial-button" bindtap="goToTrialBooking">
      <text>立即预约</text>
    </view>
  </view>

</view>
