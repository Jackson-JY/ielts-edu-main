<!-- pages/trial-booking/trial-booking.wxml -->
<view class="container">
  <!-- 课程介绍 -->
  <view class="course-intro">
    <image class="course-image" src="{{courseImageUrl}}" mode="aspectFill"></image>
    <view class="course-info">
      <view class="course-title">雅思入门体验课</view>
      <view class="course-subtitle">专业老师一对一试听，定制你的学习方案</view>
      <view class="course-tags">
        <view class="tag tag-price">¥400</view>
        <view class="tag">1对1</view>
        <view class="tag">45分钟</view>
      </view>
    </view>
  </view>

  <!-- 课程亮点 -->
  <view class="highlights-section">
    <view class="section-title">课程亮点</view>
    <view class="highlight-list">
      <view class="highlight-item">
        <view class="highlight-icon">🎯</view>
        <view class="highlight-content">
          <view class="highlight-title">水平评估</view>
          <view class="highlight-desc">专业老师评估你的当前水平，找出薄弱环节</view>
        </view>
      </view>
      <view class="highlight-item">
        <view class="highlight-icon">📚</view>
        <view class="highlight-content">
          <view class="highlight-title">试听体验</view>
          <view class="highlight-desc">体验真实课堂，感受教学风格</view>
        </view>
      </view>
      <view class="highlight-item">
        <view class="highlight-icon">📋</view>
        <view class="highlight-content">
          <view class="highlight-title">学习方案</view>
          <view class="highlight-desc">根据评估结果，定制个性化学习计划</view>
        </view>
      </view>
    </view>
  </view>

  <!-- 填写信息 -->
  <view class="info-section">
    <view class="section-title">填写信息</view>
    
    <view class="form-group">
      <view class="form-label">姓名</view>
      <input 
        class="form-input" 
        placeholder="请输入你的姓名" 
        value="{{formData.name}}"
        bindinput="onInputChange"
        data-field="name">
      </input>
    </view>

    <view class="form-group">
      <view class="form-label">手机号</view>
      <input 
        class="form-input" 
        type="number"
        maxlength="11"
        placeholder="请输入手机号" 
        value="{{formData.phone}}"
        bindinput="onInputChange"
        data-field="phone">
      </input>
    </view>

    <view class="form-group">
      <view class="form-label">当前水平</view>
      <picker 
        mode="selector" 
        range="{{levelOptions}}"
        value="{{levelIndex}}"
        bindchange="onLevelChange">
        <view class="form-picker">
          <text class="{{formData.level ? '' : 'placeholder'}}">{{formData.level || '请选择当前英语水平'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <view class="form-group">
      <view class="form-label">学习目标</view>
      <picker 
        mode="selector" 
        range="{{goalOptions}}"
        value="{{goalIndex}}"
        bindchange="onGoalChange">
        <view class="form-picker">
          <text class="{{formData.goal ? '' : 'placeholder'}}">{{formData.goal || '请选择学习目标'}}</text>
          <text class="picker-arrow">▼</text>
        </view>
      </picker>
    </view>

    <!-- 优惠码 -->
    <view class="form-group">
      <view class="form-label">优惠码</view>
      <view class="coupon-input-wrapper">
        <input 
          class="form-input coupon-input" 
          placeholder="请输入优惠码（选填）" 
          value="{{formData.couponCode}}"
          bindinput="onInputChange"
          data-field="couponCode">
        </input>
        <button class="coupon-btn {{formData.couponCode ? 'active' : ''}}" bindtap="applyCoupon" disabled="{{!formData.couponCode || couponApplied}}">
          {{couponApplied ? '已使用' : '应用'}}
        </button>
      </view>
      <view class="coupon-tip" wx:if="{{!couponApplied}}">输入优惠码可享受对应金额减免</view>
      <view class="coupon-success" wx:if="{{couponApplied}}">
        <text class="coupon-text">优惠码已生效，减免 ¥{{couponDiscount}}</text>
      </view>
    </view>
  </view>

  <!-- 价格信息 -->
  <view class="price-section">
    <view class="price-row">
      <text class="price-label">课程价格</text>
      <text class="price-original">¥{{originalPrice}}</text>
    </view>
    <view class="price-row" wx:if="{{couponApplied}}">
      <text class="price-label">优惠减免</text>
      <text class="price-discount">-¥{{couponDiscount}}</text>
    </view>
    <view class="price-row price-total">
      <text class="price-label">实付金额</text>
      <text class="price-final">¥{{finalPrice}}</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <button class="submit-btn" bindtap="submitBooking" disabled="{{!canSubmit}}">
    立即支付 ¥{{finalPrice}}
  </button>

  <!-- 提示信息 -->
  <view class="tips">
    <view class="tips-title">温馨提示</view>
    <view class="tips-item">1. 支付成功后，老师会在24小时内联系您</view>
    <view class="tips-item">2. 如有疑问，请联系客服微信：ielts001</view>
    <view class="tips-item">3. 支持微信支付，安全有保障</view>
    <view class="tips-item">4. 每个优惠码仅限使用一次</view>
  </view>
</view>
