/* 试听预约页面样式 */
page {
  background-color: #F5F0FF;
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.container {
  padding: 30rpx;
  padding-bottom: 60rpx;
}

/* 课程介绍 */
.course-intro {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  overflow: hidden;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.course-image {
  width: 100%;
  height: 320rpx;
}

.course-info {
  padding: 30rpx;
}

.course-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A4A4A;
  margin-bottom: 12rpx;
}

.course-subtitle {
  font-size: 28rpx;
  color: #9A97AA;
  margin-bottom: 20rpx;
  line-height: 1.5;
}

.course-tags {
  display: flex;
  gap: 16rpx;
}

.tag {
  padding: 8rpx 20rpx;
  background-color: #F0EDFF;
  color: #6C5CE7;
  font-size: 24rpx;
  border-radius: 20rpx;
  font-weight: 500;
}

.tag-price {
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  color: #FFFFFF;
  font-weight: 600;
}

/* 课程亮点 */
.highlights-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
  margin-bottom: 24rpx;
}

.highlight-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.highlight-item {
  display: flex;
  align-items: flex-start;
  padding: 20rpx;
  background-color: #F8F9FA;
  border-radius: 12rpx;
}

.highlight-icon {
  font-size: 48rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.highlight-content {
  flex: 1;
}

.highlight-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A4A;
  margin-bottom: 8rpx;
}

.highlight-desc {
  font-size: 24rpx;
  color: #9A97AA;
  line-height: 1.5;
}

/* 选择时间 */
.time-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.date-list {
  display: flex;
  gap: 16rpx;
  margin-bottom: 30rpx;
  overflow-x: auto;
  white-space: nowrap;
  padding-bottom: 10rpx;
}

.date-item {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 160rpx;
  background-color: #F8F9FA;
  border-radius: 12rpx;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.date-item.active {
  background-color: #6C5CE7;
  color: #FFFFFF;
}

.date-weekday {
  font-size: 24rpx;
  margin-bottom: 8rpx;
}

.date-day {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 4rpx;
}

.date-month {
  font-size: 20rpx;
  color: #9A97AA;
}

.date-item.active .date-month {
  color: rgba(255, 255, 255, 0.8);
}

.time-list {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 16rpx;
}

.time-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
  background-color: #F8F9FA;
  border-radius: 12rpx;
  transition: all 0.3s ease;
}

.time-item.active {
  background-color: #6C5CE7;
  color: #FFFFFF;
}

.time-item.disabled {
  opacity: 0.5;
  pointer-events: none;
}

.time-text {
  font-size: 28rpx;
  font-weight: 500;
  margin-bottom: 8rpx;
}

.time-status {
  font-size: 20rpx;
  color: #9A97AA;
}

.time-item.active .time-status {
  color: rgba(255, 255, 255, 0.8);
}

/* 填写信息 */
.info-section {
  background-color: #FFFFFF;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
}

.form-group {
  margin-bottom: 30rpx;
}

.form-group:last-child {
  margin-bottom: 0;
}

.form-label {
  font-size: 28rpx;
  font-weight: 500;
  color: #4A4A4A;
  margin-bottom: 16rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background-color: #F8F9FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #4A4A4A;
  box-sizing: border-box;
}

.form-picker {
  width: 100%;
  height: 88rpx;
  background-color: #F8F9FA;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #4A4A4A;
  display: flex;
  align-items: center;
  justify-content: space-between;
  box-sizing: border-box;
}

.picker-arrow {
  font-size: 24rpx;
  color: #9A97AA;
}

.placeholder {
  color: #C0C4CC;
}

/* 提交按钮 */
.submit-btn {
  width: 100%;
  height: 96rpx;
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%);
  border-radius: 48rpx;
  color: #FFFFFF;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  margin-bottom: 30rpx;
}

.submit-btn::after {
  border: none;
}

.submit-btn[disabled] {
  background: #CCCCCC;
  color: #FFFFFF;
}

/* 提示信息 */
.tips {
  background-color: #FFF9F5;
  border-radius: 12rpx;
  padding: 24rpx;
  border-left: 6rpx solid #FF9500;
}

.tips-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #FF9500;
  margin-bottom: 16rpx;
}

.tips-item {
  font-size: 24rpx;
  color: #9A97AA;
  line-height: 1.8;
}
