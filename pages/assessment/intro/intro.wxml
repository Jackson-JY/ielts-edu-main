<!-- pages/assessment/intro/intro.wxml -->
<view class="page">
  <view class="container">
    <!-- 标题区域 -->
    <view class="header">
      <text class="main-title">先测一测，找到你的起点</text>
      <text class="subtitle">选择任意一项进行测评，或完成完整测评</text>
    </view>

    <!-- 测评模块列表（可点击选择） -->
    <view class="modules-list">
      <view 
        class="module-item" 
        wx:for="{{modules}}" 
        wx:key="id"
        data-index="{{index}}"
        bindtap="selectModule"
      >
        <view class="module-icon" style="background-color: {{item.bgColor}};">
          <image wx:if="{{item.icon}}" src="{{item.icon}}" mode="aspectFit" class="icon-img"/>
        </view>
        <view class="module-content">
          <text class="module-title">{{item.title}}</text>
          <text class="module-desc">{{item.desc}}</text>
          <text class="module-duration">{{item.duration}}</text>
        </view>
        <view class="module-arrow">
          <text class="arrow-icon">→</text>
        </view>
      </view>
    </view>

    <!-- 底部按钮 -->
    <view class="bottom-actions">
      <button class="btn btn-primary" bindtap="startFullAssessment">开始完整测评</button>
      <button class="btn btn-secondary" bindtap="viewResult">查看测评结果</button>
      <button class="btn btn-text" bindtap="skipAssessment">跳过，直接进入学习</button>
    </view>
  </view>
</view>
