/* pages/assessment/intro/intro.wxss */
page {
  background-color: #FFF9F5;
}

.page {
  min-height: 100vh;
  padding: 0 30rpx 200rpx;
}

.container {
  display: flex;
  flex-direction: column;
}

/* 标题区域 */
.header {
  padding: 60rpx 0 40rpx;
  text-align: center;
}

.main-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #9A97AA;
  display: block;
}

/* 模块列表 */
.modules-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.module-item {
  display: flex;
  align-items: flex-start;
  gap: 24rpx;
  padding: 30rpx;
  background-color: #F5F0FF;
  border-radius: 32rpx;
}

.module-icon {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  overflow: hidden;
}

.icon-img {
  width: 56rpx;
  height: 56rpx;
}

.module-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.module-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
}

.module-desc {
  font-size: 26rpx;
  color: #9A97AA;
  display: block;
  line-height: 1.5;
}

.module-duration {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 30rpx;
  background-color: #FFF9F5;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background-color: #A7FBF5;
  color: #4A4A4A;
}

.btn-text {
  background-color: transparent;
  color: #9A97AA;
}
