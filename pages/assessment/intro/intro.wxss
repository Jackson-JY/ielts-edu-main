/* pages/assessment/intro/intro.wxss */

.page {
  background: #FFF9F5;
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
}

.container {
  display: flex;
  flex-direction: column;
  gap: 48rpx;
}

/* 标题区域 */
.header {
  padding: 48rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #9A97AA;
  display: block;
}

/* 测评说明卡片 */
.intro-card {
  background: #F5F0FF;
  border-radius: 44rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.intro-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.intro-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 28rpx;
  background: #E8D4F8;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  flex-shrink: 0;
}

.intro-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.intro-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
}

.intro-desc {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
}

/* 开始测评按钮 */
.start-button {
  width: 100%;
  padding: 32rpx 0;
  background: #A7FBF5;
  border-radius: 60rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
}
