/* pages/assessment/intro/intro.wxss */
page {
  background-color: #F5F5F7;
}

.page {
  min-height: 100vh;
  padding: 0 32rpx 220rpx;
}

.container {
  display: flex;
  flex-direction: column;
}

/* 标题区域 */
.header {
  padding: 56rpx 0 40rpx;
}

.main-title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1D1D1F;
  display: block;
  margin-bottom: 16rpx;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.subtitle {
  font-size: 28rpx;
  color: #6E6E73;
  display: block;
  line-height: 1.5;
}

/* 模块列表 */
.modules-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 40rpx;
}

.module-item {
  display: flex;
  align-items: center;
  gap: 24rpx;
  padding: 24rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
}

.module-item:active {
  background: #F2F2F7;
}

.module-arrow {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 32rpx;
  height: 32rpx;
  flex-shrink: 0;
}

.module-icon {
  width: 80rpx;
  height: 80rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  background: #E6F7F5;
}

.module-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
  min-width: 0;
}

.module-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
  letter-spacing: -0.01em;
}

.module-desc {
  font-size: 26rpx;
  color: #6E6E73;
  display: block;
  line-height: 1.5;
}

.module-duration {
  font-size: 24rpx;
  color: #8E8E93;
  display: block;
}

/* 底部按钮 */
.bottom-actions {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 24rpx 32rpx;
  padding-bottom: calc(24rpx + env(safe-area-inset-bottom));
  background-color: #F5F5F7;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 999px;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: filter 0.18s ease;
}

.btn::after {
  border: none;
}

.btn-primary {
  background-color: #12B7A8;
  color: #FFFFFF;
}

.btn-primary:active {
  filter: brightness(0.92);
}

.btn-secondary {
  background-color: #F2F2F7;
  color: #12B7A8;
}

.btn-secondary:active {
  background-color: #E5E5EA;
}

.btn-text {
  background-color: transparent;
  color: #6E6E73;
  font-weight: 500;
}

.btn-text:active {
  filter: brightness(0.92);
}
