/* pages/assessment/writing/writing.wxss */
page {
  background-color: #FFF9F5;
}

.page {
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 180rpx;
}

/* Header */
.header {
  padding: 30rpx;
  border-bottom: 2rpx solid rgba(154, 151, 170, 0.2);
  box-sizing: border-box;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.progress-badge {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  background-color: #E8D4F8;
  color: #4A4A4A;
  border-radius: 30rpx;
}

.task-tabs {
  display: flex;
  gap: 16rpx;
}

.task-tab {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #4A4A4A;
  background-color: #F5F0FF;
  border-radius: 16rpx;
}

.task-tab.active {
  background-color: #A7FBF5;
}

/* 题目卡片 */
.task-card {
  margin: 30rpx;
  padding: 40rpx;
  background: #F5F0FF;
  border-radius: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
}

.task-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.task-prompt {
  font-size: 30rpx;
  color: #4A4A4A;
  line-height: 1.6;
}

.task-prompt-en {
  font-size: 26rpx;
  color: #7A8794;
  line-height: 1.6;
  font-style: italic;
}

.task-requirement {
  font-size: 24rpx;
  color: #9A97AA;
  line-height: 1.5;
}

/* 输入区 */
.slot-list {
  padding: 0 30rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.slot-item {
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(23, 33, 43, 0.06);
}

.slot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.slot-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.slot-hint {
  font-size: 22rpx;
  color: #9A97AA;
}

.slot-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #4A4A4A;
  line-height: 1.6;
  background: #F6F8FB;
  border-radius: 20rpx;
  padding: 20rpx;
  box-sizing: border-box;
}

/* 底部操作 */
.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 30rpx;
  border-top: 2rpx solid rgba(154, 151, 170, 0.2);
  background-color: #FFF9F5;
  box-sizing: border-box;
}

.btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background-color: #A7FBF5;
  color: #4A4A4A;
}

.btn-primary.disabled {
  background-color: #E0E0E0;
  color: #9A97AA;
}
