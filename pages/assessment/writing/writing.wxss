/* pages/assessment/writing/writing.wxss */
page {
  background-color: #F5F5F7;
}

.page {
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: 180rpx;
}

/* Header */
.header {
  padding: 32rpx;
  border-bottom: 1rpx solid #E5E5EA;
  box-sizing: border-box;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.01em;
}

.progress-badge {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  background-color: #E6F7F5;
  color: #0E8C81;
  border-radius: 999px;
  font-weight: 600;
}

.task-tabs {
  display: flex;
  gap: 16rpx;
}

.task-tab {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #6E6E73;
  background-color: #F2F2F7;
  border-radius: 999px;
}

.task-tab.active {
  background-color: #E6F7F5;
  color: #0E8C81;
  font-weight: 600;
}

/* 题目卡片 */
.task-card {
  margin: 32rpx;
  padding: 32rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  box-sizing: border-box;
}

.task-title {
  font-size: 34rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.01em;
  line-height: 1.4;
}

.task-prompt {
  font-size: 30rpx;
  color: #1D1D1F;
  line-height: 1.6;
}

.task-prompt-en {
  font-size: 26rpx;
  color: #6E6E73;
  line-height: 1.6;
  font-style: italic;
}

.task-requirement {
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.5;
}

/* 输入区 */
.slot-list {
  padding: 0 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.slot-item {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
}

.slot-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.slot-label {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.slot-hint {
  font-size: 22rpx;
  color: #8E8E93;
}

.slot-input {
  width: 100%;
  min-height: 120rpx;
  font-size: 28rpx;
  color: #1D1D1F;
  line-height: 1.6;
  background: #F5F5F7;
  border-radius: 16rpx;
  padding: 20rpx;
  box-sizing: border-box;
  border: 1rpx solid #E5E5EA;
}

/* 底部操作 */
.bottom-actions {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E5E5EA;
  background-color: #F5F5F7;
  box-sizing: border-box;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 999px;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: filter 0.18s ease;
}

.btn::after {
  border: none;
}

.btn-primary {
  background-color: #12B7A8;
  color: #FFFFFF;
}

.btn-primary:active {
  filter: brightness(0.92);
}

.btn-primary.disabled {
  opacity: 0.42;
  background-color: #12B7A8;
  color: #FFFFFF;
}

.btn-primary[disabled] {
  opacity: 0.42;
  background-color: #12B7A8;
  color: #FFFFFF;
}
