<!-- pages/assessment/writing/writing.wxml -->
<view class="container">
  <!-- Header -->
  <view class="header">
    <view class="header-top">
      <text class="title">写作测评</text>
      <view class="progress-badge">进度 4/4</view>
    </view>
    <view class="task-tabs">
      <view class="task-tab {{currentTask === 'task1' ? 'active' : ''}}" bindtap="switchTask" data-task="task1">Task 1</view>
      <view class="task-tab {{currentTask === 'task2' ? 'active' : ''}}" bindtap="switchTask" data-task="task2">Task 2</view>
    </view>
  </view>

  <!-- Main Content -->
  <scroll-view class="content-area" scroll-y>
    <!-- Task Description -->
    <view class="task-card">
      <text class="task-title">{{currentTaskData.title}}</text>
      <text class="task-desc">{{currentTaskData.description}}</text>
      <text class="word-count-hint">建议字数：{{currentTaskData.wordCount}}</text>
    </view>

    <!-- Step Tabs -->
    <view class="step-tabs">
      <view class="step-tab {{currentStep === 'outline' ? 'active' : ''}}" bindtap="switchStep" data-step="outline">Step 1 - 行文思路</view>
      <view class="step-tab {{currentStep === 'content' ? 'active' : ''}}" bindtap="switchStep" data-step="content">Step 2 - 主体段落</view>
    </view>

    <!-- Input Area -->
    <view class="input-section">
      <block wx:if="{{currentStep === 'outline'}}">
        <text class="input-hint">请先写下你的写作思路（20-50 字）</text>
        <textarea 
          class="input-textarea"
          placeholder="例如：开头段介绍图表主题，主体段描述主要数据变化，结尾段总结趋势..."
          value="{{outline}}"
          bindinput="onOutlineInput"
          maxlength="200"
        />
        <text class="char-count">{{outline.length}} 字</text>
      </block>
      <block wx:else>
        <text class="input-hint">写一段主体段落（80-150 字）</text>
        <textarea 
          class="input-textarea"
          placeholder="开始写作..."
          value="{{content}}"
          bindinput="onContentInput"
          maxlength="500"
        />
        <text class="char-count">{{content.length}} 字</text>
      </block>
    </view>
  </scroll-view>

  <!-- Bottom Actions -->
  <view class="bottom-actions">
    <button class="btn btn-primary" bindtap="handleNext">
      {{currentStep === 'outline' ? '下一步' : currentTask === 'task1' ? '进入 Task 2' : '提交写作答案'}}
    </button>
  </view>
</view>
