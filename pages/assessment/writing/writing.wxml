<!-- pages/assessment/writing/writing.wxml -->
<view class="page">

  <!-- 第一阶段：写作自评 -->
  <block wx:if="{{phase === 'selfcheck'}}">
    <self-assess
      title="写作能力自评"
      subtitle="以下 12 条描述，按你的实际情况打分：0 = 完全不符合，5 = 完全符合"
      items="{{selfCheckItems}}"
      bind:finish="onSelfCheckFinish"/>
  </block>

  <!-- 第二阶段：产出题 -->
  <block wx:else>
    <view class="container">
      <!-- Header -->
      <view class="header">
        <view class="header-top">
          <text class="title">写作测试</text>
          <view class="progress-badge">第 {{currentTaskIndex + 1}} / 2 题</view>
        </view>
        <view class="task-tabs">
          <view class="task-tab {{currentTaskIndex === 0 ? 'active' : ''}}">句式改写</view>
          <view class="task-tab {{currentTaskIndex === 1 ? 'active' : ''}}">观点论证</view>
        </view>
      </view>

      <!-- 题目内容 -->
      <view class="task-card">
        <text class="task-title">{{currentTask.title}}</text>
        <text class="task-prompt">{{currentTask.prompt}}</text>
        <text class="task-prompt-en" wx:if="{{currentTask.promptEn}}">{{currentTask.promptEn}}</text>
        <text class="task-requirement">{{currentTask.requirement}}</text>
      </view>

      <!-- 各 slot 输入 -->
      <view class="slot-list">
        <view class="slot-item" wx:for="{{currentTask.slots}}" wx:key="key">
          <view class="slot-header">
            <text class="slot-label">{{item.label}}</text>
            <text class="slot-hint">{{item.hint}}</text>
          </view>
          <textarea
            class="slot-input"
            placeholder="请输入内容（中/英文均可）"
            value="{{taskInputs[currentTaskIndex][item.key] || ''}}"
            bindinput="onSlotInput"
            data-slot="{{item.key}}"
            auto-height
            maxlength="500"/>
        </view>
      </view>

      <!-- 底部操作 -->
      <view class="bottom-actions">
        <button class="btn btn-primary" bindtap="handleSubmit" disabled="{{submitting}}">
          {{currentTaskIndex === 0 ? '下一题' : mode === 'full' ? '完成测评，查看结果' : '完成测评'}}
        </button>
      </view>
    </view>
  </block>
</view>
