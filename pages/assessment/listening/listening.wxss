/* pages/assessment/listening/listening.wxss */
page {
  background-color: #FFF9F5;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* Header */
.header {
  padding: 30rpx;
  border-bottom: 2rpx solid rgba(154, 151, 170, 0.2);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.progress-badge {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  background-color: #E8D4F8;
  color: #4A4A4A;
  border-radius: 30rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #9A97AA;
}

/* Audio Player */
.audio-player {
  padding: 30rpx;
  background-color: #F5F0FF;
  border-bottom: 2rpx solid rgba(154, 151, 170, 0.2);
}

.player-controls {
  display: flex;
  align-items: center;
  gap: 24rpx;
}

.play-btn {
  width: 96rpx;
  height: 96rpx;
  background-color: #A7FBF5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.play-btn.disabled {
  background-color: #D4D0E8;
  opacity: 0.5;
}

.play-icon {
  width: 48rpx;
  height: 48rpx;
}

.progress-area {
  flex: 1;
}

.progress-bar {
  height: 16rpx;
  background-color: #FFF9F5;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #A7FBF5;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

.status-text {
  font-size: 24rpx;
  color: #9A97AA;
  margin-top: 12rpx;
  display: block;
}

/* Questions */
.questions-area {
  flex: 1;
  padding: 30rpx;
  overflow-y: auto;
}

.question-item {
  padding: 30rpx;
  background-color: #F5F0FF;
  border-radius: 24rpx;
  margin-bottom: 24rpx;
}

.question-text {
  font-size: 28rpx;
  color: #4A4A4A;
  display: block;
  margin-bottom: 20rpx;
}

.answer-input {
  width: 100%;
  height: 88rpx;
  background-color: #FFF9F5;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #4A4A4A;
  box-sizing: border-box;
}

/* Bottom Actions */
.bottom-actions {
  padding: 30rpx;
  border-top: 2rpx solid rgba(154, 151, 170, 0.2);
  display: flex;
  gap: 24rpx;
  background-color: #FFF9F5;
}

.btn {
  flex: 1;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background-color: #A7FBF5;
  color: #4A4A4A;
}

.btn-secondary {
  background-color: #F5F0FF;
  color: #4A4A4A;
}
