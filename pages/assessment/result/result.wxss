/* pages/assessment/result/result.wxss */

.page {
  background: #F5F5F7;
  min-height: 100vh;
  padding: 0 32rpx 200rpx;
}

.container {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 标题区域 */
.header {
  padding: 48rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #1D1D1F;
  display: block;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.subtitle {
  font-size: 28rpx;
  color: #6E6E73;
  display: block;
  line-height: 1.5;
}

/* 词汇量卡片 */
.score-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 32rpx;
}

.total-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.vocab-row {
  display: flex;
  align-items: baseline;
  gap: 12rpx;
}

.score-value {
  font-size: 96rpx;
  font-weight: 700;
  color: #1D1D1F;
  line-height: 1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}

.score-label {
  font-size: 28rpx;
  color: #6E6E73;
}

.vocab-unit {
  font-size: 28rpx;
  color: #8E8E93;
}

.score-divider {
  width: 1rpx;
  height: 64rpx;
  background: #E5E5EA;
}

/* CEFR 等级卡片 */
.cefr-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.cefr-label {
  font-size: 24rpx;
  color: #6E6E73;
}

.cefr-level {
  font-size: 64rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.02em;
  line-height: 1.1;
}

.cefr-desc {
  font-size: 24rpx;
  color: #6E6E73;
  text-align: center;
  line-height: 1.5;
}

.cefr-badge {
  font-size: 24rpx;
  font-weight: 600;
  color: #0E8C81;
  background: #E6F7F5;
  padding: 8rpx 28rpx;
  border-radius: 999px;
}

.confidence-tip {
  font-size: 22rpx;
  color: #FF3B30;
  text-align: center;
  line-height: 1.5;
}

/* 能力分析卡片 */
.analysis-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
  letter-spacing: -0.01em;
}

.analysis-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.analysis-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.analysis-skill {
  font-size: 26rpx;
  color: #1D1D1F;
  font-weight: 600;
}

.analysis-score {
  font-size: 26rpx;
  color: #6E6E73;
  font-weight: 600;
  font-variant-numeric: tabular-nums;
}

.analysis-bar {
  width: 100%;
  height: 8rpx;
  background: #E5E5EA;
  border-radius: 999px;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #12B7A8;
  border-radius: 999px;
  transition: width 0.5s ease;
}

.analysis-comment {
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.5;
}

/* 操作按钮 */
.button-group {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 16rpx;
}

.action-btn {
  width: 100%;
  height: 88rpx;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  transition: filter 0.18s ease;
}

.action-btn.primary {
  background: #12B7A8;
  color: #FFFFFF;
}

.action-btn.primary:active {
  filter: brightness(0.92);
}

.action-btn.secondary {
  background: #F2F2F7;
  color: #12B7A8;
}

.action-btn.secondary:active {
  background-color: #E5E5EA;
}

.action-btn::after {
  border: none;
}

/* 空状态 */
.empty-tip {
  padding: 200rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 40rpx;
  font-size: 28rpx;
  color: #8E8E93;
  text-align: center;
  line-height: 1.5;
}
