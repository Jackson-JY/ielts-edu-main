/* pages/assessment/result/result.wxss */

.page {
  background: #FFF9F5;
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
}

.container {
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 标题区域 */
.header {
  padding: 48rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #9A97AA;
  display: block;
}

/* 总分卡片 */
.score-card {
  background: #F5F0FF;
  border-radius: 44rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 48rpx;
}

.total-score {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.score-value {
  font-size: 96rpx;
  font-weight: 700;
  color: #E8D4F8;
  line-height: 1;
}

.score-label {
  font-size: 28rpx;
  color: #9A97AA;
}

.score-details {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 32rpx;
  width: 100%;
}

.score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.skill-name {
  font-size: 24rpx;
  color: #9A97AA;
}

.skill-score {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.score-divider {
  width: 1rpx;
  height: 64rpx;
  background: rgba(154, 151, 170, 0.3);
}

/* CEFR 等级卡片 */
.cefr-card {
  background: #E8D4F8;
  border-radius: 44rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16rpx;
}

.cefr-label {
  font-size: 24rpx;
  color: #9A97AA;
}

.cefr-level {
  font-size: 64rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.cefr-desc {
  font-size: 24rpx;
  color: #4A4A4A;
  text-align: center;
}

/* 能力分析卡片 */
.analysis-card {
  background: #F5F0FF;
  border-radius: 44rpx;
  padding: 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
}

.analysis-item {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.analysis-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.skill-info {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.skill-icon {
  width: 40rpx;
  height: 40rpx;
}

.analysis-skill {
  font-size: 24rpx;
  color: #4A4A4A;
  font-weight: 600;
}

.analysis-score {
  font-size: 24rpx;
  color: #9A97AA;
}

.analysis-bar {
  width: 100%;
  height: 16rpx;
  background: #FFF9F5;
  border-radius: 8rpx;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  background: #E8D4F8;
  border-radius: 8rpx;
  transition: width 0.5s ease;
}

.analysis-comment {
  font-size: 22rpx;
  color: #9A97AA;
  line-height: 1.5;
}

/* 操作按钮 */
.button-group {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  padding-top: 16rpx;
}

.action-btn {
  width: 100%;
  padding: 32rpx 0;
  border-radius: 60rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
}

.action-btn.primary {
  background: #A7FBF5;
  color: #4A4A4A;
}

.action-btn.secondary {
  background: #F5F0FF;
  color: #4A4A4A;
}

.action-btn::after {
  border: none;
}
