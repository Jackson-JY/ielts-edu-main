/* pages/assessment/speaking/speaking.wxss */
page {
  background-color: #FFF9F5;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* Header */
.header {
  padding: 30rpx;
  border-bottom: 2rpx solid rgba(154, 151, 170, 0.2);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.progress-badge {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  background-color: #E8D4F8;
  color: #4A4A4A;
  border-radius: 30rpx;
}

.part-tabs {
  display: flex;
  gap: 16rpx;
  box-sizing: border-box;
}

.part-tab {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #4A4A4A;
  background-color: #F5F0FF;
  border-radius: 16rpx;
}

.part-tab.active {
  background-color: #A7FBF5;
}

/* Content Area */
.content-area {
  flex: 1;
  padding: 30rpx;
}

.question-info {
  text-align: center;
  margin-bottom: 30rpx;
}

.question-count {
  font-size: 26rpx;
  color: #9A97AA;
}

/* Topic Card (Part 2) */
.topic-card {
  padding: 40rpx;
  background-color: #FFE8CC;
  border-radius: 32rpx;
  margin-bottom: 40rpx;
}

.topic-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
  margin-bottom: 24rpx;
}

.topic-points {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.point-item {
  font-size: 28rpx;
  color: #4A4A4A;
}

/* Question Card (Part 1 & 3) */
.question-card {
  padding: 40rpx;
  background-color: #F5F0FF;
  border-radius: 32rpx;
  text-align: center;
  margin-bottom: 40rpx;
}

.question-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
  margin-bottom: 20rpx;
}

.time-hint {
  font-size: 24rpx;
  color: #9A97AA;
}

/* Recording Area */
.recording-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.mic-btn {
  width: 180rpx;
  height: 180rpx;
  background-color: #A7FBF5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
}

.mic-btn.recording {
  background-color: #FFE8CC;
  animation: pulse 1.5s infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.mic-icon {
  width: 80rpx;
  height: 80rpx;
}

.recording-info {
  text-align: center;
}

.recording-time {
  font-size: 48rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
  margin-bottom: 12rpx;
}

.recording-status {
  font-size: 26rpx;
  color: #9A97AA;
}

/* Bottom Actions */
.bottom-actions {
  padding: 30rpx;
  border-top: 2rpx solid rgba(154, 151, 170, 0.2);
  background-color: #FFF9F5;
}

.btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background-color: #A7FBF5;
  color: #4A4A4A;
}
