/* pages/assessment/speaking/speaking.wxss */
page {
  background-color: #FFF9F5;
}

.page {
  min-height: 100vh;
}

/* 图片描述卡片 */
.picture-card {
  padding: 40rpx;
  background-color: #FFE8CC;
  border-radius: 32rpx;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
}

.picture-img {
  width: 100%;
  border-radius: 24rpx;
}

.question-opinion {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
  margin-bottom: 20rpx;
  word-wrap: break-word;
}

.question-req {
  font-size: 28rpx;
  color: #4A4A4A;
  display: block;
  margin-bottom: 16rpx;
}

.hint-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
  margin-top: 8rpx;
}

.hint-tag {
  font-size: 22rpx;
  color: #4A4A4A;
  background: rgba(255, 255, 255, 0.7);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

.prepare-skip {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #12B7A8;
  text-decoration: underline;
}

/* 录音键文字 */
.mic-text {
  font-size: 32rpx;
  font-weight: 700;
  color: #0E8C80;
}

.mic-btn.completed .mic-text {
  color: #FFFFFF;
}

.recording-dot {
  width: 56rpx;
  height: 56rpx;
  background-color: #E85D5D;
  border-radius: 50%;
  animation: pulse 1.2s infinite;
}


.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* Header */
.header {
  padding: 30rpx;
  border-bottom: 2rpx solid rgba(154, 151, 170, 0.2);
  box-sizing: border-box;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.progress-badge {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  background-color: #E8D4F8;
  color: #4A4A4A;
  border-radius: 30rpx;
}

.part-tabs {
  display: flex;
  gap: 16rpx;
  box-sizing: border-box;
}

.part-tab {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #4A4A4A;
  background-color: #F5F0FF;
  border-radius: 16rpx;
}

.part-tab.active {
  background-color: #A7FBF5;
}

/* Content Area */
.content-area {
  flex: 1;
  padding: 30rpx;
  box-sizing: border-box;
}

.question-info {
  text-align: center;
  margin-bottom: 30rpx;
}

.question-count {
  font-size: 26rpx;
  color: #9A97AA;
}

/* Prepare Card (Part 2) */
.prepare-card {
  padding: 40rpx;
  background: linear-gradient(135deg, #FFE8CC 0%, #FFD4A3 100%);
  border-radius: 32rpx;
  margin-bottom: 40rpx;
  text-align: center;
  box-sizing: border-box;
}

.prepare-title {
  font-size: 28rpx;
  color: #4A4A4A;
  display: block;
  margin-bottom: 20rpx;
}

.prepare-time {
  font-size: 72rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
  margin-bottom: 20rpx;
}

.prepare-hint {
  font-size: 24rpx;
  color: #9A97AA;
}

/* Topic Card (Part 2) */
.topic-card {
  padding: 40rpx;
  background-color: #FFE8CC;
  border-radius: 32rpx;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

.topic-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
  margin-bottom: 24rpx;
  word-wrap: break-word;
}

.topic-points {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.point-item {
  font-size: 28rpx;
  color: #4A4A4A;
  word-wrap: break-word;
}

/* Question Card (Part 1 & 3) */
.question-card {
  padding: 40rpx;
  background-color: #F5F0FF;
  border-radius: 32rpx;
  text-align: center;
  margin-bottom: 40rpx;
  box-sizing: border-box;
}

.question-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
  margin-bottom: 20rpx;
  word-wrap: break-word;
}

.time-hint {
  font-size: 24rpx;
  color: #9A97AA;
}

/* Recording Area */
.recording-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 0;
}

.mic-btn {
  width: 180rpx;
  height: 180rpx;
  background-color: #A7FBF5;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  transition: all 0.3s ease;
}

.mic-btn.recording {
  background-color: #FFE8CC;
  animation: pulse 1.5s infinite;
}

.mic-btn.processing {
  background-color: #E8D4F8;
  animation: none;
}

.mic-btn.completed {
  background-color: #52C41A;
  opacity: 0.8;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
  }
  50% {
    transform: scale(1.05);
  }
}

.mic-icon {
  width: 80rpx;
  height: 80rpx;
}

/* Processing Indicator */
.processing-indicator {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.processing-dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #4A4A4A;
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out both;
}

.processing-dot:nth-child(1) {
  animation-delay: -0.32s;
}

.processing-dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

.recording-info {
  text-align: center;
}

.recording-time {
  font-size: 48rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
  margin-bottom: 12rpx;
}

.recording-status {
  font-size: 26rpx;
  color: #9A97AA;
}

/* Progress Card */
.progress-card {
  padding: 30rpx;
  background-color: #F5F0FF;
  border-radius: 24rpx;
  margin-bottom: 30rpx;
  box-sizing: border-box;
}

.progress-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
  margin-bottom: 20rpx;
}

.progress-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-item {
  font-size: 24rpx;
  color: #4A4A4A;
  padding: 8rpx 16rpx;
  background-color: #FFFFFF;
  border-radius: 16rpx;
}

/* Bottom Actions */
.bottom-actions {
  padding: 30rpx;
  border-top: 2rpx solid rgba(154, 151, 170, 0.2);
  background-color: #FFF9F5;
  box-sizing: border-box;
}

.btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 30rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
}

.btn::after {
  border: none;
}

.btn-primary {
  background-color: #A7FBF5;
  color: #4A4A4A;
}

.btn-primary.disabled {
  background-color: #E0E0E0;
  color: #9A97AA;
}

/* Wave Animation for Recording */
.wave-container {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  height: 60rpx;
}

.wave-bar {
  width: 6rpx;
  background-color: #4A4A4A;
  border-radius: 3rpx;
  animation: wave 1s ease-in-out infinite;
}

.wave-bar:nth-child(1) { animation-delay: 0s; height: 20rpx; }
.wave-bar:nth-child(2) { animation-delay: 0.1s; height: 40rpx; }
.wave-bar:nth-child(3) { animation-delay: 0.2s; height: 60rpx; }
.wave-bar:nth-child(4) { animation-delay: 0.3s; height: 40rpx; }
.wave-bar:nth-child(5) { animation-delay: 0.4s; height: 20rpx; }

@keyframes wave {
  0%, 100% {
    transform: scaleY(0.5);
  }
  50% {
    transform: scaleY(1);
  }
}

/* ============ 跟读评测 ============ */
.shadowing-card {
  padding: 40rpx;
  background-color: #FFF0E5;
  border-radius: 32rpx;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
}

.shadowing-hint {
  font-size: 26rpx;
  color: #8C5A2B;
}

.shadowing-sentence {
  width: 100%;
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  font-size: 34rpx;
  line-height: 1.8;
  color: #333;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.06);
}

/* SOE 评分结果卡片 */
.soe-result-card {
  padding: 32rpx;
  background-color: #F0F9FF;
  border-radius: 24rpx;
  margin-bottom: 40rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.soe-result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1890FF;
}

.soe-scores {
  display: flex;
  justify-content: space-around;
  width: 100%;
}

.soe-score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.soe-score-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #1890FF;
}

.soe-score-label {
  font-size: 24rpx;
  color: #666;
}

.soe-skip-hint {
  padding: 24rpx;
  background-color: #FFF7E6;
  border-radius: 16rpx;
  margin-bottom: 40rpx;
  font-size: 26rpx;
  color: #D48806;
  text-align: center;
}
