/* pages/assessment/speaking/speaking.wxss */
page {
  background-color: #F5F5F7;
}

.page {
  min-height: 100vh;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  box-sizing: border-box;
}

/* Header */
.header {
  padding: 32rpx;
  border-bottom: 1rpx solid #E5E5EA;
  box-sizing: border-box;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.01em;
}

.progress-badge {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  background-color: #E6F7F5;
  color: #0E8C81;
  border-radius: 999px;
  font-weight: 600;
}

.part-tabs {
  display: flex;
  gap: 16rpx;
  box-sizing: border-box;
}

.part-tab {
  flex: 1;
  padding: 16rpx 0;
  text-align: center;
  font-size: 28rpx;
  color: #6E6E73;
  background-color: #F2F2F7;
  border-radius: 999px;
}

.part-tab.active {
  background-color: #E6F7F5;
  color: #0E8C81;
  font-weight: 600;
}

/* Content Area */
.content-area {
  flex: 1;
  padding: 32rpx;
  box-sizing: border-box;
}

/* 图片描述卡片 */
.picture-card {
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  box-sizing: border-box;
}

.picture-img {
  width: 100%;
  border-radius: 16rpx;
}

.question-opinion {
  font-size: 36rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
  margin-bottom: 20rpx;
  word-wrap: break-word;
  line-height: 1.5;
  letter-spacing: -0.01em;
}

.question-req {
  font-size: 28rpx;
  color: #1D1D1F;
  display: block;
  margin-bottom: 16rpx;
  line-height: 1.6;
}

.hint-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  justify-content: center;
  margin-top: 8rpx;
}

.hint-tag {
  font-size: 22rpx;
  color: #6E6E73;
  background: #F2F2F7;
  padding: 8rpx 20rpx;
  border-radius: 999px;
}

.prepare-skip {
  margin-top: 20rpx;
  font-size: 26rpx;
  color: #12B7A8;
  font-weight: 500;
}

/* Prepare Card (Part 2) */
.prepare-card {
  padding: 40rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  margin-bottom: 32rpx;
  text-align: center;
  box-sizing: border-box;
}

.prepare-title {
  font-size: 28rpx;
  color: #6E6E73;
  display: block;
  margin-bottom: 20rpx;
}

.prepare-time {
  font-size: 72rpx;
  font-weight: 700;
  color: #1D1D1F;
  display: block;
  margin-bottom: 20rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}

.prepare-hint {
  font-size: 24rpx;
  color: #8E8E93;
}

/* Topic Card (Part 2) */
.topic-card {
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.topic-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
  margin-bottom: 24rpx;
  word-wrap: break-word;
  letter-spacing: -0.01em;
}

.topic-points {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.point-item {
  font-size: 28rpx;
  color: #1D1D1F;
  word-wrap: break-word;
  line-height: 1.6;
}

/* Question Card (Part 1 & 3) */
.question-card {
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  text-align: center;
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.question-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
  margin-bottom: 20rpx;
  word-wrap: break-word;
  line-height: 1.5;
  letter-spacing: -0.01em;
}

.time-hint {
  font-size: 24rpx;
  color: #8E8E93;
}

/* Recording Area */
.recording-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 56rpx 0;
}

.mic-btn {
  width: 180rpx;
  height: 180rpx;
  background-color: #12B7A8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 30rpx;
  transition: filter 0.18s ease;
}

.mic-btn:active {
  filter: brightness(0.92);
}

.mic-btn.recording {
  background-color: #12B7A8;
}

.mic-btn.processing {
  background-color: #F2F2F7;
}

.mic-btn.completed {
  background-color: #12B7A8;
}

/* 录音中红点动画（保留） */
.recording-dot {
  width: 56rpx;
  height: 56rpx;
  background-color: #FF3B30;
  border-radius: 50%;
  animation: pulse 1.2s infinite;
}

@keyframes pulse {
  0%, 100% {
    transform: scale(1);
    opacity: 1;
  }
  50% {
    transform: scale(1.08);
    opacity: 0.85;
  }
}

/* Processing Indicator */
.processing-indicator {
  display: flex;
  gap: 12rpx;
  align-items: center;
}

.processing-dot {
  width: 16rpx;
  height: 16rpx;
  background-color: #8E8E93;
  border-radius: 50%;
  animation: bounce 1.4s infinite ease-in-out both;
}

.processing-dot:nth-child(1) {
  animation-delay: -0.32s;
}

.processing-dot:nth-child(2) {
  animation-delay: -0.16s;
}

@keyframes bounce {
  0%, 80%, 100% {
    transform: scale(0);
  }
  40% {
    transform: scale(1);
  }
}

.recording-info {
  text-align: center;
}

.recording-time {
  font-size: 48rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
  margin-bottom: 12rpx;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

.recording-status {
  font-size: 26rpx;
  color: #8E8E93;
}

/* Progress Card */
.progress-card {
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  margin-bottom: 32rpx;
  box-sizing: border-box;
}

.progress-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
  margin-bottom: 20rpx;
}

.progress-stats {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.stat-item {
  font-size: 24rpx;
  color: #6E6E73;
  padding: 8rpx 16rpx;
  background-color: #F2F2F7;
  border-radius: 999px;
}

/* Bottom Actions */
.bottom-actions {
  padding: 32rpx;
  padding-bottom: calc(32rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid #E5E5EA;
  background-color: #F5F5F7;
  box-sizing: border-box;
}

.btn {
  width: 100%;
  height: 88rpx;
  border-radius: 999px;
  font-size: 30rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  transition: filter 0.18s ease;
}

.btn::after {
  border: none;
}

.btn-primary {
  background-color: #12B7A8;
  color: #FFFFFF;
}

.btn-primary:active {
  filter: brightness(0.92);
}

.btn-primary.disabled {
  opacity: 0.42;
  background-color: #12B7A8;
  color: #FFFFFF;
}

/* ============ 跟读评测 ============ */
.shadowing-card {
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
  box-sizing: border-box;
}

.shadowing-hint {
  font-size: 26rpx;
  color: #6E6E73;
}

.shadowing-sentence {
  width: 100%;
  padding: 32rpx;
  background-color: #F5F5F7;
  border-radius: 16rpx;
  font-size: 34rpx;
  line-height: 1.8;
  color: #1D1D1F;
  text-align: center;
  box-sizing: border-box;
}

/* SOE 评分结果卡片 */
.soe-result-card {
  padding: 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  margin-bottom: 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 24rpx;
}

.soe-result-title {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.soe-scores {
  display: flex;
  justify-content: space-around;
  width: 100%;
}

.soe-score-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}

.soe-score-value {
  font-size: 48rpx;
  font-weight: 700;
  color: #12B7A8;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.01em;
}

.soe-score-label {
  font-size: 24rpx;
  color: #8E8E93;
}

.soe-skip-hint {
  padding: 24rpx;
  background-color: #F2F2F7;
  border-radius: 16rpx;
  margin-bottom: 32rpx;
  font-size: 26rpx;
  color: #6E6E73;
  text-align: center;
  line-height: 1.5;
}
