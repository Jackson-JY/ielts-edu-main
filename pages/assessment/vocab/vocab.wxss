/* pages/assessment/vocab/vocab.wxss */
page {
  background-color: #F5F5F7;
}

.container {
  display: flex;
  flex-direction: column;
  min-height: 100vh;
}

/* ==================== 加载/错误 ==================== */
.phase-loading,
.phase-error {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60rpx;
  gap: 24rpx;
}

.loading-spinner {
  width: 64rpx;
  height: 64rpx;
  border: 5rpx solid #E5E5EA;
  border-top-color: #12B7A8;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  margin-bottom: 12rpx;
}

@keyframes spin {
  to { transform: rotate(360deg); }
}

.loading-text {
  font-size: 28rpx;
  color: #8E8E93;
}

.error-text {
  font-size: 28rpx;
  color: #6E6E73;
  margin-bottom: 24rpx;
  text-align: center;
  line-height: 1.5;
}

.btn-primary {
  background-color: #12B7A8;
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 999px;
  height: 88rpx;
  padding: 0 60rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: filter 0.18s ease;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  filter: brightness(0.92);
}

/* ==================== Header ==================== */
.header {
  padding: 32rpx;
  border-bottom: 1rpx solid #E5E5EA;
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.01em;
}

.timer-badge {
  font-size: 26rpx;
  font-weight: 600;
  padding: 8rpx 24rpx;
  background-color: #E6F7F5;
  color: #0E8C81;
  border-radius: 999px;
  font-variant-numeric: tabular-nums;
}

.timer-badge.timer-warn {
  background-color: rgba(255, 59, 48, 0.12);
  color: #FF3B30;
}

.subtitle {
  font-size: 26rpx;
  color: #6E6E73;
}

/* ==================== Progress ==================== */
.progress-section {
  padding: 24rpx 32rpx 0;
}

.progress-bar {
  height: 8rpx;
  background-color: #E5E5EA;
  border-radius: 999px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #12B7A8;
  border-radius: 999px;
  transition: width 0.3s ease;
}

/* ==================== 答题区 ==================== */
.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 40rpx 32rpx;
}

.word-display {
  text-align: center;
  margin-bottom: 56rpx;
}

.word-text {
  font-size: 72rpx;
  font-weight: 700;
  color: #1D1D1F;
  display: block;
  margin-bottom: 20rpx;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.word-hint {
  font-size: 26rpx;
  color: #6E6E73;
}

/* Options */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 28rpx 32rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  transition: background-color 0.2s ease, border-color 0.2s ease;
}

.option-item:active {
  background: #F2F2F7;
}

.option-item.option-correct {
  background-color: #E6F7F5;
  border-color: #12B7A8;
}

.option-item.option-wrong {
  background-color: rgba(255, 59, 48, 0.10);
  border-color: #FF3B30;
}

.option-badge {
  width: 56rpx;
  height: 56rpx;
  background-color: #F2F2F7;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #6E6E73;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.option-text {
  flex: 1;
  font-size: 32rpx;
  color: #1D1D1F;
}

.option-mark {
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* ==================== 结果页 ==================== */
.result-scroll {
  flex: 1;
  height: 100vh;
}

.result-container {
  padding: 32rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
}

.result-hero {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
}

.result-label {
  font-size: 26rpx;
  color: #6E6E73;
  margin-bottom: 12rpx;
}

.result-num-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.result-vocab {
  font-size: 96rpx;
  font-weight: 700;
  color: #1D1D1F;
  line-height: 1.1;
  font-variant-numeric: tabular-nums;
  letter-spacing: -0.02em;
}

.result-unit {
  font-size: 28rpx;
  color: #8E8E93;
  margin: 0 0 24rpx;
}

.cefr-badge {
  font-size: 30rpx;
  font-weight: 700;
  color: #FFFFFF;
  background-color: #12B7A8;
  padding: 8rpx 40rpx;
  border-radius: 999px;
  margin-bottom: 16rpx;
  letter-spacing: -0.01em;
}

.cefr-desc {
  font-size: 26rpx;
  color: #6E6E73;
  text-align: center;
}

/* 统计 */
.result-stats {
  display: flex;
  gap: 24rpx;
  margin-bottom: 24rpx;
}

.stat-item {
  flex: 1;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
}

.stat-num {
  font-size: 40rpx;
  font-weight: 700;
  color: #1D1D1F;
  margin-bottom: 8rpx;
  letter-spacing: -0.01em;
}

.stat-label {
  font-size: 24rpx;
  color: #8E8E93;
}

.low-confidence-tip {
  font-size: 24rpx;
  color: #FF3B30;
  background-color: rgba(255, 59, 48, 0.08);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  margin-bottom: 24rpx;
  text-align: center;
  line-height: 1.5;
}

/* 分频段 */
.breakdown-card {
  background-color: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 36rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
}

.breakdown-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 24rpx;
  display: block;
  letter-spacing: -0.01em;
}

.breakdown-row {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.breakdown-row:last-child {
  margin-bottom: 0;
}

.band-desc {
  width: 220rpx;
  font-size: 24rpx;
  color: #6E6E73;
  flex-shrink: 0;
}

.band-bar {
  flex: 1;
  height: 8rpx;
  background-color: #E5E5EA;
  border-radius: 999px;
  overflow: hidden;
  margin: 0 20rpx;
}

.band-fill {
  height: 100%;
  background: #12B7A8;
  border-radius: 999px;
  transition: width 0.5s ease;
}

.band-rate {
  width: 90rpx;
  font-size: 24rpx;
  color: #1D1D1F;
  text-align: right;
  font-variant-numeric: tabular-nums;
  flex-shrink: 0;
}

/* 操作按钮 */
.result-actions {
  display: flex;
  flex-direction: column;
}

.result-actions .btn-primary {
  width: 100%;
  height: 88rpx;
  padding: 0;
}
