/* pages/assessment/reading/reading.wxss */
page {
  background-color: #FFF9F5;
}

.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
}

/* Header */
.header {
  padding: 30rpx;
  border-bottom: 2rpx solid rgba(154, 151, 170, 0.2);
}

.header-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.title {
  font-size: 36rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.progress-badge {
  font-size: 24rpx;
  padding: 8rpx 24rpx;
  background-color: #E8D4F8;
  color: #4A4A4A;
  border-radius: 30rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #9A97AA;
}

/* Progress Section */
.progress-section {
  padding: 30rpx;
}

.progress-bar {
  height: 16rpx;
  background-color: #F5F0FF;
  border-radius: 8rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background-color: #A7FBF5;
  border-radius: 8rpx;
  transition: width 0.3s ease;
}

/* Content Area */
.content-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 30rpx;
}

.word-display {
  text-align: center;
  margin-bottom: 80rpx;
}

.word-text {
  font-size: 72rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
  margin-bottom: 20rpx;
}

.word-hint {
  font-size: 26rpx;
  color: #9A97AA;
}

/* Options List */
.options-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.option-item {
  display: flex;
  align-items: center;
  padding: 32rpx;
  background-color: #F5F0FF;
  border-radius: 24rpx;
  transition: transform 0.2s ease;
}

.option-item:active {
  transform: scale(0.98);
}

.option-badge {
  width: 56rpx;
  height: 56rpx;
  background-color: #E8D4F8;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 26rpx;
  font-weight: 600;
  color: #4A4A4A;
  margin-right: 24rpx;
}

.option-text {
  flex: 1;
  font-size: 32rpx;
  color: #4A4A4A;
}
