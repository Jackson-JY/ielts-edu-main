/* pages/login/login.wxss */

/* ===== 页面容器 ===== */
.page {
  min-height: 100vh;
  background: #F5F5F7;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  box-sizing: border-box;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 96rpx;
  animation: page-enter 250ms ease-out;
}

.logo-mark {
  width: 128rpx;
  height: 128rpx;
  border-radius: 32rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  overflow: hidden;
}

.logo-img {
  width: 100%;
  height: 100%;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 12rpx;
  letter-spacing: -0.02em;
}

.subtitle {
  font-size: 28rpx;
  color: #6E6E73;
}

/* 协议 */
.agreement {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
  padding: 0 20rpx;
}

/* 勾选框（默认不勾选） */
.agree-check {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #D1D1D6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  background: #FFFFFF;
}

.agree-check.checked {
  background: #12B7A8;
  border-color: #12B7A8;
}

.agreement-text-wrap {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 2rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: #6E6E73;
  line-height: 1.5;
}

.link {
  font-size: 24rpx;
  color: #12B7A8;
  line-height: 1.5;
}

/* ===== 按钮组（含未勾选协议时的拦截遮罩） ===== */
.button-group-wrap {
  position: relative;
  width: 100%;
}

.button-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  margin-bottom: 48rpx;
}

/* 拦截遮罩：未勾选协议时覆盖按钮，阻止授权弹窗提前触发 */
.btn-group-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  background: transparent;
}

/* 登录说明 */
.login-note {
  font-size: 22rpx;
  color: #8E8E93;
  text-align: center;
}

/* ==================== */
/* 公共按钮样式          */
/* ==================== */

.btn {
  width: 100% !important;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 999px;
  font-size: 30rpx;
  font-weight: 600;
  border: none !important;
  padding: 0 !important;
  margin: 0;
  letter-spacing: 0;
}

.btn::after {
  border: none !important;
}

/* 主按钮 - 薄荷青，无渐变无投影 */
.btn-primary {
  background: #12B7A8;
  color: #FFFFFF;
}

.btn-press {
  filter: brightness(0.92);
}

.btn-phone-text {
  font-weight: 600;
}

/* 次按钮 - 浅灰背景 */
.btn-secondary {
  background: #F2F2F7;
  color: #1D1D1F;
}

/* ===== 登录中 Loading 状态 ===== */

/* 覆盖微信 button disabled 默认置灰，保留品牌背景，仅降低不透明度 */
.btn[disabled] {
  opacity: 0.7;
}

.btn-primary[disabled] {
  background: #12B7A8;
  color: #FFFFFF;
}

.btn-secondary[disabled] {
  background: #F2F2F7;
  color: #1D1D1F;
}

/* 登录中：spinner + 文案，替代 button 原生 loading，避免重复展示 */
.btn-loading {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.spinner {
  width: 28rpx;
  height: 28rpx;
  margin-right: 12rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #FFFFFF;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  flex-shrink: 0;
}

.btn-secondary .spinner {
  border-color: rgba(29, 29, 31, 0.2);
  border-top-color: #1D1D1F;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}

/* 入场动画 */
@keyframes page-enter {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
