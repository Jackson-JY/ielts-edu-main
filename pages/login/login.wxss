/* pages/login/login.wxss */

/* ===== 页面容器 ===== */
.page {
  min-height: 100vh;
  background: #FFF9F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 80rpx;
  box-sizing: border-box;
}

/* Logo 区域 */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 100rpx;
}

.logo-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(167, 251, 245, 0.4);
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #3A3A3A;
  margin-bottom: 16rpx;
  letter-spacing: 2rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #9A97AA;
  letter-spacing: 1rpx;
}

/* 协议 */
.agreement {
  display: flex;
  align-items: flex-start;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 28rpx;
  padding: 0 20rpx;
}

/* 勾选框（默认不勾选） */
.agree-check {
  flex-shrink: 0;
  width: 36rpx;
  height: 36rpx;
  border-radius: 50%;
  border: 2rpx solid #C4CDD6;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 2rpx;
  background: #FFFFFF;
}

.agree-check.checked {
  background: #12B7A8;
  border-color: #12B7A8;
}

.agree-check-icon {
  color: #FFFFFF;
  font-size: 24rpx;
  font-weight: 700;
  line-height: 1;
}

.agreement-text-wrap {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 2rpx;
}

.agreement-text {
  font-size: 24rpx;
  color: #9AA5B1;
  line-height: 1.5;
}

.link {
  font-size: 24rpx;
  color: #12B7A8;
  line-height: 1.5;
}

/* ===== 按钮组（含未勾选协议时的拦截遮罩） ===== */
.button-group-wrap {
  position: relative;
  width: 100%;
}

.button-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 28rpx;
  margin-bottom: 48rpx;
}

/* 拦截遮罩：未勾选协议时覆盖按钮，阻止授权弹窗提前触发 */
.btn-group-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 10;
  background: transparent;
}

/* 登录说明 */
.login-note {
  font-size: 22rpx;
  color: #CCCCCC;
  text-align: center;
}

/* ==================== */
/* 公共按钮样式          */
/* ==================== */

.btn {
  width: 100% !important;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none !important;
  padding: 0 !important;
  margin: 0;
  letter-spacing: 2rpx;
}

.btn::after {
  border: none !important;
}

/* 主按钮 - 薄荷青 */
.btn-primary {
  background: linear-gradient(135deg, #A7FBF5 0%, #85F0E8 100%);
  color: #3A3A3A;
  box-shadow: 0 8rpx 24rpx rgba(167, 251, 245, 0.5);
}

.btn-primary:active {
  opacity: 0.85;
  transform: scale(0.98);
}

.btn-phone-text {
  font-weight: 600;
}

/* 次按钮 - 浅粉 */
.btn-secondary {
  background: #FFE8F0;
  color: #4A4A4A;
}

.btn-secondary:active {
  opacity: 0.85;
}

/* ===== 登录中 Loading 状态 ===== */

/* 覆盖微信 button disabled 默认置灰，保留品牌渐变背景，仅降低不透明度 */
.btn[disabled] {
  opacity: 0.7;
}

.btn-primary[disabled] {
  background: linear-gradient(135deg, #A7FBF5 0%, #85F0E8 100%);
  color: #3A3A3A;
}

.btn-secondary[disabled] {
  background: #FFE8F0;
  color: #4A4A4A;
}

/* 登录中：spinner + 文案，替代 button 原生 loading，避免重复展示 */
.btn-loading {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  line-height: 1;
}

.spinner {
  width: 30rpx;
  height: 30rpx;
  margin-right: 14rpx;
  border: 4rpx solid rgba(58, 58, 58, 0.2);
  border-top-color: #3A3A3A;
  border-radius: 50%;
  animation: spin 0.8s linear infinite;
  flex-shrink: 0;
}

@keyframes spin {
  from { transform: rotate(0deg); }
  to { transform: rotate(360deg); }
}
