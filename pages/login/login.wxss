/* pages/login/login.wxss */

/* 页面容器 */
.page {
  min-height: 100vh;
  background: #FFF5F5;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 80rpx;
  box-sizing: border-box;
}

/* ===== Logo 区域 ===== */
.logo-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 120rpx;
}

.logo-icon {
  font-size: 120rpx;
  margin-bottom: 40rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #4A4A4A;
  margin-bottom: 20rpx;
}

.subtitle {
  font-size: 28rpx;
  color: #9A97AA;
}

/* ===== 按钮组 ===== */
.button-group {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
  margin-bottom: 60rpx;
}

.btn {
  width: 100% !important;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none !important;
  padding: 0 !important;
  margin: 0;
}

.btn::after {
  border: none !important;
}

/* 主按钮 - 青色 */
.btn-primary {
  background: #A7F0F5;
  color: #4A4A4A;
}

.btn-primary:active {
  opacity: 0.9;
}

/* 次按钮 - 粉色 */
.btn-secondary {
  background: #FFE8F0;
  color: #4A4A4A;
}

.btn-secondary:active {
  opacity: 0.9;
}

/* ===== 用户协议 ===== */
.agreement {
  display: flex;
  align-items: center;
  justify-content: center;
  flex-wrap: wrap;
}

.agreement-text {
  font-size: 24rpx;
  color: #9A97AA;
}

.link {
  font-size: 24rpx;
  color: #9A97AA;
  text-decoration: underline;
}
