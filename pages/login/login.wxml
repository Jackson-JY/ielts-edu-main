<!-- pages/login/login.wxml -->
<view class="page">

  <!-- Logo 区域 -->
  <view class="logo-section">
    <view class="logo-mark">
      <image wx:if="{{logoUrl}}" class="logo-img" src="{{logoUrl}}" mode="aspectFill"/>
    </view>
    <text class="title">Deer Edu</text>
    <text class="subtitle">专业陪伴，轻松备考</text>
  </view>

  <!-- 用户协议勾选（必须由用户主动勾选，不默认同意） -->
  <view class="agreement">
    <view class="agree-check {{agreed ? 'checked' : ''}}" bindtap="onToggleAgree">
      <icon wx:if="{{agreed}}" name="check" color="#FFFFFF" size="22rpx"/>
    </view>
    <view class="agreement-text-wrap">
      <text class="agreement-text" bindtap="onToggleAgree">我已阅读并同意</text>
      <text class="link" catchtap="showAgreement">《用户协议》</text>
      <text class="agreement-text" bindtap="onToggleAgree">和</text>
      <text class="link" catchtap="showPrivacy">《隐私政策》</text>
    </view>
  </view>

  <!-- 按钮组 -->
  <view class="button-group-wrap">
    <view class="button-group">
      <!-- 主按钮：手机号一键登录（微信原生授权弹窗，一次点击完成登录） -->
      <button
        class="btn btn-primary"
        open-type="getPhoneNumber"
        bindgetphonenumber="onGetPhoneNumber"
        disabled="{{isLoading}}"
        hover-class="btn-press"
      >
        <!-- 仅当前方式为手机号登录时展示 loading，避免两按钮同时变"登录中" -->
        <view wx:if="{{loginMethod === 'phone'}}" class="btn-loading">
          <view class="spinner"></view>
          <text>登录中</text>
        </view>
        <text wx:else class="btn-phone-text">手机号一键登录</text>
      </button>

      <!-- 次按钮：微信身份登录（静默，无需手机号） -->
      <button
        class="btn btn-secondary"
        bindtap="handleWechatLogin"
        disabled="{{isLoading}}"
        hover-class="btn-press"
      >
        <view wx:if="{{loginMethod === 'wechat'}}" class="btn-loading">
          <view class="spinner"></view>
          <text>登录中</text>
        </view>
        <text wx:else>微信登录</text>
      </button>
    </view>

    <!-- 未勾选协议时的点击拦截遮罩：防止授权弹窗在未同意协议前被触发 -->
    <view class="btn-group-mask" wx:if="{{!agreed}}" catchtap="onMaskTap"></view>
  </view>

  <!-- 登录说明 -->
  <view class="login-note">
    <text>登录后将自动同步你的学习记录</text>
  </view>

</view>
