<!-- pages/login/login.wxml -->
<view class="page">

  <!-- Logo 区域 -->
  <view class="logo-section">
    <image class="logo-img" src="{{logoUrl}}" mode="aspectFill" />
    <text class="title">欢迎来到雅思学习</text>
    <text class="subtitle">专业陪伴，轻松备考</text>
  </view>

  <!-- 新用户信息填写区域 -->
  <view class="user-info-section" wx:if="{{openId && !isOldUser}}">
    <view class="info-card">
      <text class="info-title">完善个人信息</text>
      
      <view class="avatar-selector">
        <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
          <view class="avatar-wrap">
            <image class="avatar-img" src="{{tempAvatarUrl || iconUser}}" mode="aspectFill" />
            <view class="avatar-edit">
              <text class="edit-icon">+</text>
            </view>
          </view>
        </button>
        <text class="avatar-hint">点击更换头像</text>
      </view>
      
      <view class="nickname-wrap">
        <text class="field-label">昵称</text>
        <input
          type="nickname"
          class="nickname-input"
          placeholder="请输入昵称"
          value="{{tempNickName}}"
          bind:input="onNickNameInput"
        />
      </view>
    </view>
  </view>

  <!-- 按钮组 -->
  <view class="button-group">
    <!-- 第一步：获取 openid -->
    <button
      wx:if="{{!openId}}"
      class="btn btn-primary"
      bindtap="handleWechatLogin"
      loading="{{isLoading}}"
      disabled="{{isLoading}}"
    >
      <text wx:if="{{!isLoading}}">微信一键登录</text>
      <text wx:else>登录中...</text>
    </button>

    <!-- 第二步：新用户完成注册 -->
    <button
      wx:if="{{openId && !isOldUser}}"
      class="btn btn-primary"
      bindtap="handleCompleteRegister"
      loading="{{isLoading}}"
      disabled="{{isLoading || !tempNickName}}"
    >
      <text wx:if="{{!isLoading}}">完成注册</text>
      <text wx:else>注册中...</text>
    </button>

    <button class="btn btn-secondary" bindtap="handleSkipLogin">
      游客模式体验
    </button>
  </view>

  <!-- 用户协议 -->
  <view class="agreement">
    <text class="agreement-text">登录即表示同意</text>
    <text class="link" bindtap="showAgreement">《用户协议》</text>
    <text class="agreement-text">和</text>
    <text class="link" bindtap="showPrivacy">《隐私政策》</text>
  </view>

</view>
