<!-- pages/schedule-manage/schedule-manage.wxml - 管理员排课页面 -->
<wxs module="utils">
module.exports = {
  includes: function(arr, val) {
    return arr.indexOf(val) !== -1;
  },
  getSubjectIcon: function(subject) {
    if (subject === '听力') return 'headphones';
    if (subject === '口语') return 'mic';
    if (subject === '阅读') return 'book';
    if (subject === '写作') return 'pen';
    return 'book';
  }
}
</wxs>

<view class="page">
  <!-- 页面头部 -->
  <view class="page-header">
    <view class="back-btn" bindtap="goBack" hover-class="icon-btn-active">
      <icon name="chevron-left" color="#1D1D1F" size="36rpx"/>
    </view>
    <text class="page-title">排课管理</text>
    <view class="add-btn" bindtap="showAddModal" hover-class="icon-btn-active">
      <icon name="plus" color="#0E8C81" size="32rpx"/>
    </view>
  </view>

  <!-- 加载状态 -->
  <view class="loading-container" wx:if="{{loading}}">
    <text class="loading-text">加载中</text>
  </view>

  <!-- 无权限提示 -->
  <view class="empty-state" wx:elif="{{!isAdmin}}">
    <icon name="user" color="#8E8E93" size="80rpx"/>
    <text class="empty-text">您没有管理员权限</text>
  </view>

  <!-- 课程视图区域 -->
  <view class="schedule-view" wx:else>
    <!-- 视图切换 + 日期导航 -->
    <view class="view-header">
      <view class="date-nav">
        <view class="nav-btn" bindtap="changeDate" data-direction="-1" hover-class="icon-btn-active">
          <icon name="chevron-left" color="#1D1D1F" size="32rpx"/>
        </view>
        <text class="date-text">{{dateRangeText}}</text>
        <view class="nav-btn" bindtap="changeDate" data-direction="1" hover-class="icon-btn-active">
          <icon name="chevron-right" color="#1D1D1F" size="32rpx"/>
        </view>
      </view>
      <view class="view-tabs">
        <view class="view-tab {{viewMode === 'day' ? 'active' : ''}}" bindtap="switchViewMode" data-mode="day">
          <text>日</text>
        </view>
        <view class="view-tab {{viewMode === 'week' ? 'active' : ''}}" bindtap="switchViewMode" data-mode="week">
          <text>周</text>
        </view>
        <view class="view-tab {{viewMode === 'month' ? 'active' : ''}}" bindtap="switchViewMode" data-mode="month">
          <text>月</text>
        </view>
      </view>
    </view>

    <!-- 学生筛选 -->
    <view class="student-filter-bar">
      <view class="filter-btn {{selectedStudentId ? 'active' : ''}}" bindtap="toggleStudentFilter" hover-class="btn-press">
        <text>{{selectedStudentId ? (studentListMap[selectedStudentId] || '已筛选') : '全部学生'}}</text>
        <icon name="chevron-down" color="#6E6E73" size="20rpx"/>
      </view>
      <text class="schedule-count">共 {{filteredScheduleList.length}} 节</text>
    </view>

    <!-- 学生筛选下拉 -->
    <view class="filter-dropdown" wx:if="{{showStudentFilter}}">
      <view class="filter-overlay" bindtap="toggleStudentFilter"></view>
      <view class="filter-content">
        <view class="filter-item {{selectedStudentId === '' ? 'selected' : ''}}" bindtap="onFilterStudentTap" data-id="" data-name="全部学生" hover-class="list-item-press">
          <text>全部学生</text>
          <icon wx:if="{{selectedStudentId === ''}}" name="check" color="#0E8C81" size="32rpx"/>
        </view>
        <view class="filter-item {{selectedStudentId === item.id ? 'selected' : ''}}"
              wx:for="{{studentList}}"
              wx:key="id"
              bindtap="onFilterStudentTap"
              data-id="{{item.id}}"
              data-name="{{item.name}}"
              hover-class="list-item-press">
          <text>{{item.name}}</text>
          <icon wx:if="{{selectedStudentId === item.id}}" name="check" color="#0E8C81" size="32rpx"/>
        </view>
      </view>
    </view>

    <!-- 日视图：星期导航 + 课程列表 -->
    <view wx:if="{{viewMode === 'day' || viewMode === 'week'}}">
      <!-- 星期选择器 -->
      <scroll-view scroll-x class="weekday-scroll">
        <view class="weekday-row">
          <view class="weekday-item {{selectedDay === item.day && selectedDate === item.date ? 'selected' : ''}} {{item.courseCount > 0 ? 'has-course' : ''}}"
                wx:for="{{weekDays}}"
                wx:key="date"
                bindtap="selectDay"
                data-day="{{item.day}}"
                data-date="{{item.date}}">
            <text class="weekday-name">{{item.dayName}}</text>
            <text class="weekday-num">{{item.day}}</text>
            <view class="course-dot" wx:if="{{item.courseCount > 0}}"></view>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 月视图：日期网格 -->
    <view class="month-grid" wx:if="{{viewMode === 'month'}}">
      <view class="month-weekday-header">
        <text class="month-weekday" wx:for="{{dayNames}}" wx:key="index">{{item}}</text>
      </view>
      <view class="month-days-grid">
        <view class="month-day-cell"
              wx:for="{{monthDays}}"
              wx:key="index">
          <view wx:if="{{item}}"
                class="month-day {{item.isToday ? 'today' : ''}} {{item.courseCount > 0 ? 'has-course' : ''}} {{selectedDate === item.date ? 'selected' : ''}}"
                bindtap="selectDay"
                data-day="{{item.day}}"
                data-date="{{item.date}}">
            <text>{{item.day}}</text>
            <view class="course-dot-small" wx:if="{{item.courseCount > 0}}"></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 课程列表 -->
    <view class="schedule-list">
      <view class="schedule-item {{item.isPast ? 'past' : ''}}"
            wx:for="{{filteredScheduleList}}"
            wx:key="id"
            data-schedule="{{item}}"
            bindtap="editSchedule"
            hover-class="card-press">
        <view class="schedule-icon-wrapper">
          <icon name="{{utils.getSubjectIcon(item.subject)}}" color="#12B7A8" size="40rpx"/>
        </view>

        <view class="schedule-content">
          <view class="schedule-title-row">
            <text class="schedule-title">{{item.title}}</text>
          </view>

          <view class="schedule-info">
            <view class="info-item">
              <icon name="calendar" color="#8E8E93" size="24rpx"/>
              <text>{{item.date}} {{item.startTime}}-{{item.endTime}}</text>
            </view>
            <view class="info-item" wx:if="{{item.studentName}}">
              <icon name="user" color="#8E8E93" size="24rpx"/>
              <text>{{item.studentName}}</text>
            </view>
            <view class="info-item" wx:if="{{item.teacher}}">
              <icon name="mic" color="#8E8E93" size="24rpx"/>
              <text>{{item.teacher}}</text>
            </view>
            <view class="info-item" wx:if="{{item.location}}">
              <icon name="book" color="#8E8E93" size="24rpx"/>
              <text>{{item.location}}</text>
            </view>
          </view>

          <view class="schedule-info" wx:if="{{item.scheduleMode === '循环'}}">
            <view class="repeat-tag">
              <icon name="reset" color="#0E8C81" size="20rpx"/>
              <text>循环课程</text>
            </view>
          </view>

          <text class="schedule-desc" wx:if="{{item.description}}">{{item.description}}</text>
        </view>

        <view class="schedule-actions">
          <view class="action-btn delete" catchtap="deleteSchedule" data-schedule="{{item}}" hover-class="btn-press">
            <text>删除</text>
          </view>
        </view>
      </view>

      <!-- 空状态 -->
      <view class="empty-state" wx:if="{{!loading && filteredScheduleList.length === 0}}">
        <icon name="calendar" color="#8E8E93" size="80rpx"/>
        <text class="empty-text">暂无课程安排</text>
        <text class="empty-sub">点击右上角添加课程</text>
      </view>
    </view>
  </view>

  <!-- 添加/编辑弹窗 -->
  <view class="modal-overlay" wx:if="{{showAddModal}}">
    <view class="modal-mask" catchtap="hideModal"></view>
    <view class="modal-content modal-scroll" catchtap="">
      <view class="modal-header">
        <text class="modal-title">{{editingSchedule ? '编辑课程' : '添加课程'}}</text>
        <text class="modal-subtitle">设置课程时间地点</text>
      </view>

      <!-- 排课模式选择 -->
      <view class="form-group">
        <text class="form-label">排课方式</text>
        <view class="mode-selector">
          <view
            class="mode-btn {{scheduleMode === 'single' ? 'active' : ''}}"
            data-mode="single"
            catchtap="onScheduleModeChange"
            hover-class="btn-press"
          >
            <text>单节课</text>
          </view>
          <view
            class="mode-btn {{scheduleMode === '循环' ? 'active' : ''}}"
            data-mode="循环"
            catchtap="onScheduleModeChange"
            hover-class="btn-press"
          >
            <text>循环排课</text>
          </view>
        </view>
      </view>

      <!-- 课程名称 -->
      <view class="form-group">
        <text class="form-label">课程名称 *</text>
        <input
          class="form-input"
          placeholder="如：雅思听力强化"
          value="{{formData.title}}"
          data-field="title"
          bindinput="onFormInput"
        />
      </view>

      <!-- 学生选择 -->
      <view class="form-group">
        <text class="form-label">选择学生</text>
        <view class="form-input student-picker" catchtap="onStudentInputTap" hover-class="btn-press">
          <text class="{{formData.studentName ? '' : 'placeholder'}}">
            {{formData.studentName || '点击选择学生'}}
          </text>
          <icon name="chevron-right" color="#8E8E93" size="24rpx"/>
        </view>
      </view>

      <!-- 科目选择 -->
      <view class="form-group">
        <text class="form-label">科目</text>
        <picker mode="selector" range="{{subjects}}" value="{{subjects.indexOf(formData.subject)}}" bindchange="onSubjectChange">
          <view class="form-picker">
            <text>{{formData.subject}}</text>
            <icon name="chevron-right" color="#8E8E93" size="24rpx"/>
          </view>
        </picker>
      </view>

      <!-- 日期选择 -->
      <view class="form-group">
        <text class="form-label">开始日期 *</text>
        <picker mode="date" value="{{formData.date}}" start="{{maxDate}}" bindchange="onFormInput" data-field="date">
          <view class="form-picker">
            <text>{{formData.date || '选择日期'}}</text>
            <icon name="chevron-right" color="#8E8E93" size="24rpx"/>
          </view>
        </picker>
      </view>

      <!-- 时间选择 -->
      <view class="form-group">
        <text class="form-label">时间</text>
        <view class="time-row">
          <picker mode="time" value="{{formData.startTime}}" bindchange="onFormInput" data-field="startTime">
            <view class="form-picker time-picker">
              <text>{{formData.startTime}}</text>
            </view>
          </picker>
          <text class="time-separator">至</text>
          <picker mode="time" value="{{formData.endTime}}" bindchange="onFormInput" data-field="endTime">
            <view class="form-picker time-picker">
              <text>{{formData.endTime}}</text>
            </view>
          </picker>
        </view>
      </view>

      <!-- 循环排课配置 -->
      <view class="repeat-config" wx:if="{{scheduleMode === '循环'}}">
        <view class="form-group">
          <text class="form-label">重复星期</text>
          <view class="weekday-selector">
            <view
              class="weekday-btn {{utils.includes(repeatConfig.weekdays, 1) ? 'active' : ''}}"
              data-weekday="1"
              catchtap="onWeekdayToggle"
            >
              <text>周一</text>
            </view>
            <view
              class="weekday-btn {{utils.includes(repeatConfig.weekdays, 2) ? 'active' : ''}}"
              data-weekday="2"
              catchtap="onWeekdayToggle"
            >
              <text>周二</text>
            </view>
            <view
              class="weekday-btn {{utils.includes(repeatConfig.weekdays, 3) ? 'active' : ''}}"
              data-weekday="3"
              catchtap="onWeekdayToggle"
            >
              <text>周三</text>
            </view>
            <view
              class="weekday-btn {{utils.includes(repeatConfig.weekdays, 4) ? 'active' : ''}}"
              data-weekday="4"
              catchtap="onWeekdayToggle"
            >
              <text>周四</text>
            </view>
            <view
              class="weekday-btn {{utils.includes(repeatConfig.weekdays, 5) ? 'active' : ''}}"
              data-weekday="5"
              catchtap="onWeekdayToggle"
            >
              <text>周五</text>
            </view>
            <view
              class="weekday-btn {{utils.includes(repeatConfig.weekdays, 6) ? 'active' : ''}}"
              data-weekday="6"
              catchtap="onWeekdayToggle"
            >
              <text>周六</text>
            </view>
            <view
              class="weekday-btn {{utils.includes(repeatConfig.weekdays, 7) ? 'active' : ''}}"
              data-weekday="7"
              catchtap="onWeekdayToggle"
            >
              <text>周日</text>
            </view>
          </view>
        </view>

        <view class="form-group">
          <text class="form-label">重复周数</text>
          <picker mode="selector" range="{{[1,2,3,4,5,6,7,8]}}" value="{{repeatConfig.weekCount - 1}}" bindchange="onWeekCountChange">
            <view class="form-picker">
              <text>{{repeatConfig.weekCount}} 周</text>
              <icon name="chevron-right" color="#8E8E93" size="24rpx"/>
            </view>
          </picker>
        </view>

        <view class="repeat-tip">
          <text>将从 {{formData.date}} 开始，连续 {{repeatConfig.weekCount}} 周的所选星期自动排课</text>
        </view>
      </view>

      <!-- 教师 -->
      <view class="form-group">
        <text class="form-label">教师</text>
        <input
          class="form-input"
          placeholder="授课教师姓名"
          value="{{formData.teacher}}"
          data-field="teacher"
          bindinput="onFormInput"
        />
      </view>

      <!-- 地点 -->
      <view class="form-group">
        <text class="form-label">上课地点</text>
        <input
          class="form-input"
          placeholder="如：在线/教室301"
          value="{{formData.location}}"
          data-field="location"
          bindinput="onFormInput"
        />
      </view>

      <!-- 描述 -->
      <view class="form-group">
        <text class="form-label">课程描述</text>
        <textarea
          class="form-textarea"
          placeholder="课程简介"
          value="{{formData.description}}"
          data-field="description"
          bindinput="onFormInput"
          maxlength="200"
        />
      </view>

      <view class="modal-buttons">
        <view class="modal-btn cancel" catchtap="hideModal" hover-class="btn-press">
          <text>取消</text>
        </view>
        <view class="modal-btn confirm" catchtap="saveSchedule" hover-class="btn-press">
          <text>保存</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 学生选择弹窗 -->
  <view class="student-picker-modal" wx:if="{{showStudentPicker}}" catchtap="onCloseStudentPicker">
    <view class="picker-content" catchtap="">
      <view class="picker-header">
        <text class="picker-title">选择学生</text>
        <view class="close-btn" bindtap="onCloseStudentPicker" hover-class="icon-btn-active">
          <icon name="close" color="#6E6E73" size="32rpx"/>
        </view>
      </view>

      <!-- 搜索框 -->
      <view class="search-box">
        <input
          class="search-input"
          placeholder="搜索学生姓名"
          value="{{studentSearchKeyword}}"
          bindinput="onStudentSearch"
        />
      </view>

      <!-- 学生列表 -->
      <scroll-view class="student-list" scroll-y>
        <view
          class="student-item {{item.id === formData.studentId ? 'student-selected' : ''}}"
          wx:for="{{filteredStudents}}"
          wx:key="id"
          bindtap="onSelectStudent"
          data-student="{{item}}"
          hover-class="list-item-press"
        >
          <view class="student-avatar">
            <image wx:if="{{item.avatarUrl}}" src="{{item.avatarUrl}}" mode="aspectFill"/>
            <text wx:else class="avatar-placeholder">{{item.name.length > 0 ? item.name[0] : '?'}}</text>
          </view>
          <text class="student-name">{{item.name}}</text>
          <icon wx:if="{{item.id === formData.studentId}}" name="check" color="#0E8C81" size="32rpx"/>
        </view>
        <view class="empty-tip" wx:if="{{filteredStudents.length === 0}}">
          <text>未找到匹配的学生</text>
        </view>
      </scroll-view>
    </view>
  </view>
</view>
