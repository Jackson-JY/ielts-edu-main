/* pages/schedule-manage/schedule-manage.wxss */
.page {
  min-height: 100vh;
  background: #F5F5F7;
  padding-bottom: 40rpx;
}

.page-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 32rpx;
  background: #FFFFFF;
  border-bottom: 1rpx solid #E5E5EA;
  position: sticky;
  top: 0;
  z-index: 10;
}

.back-btn, .add-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F2F2F7;
}

.icon-btn-active {
  background: #E5E5EA;
}

.add-btn {
  background: #E6F7F5;
}

.page-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.01em;
}

.loading-container, .empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 200rpx 0;
}

.loading-text {
  font-size: 28rpx;
  color: #8E8E93;
}

.empty-text {
  font-size: 30rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.empty-sub {
  font-size: 26rpx;
  color: #6E6E73;
}

.schedule-list {
  padding: 24rpx 32rpx;
}

.list-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.list-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.list-count {
  font-size: 24rpx;
  color: #8E8E93;
}

.schedule-item {
  display: flex;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  align-items: flex-start;
}

.card-press {
  background: #F2F2F7;
}

.schedule-item.past {
  opacity: 0.6;
}

.schedule-icon-wrapper {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
  flex-shrink: 0;
  background: #F5F5F7;
  border-radius: 16rpx;
}

.subject-tag {
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
}

.subject-text {
  font-size: 22rpx;
  color: #1D1D1F;
}

.schedule-content {
  flex: 1;
}

.schedule-title-row {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
}

.schedule-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-right: 12rpx;
  letter-spacing: -0.01em;
}

.schedule-info {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 8rpx;
}

.info-item {
  font-size: 24rpx;
  color: #6E6E73;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.schedule-desc {
  font-size: 24rpx;
  color: #8E8E93;
  line-height: 1.5;
}

.schedule-actions {
  display: flex;
  align-items: flex-start;
  margin-left: 16rpx;
}

.action-btn {
  padding: 8rpx 16rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 500;
}

.action-btn.delete {
  background: #FFEBEE;
  color: #FF3B30;
}

/* 弹窗样式 */
.modal-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
}

.modal-mask {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
}

.modal-content {
  position: absolute;
  left: 32rpx;
  right: 32rpx;
  top: 50%;
  transform: translateY(-50%);
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.12);
  padding: 32rpx;
  max-height: 80vh;
  overflow-y: auto;
  animation: modal-enter 250ms ease-out;
}

.modal-header {
  margin-bottom: 32rpx;
}

.modal-title {
  font-size: 36rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: -0.02em;
}

.modal-subtitle {
  font-size: 26rpx;
  color: #6E6E73;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 26rpx;
  color: #6E6E73;
  display: block;
  margin-bottom: 12rpx;
  font-weight: 500;
}

.form-input {
  width: 100%;
  height: 88rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  color: #1D1D1F;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  min-height: 160rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 30rpx;
  color: #1D1D1F;
  box-sizing: border-box;
}

.form-picker {
  height: 88rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  border-radius: 16rpx;
  padding: 0 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 30rpx;
  color: #1D1D1F;
  box-sizing: border-box;
}

.time-row {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.time-picker {
  flex: 1;
}

.time-separator {
  font-size: 28rpx;
  color: #8E8E93;
}

.modal-buttons {
  display: flex;
  gap: 24rpx;
  margin-top: 32rpx;
}

.modal-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-size: 30rpx;
  font-weight: 600;
}

.modal-btn.cancel {
  background: #F2F2F7;
  color: #1D1D1F;
}

.modal-btn.confirm {
  background: #12B7A8;
  color: #FFFFFF;
}

.btn-press {
  filter: brightness(0.92);
}

/* 弹窗可滚动 */
.modal-scroll {
  max-height: 85vh;
}

/* 排课模式选择 */
.mode-selector {
  display: flex;
  gap: 16rpx;
}

.mode-btn {
  flex: 1;
  height: 80rpx;
  background: #F2F2F7;
  border: 1rpx solid #E5E5EA;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6E6E73;
  transition: all 0.2s;
}

.mode-btn.active {
  background: #E6F7F5;
  border-color: #12B7A8;
  color: #0E8C81;
  font-weight: 600;
}

/* 学生选择器 */
.student-picker {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.student-picker .placeholder {
  color: #8E8E93;
}

/* 循环排课配置 */
.repeat-config {
  background: #F5F5F7;
  border: 1rpx solid #E5E5EA;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}

.repeat-config .form-group {
  margin-bottom: 20rpx;
}

.repeat-config .form-group:last-child {
  margin-bottom: 0;
}

/* 星期选择器 */
.weekday-selector {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}

.weekday-btn {
  width: 80rpx;
  height: 64rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #6E6E73;
  transition: all 0.2s;
}

.weekday-btn.active {
  background: #12B7A8;
  border-color: #12B7A8;
  color: #FFFFFF;
  font-weight: 600;
}

/* 循环提示 */
.repeat-tip {
  background: #E6F7F5;
  border-radius: 12rpx;
  padding: 16rpx;
  margin-top: 16rpx;
}

.repeat-tip text {
  font-size: 24rpx;
  color: #0E8C81;
  line-height: 1.5;
}

/* 循环标签 */
.repeat-tag {
  font-size: 22rpx;
  color: #0E8C81;
  background: #E6F7F5;
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  gap: 6rpx;
}

/* 学生选择弹窗 */
.student-picker-modal {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: flex-end;
}

.picker-content {
  width: 100%;
  max-height: 70vh;
  background: #FFFFFF;
  border-radius: 32rpx 32rpx 0 0;
  padding-bottom: env(safe-area-inset-bottom);
  display: flex;
  flex-direction: column;
  animation: sheet-enter 250ms ease-out;
}

.picker-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 40rpx;
  border-bottom: 1rpx solid #E5E5EA;
}

.picker-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.01em;
}

.close-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F2F2F7;
  border-radius: 50%;
}

.search-box {
  padding: 24rpx 40rpx;
}

.search-input {
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #1D1D1F;
}

.student-list {
  flex: 1;
  max-height: 50vh;
  padding: 0 40rpx;
}

.student-item {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #E5E5EA;
  gap: 24rpx;
}

.list-item-press {
  background: #F2F2F7;
}

.student-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  overflow: hidden;
  background: #E5E5EA;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.student-avatar image {
  width: 100%;
  height: 100%;
}

.avatar-placeholder {
  font-size: 28rpx;
  color: #6E6E73;
  font-weight: 600;
}

.student-name {
  flex: 1;
  font-size: 28rpx;
  color: #1D1D1F;
}

.student-selected .student-name {
  color: #0E8C81;
  font-weight: 600;
}

.empty-tip {
  text-align: center;
  padding: 80rpx 0;
  color: #8E8E93;
  font-size: 28rpx;
}

/* ======================================================
   视图切换和日历相关样式
   ====================================================== */

.schedule-view {
  padding: 24rpx 32rpx;
}

/* 视图头部：日期导航 + 视图切换 */
.view-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.date-nav {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F2F2F7;
  border-radius: 50%;
}

.date-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  min-width: 200rpx;
  text-align: center;
  letter-spacing: -0.01em;
}

.view-tabs {
  display: flex;
  background: #F2F2F7;
  border-radius: 999rpx;
  padding: 4rpx;
}

.view-tab {
  padding: 12rpx 28rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6E6E73;
  font-weight: 500;
}

.view-tab.active {
  background: #FFFFFF;
  color: #1D1D1F;
  font-weight: 600;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
}

/* 学生筛选栏 */
.student-filter-bar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.filter-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  padding: 12rpx 24rpx;
  background: #F2F2F7;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #1D1D1F;
}

.filter-btn.active {
  background: #E6F7F5;
  color: #0E8C81;
}

.schedule-count {
  font-size: 24rpx;
  color: #8E8E93;
}

/* 筛选下拉 */
.filter-dropdown {
  position: relative;
  margin-bottom: 20rpx;
  z-index: 100;
}

.filter-overlay {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.3);
  z-index: 99;
}

.filter-content {
  position: relative;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  border-radius: 16rpx;
  padding: 16rpx 0;
  max-height: 400rpx;
  overflow-y: auto;
  z-index: 100;
  box-shadow: 0 8px 24px -8px rgba(0, 0, 0, 0.08);
}

.filter-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  font-size: 28rpx;
  color: #1D1D1F;
}

.filter-item.selected {
  color: #0E8C81;
  background: #E6F7F5;
}

/* 星期选择器 */
.weekday-scroll {
  white-space: nowrap;
  margin-bottom: 24rpx;
}

.weekday-row {
  display: inline-flex;
  gap: 16rpx;
  padding: 8rpx 0;
}

.weekday-item {
  width: 80rpx;
  height: 100rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: #F2F2F7;
  border: 1rpx solid transparent;
  border-radius: 16rpx;
  position: relative;
  flex-shrink: 0;
}

.weekday-item.selected {
  background: #12B7A8;
  border-color: #12B7A8;
}

.weekday-item.has-course {
  background: #FFFFFF;
  border-color: #E5E5EA;
}

.weekday-item.has-course.selected {
  background: #12B7A8;
  border-color: #12B7A8;
}

.weekday-name {
  font-size: 22rpx;
  color: #8E8E93;
  margin-bottom: 4rpx;
}

.weekday-item.selected .weekday-name {
  color: rgba(255, 255, 255, 0.8);
}

.weekday-num {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.weekday-item.selected .weekday-num {
  color: #FFFFFF;
}

.course-dot {
  position: absolute;
  bottom: 8rpx;
  width: 8rpx;
  height: 8rpx;
  background: #12B7A8;
  border-radius: 50%;
}

.weekday-item.has-course.selected .course-dot {
  background: #FFFFFF;
}

/* 月视图网格 */
.month-grid {
  margin-bottom: 24rpx;
}

.month-weekday-header {
  display: flex;
  margin-bottom: 16rpx;
}

.month-weekday {
  flex: 1;
  text-align: center;
  font-size: 24rpx;
  color: #8E8E93;
  padding: 8rpx 0;
}

.month-days-grid {
  display: flex;
  flex-wrap: wrap;
}

.month-day-cell {
  width: calc(100% / 7);
  aspect-ratio: 1;
  display: flex;
  align-items: center;
  justify-content: center;
}

.month-day {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  font-size: 28rpx;
  color: #1D1D1F;
  position: relative;
}

.month-day.today {
  border: 2rpx solid #12B7A8;
}

.month-day.selected {
  background: #12B7A8;
  color: #FFFFFF;
}

.month-day.has-course {
  color: #0E8C81;
  font-weight: 600;
}

.month-day.has-course.selected {
  color: #FFFFFF;
}

.course-dot-small {
  position: absolute;
  bottom: 4rpx;
  width: 6rpx;
  height: 6rpx;
  background: #12B7A8;
  border-radius: 50%;
}

.month-day.has-course.selected .course-dot-small {
  background: #FFFFFF;
}

/* 入场动画 */
@keyframes modal-enter {
  from {
    opacity: 0;
    transform: translateY(-50%) translateY(20rpx);
  }
  to {
    opacity: 1;
    transform: translateY(-50%);
  }
}

@keyframes sheet-enter {
  from {
    opacity: 0;
    transform: translateY(40rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
