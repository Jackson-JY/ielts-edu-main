/* pages/checkin/checkin.wxss */

.page {
  background: #FFF9F5;
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 标题区域 */
.header {
  padding: 48rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #9A97AA;
  display: block;
}

/* 打卡统计卡片 */
.stats-card {
  background: #F5F0FF;
  border-radius: 44rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.stat-value {
  font-size: 44rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #9A97AA;
  display: block;
}

.stat-divider {
  width: 1rpx;
  height: 64rpx;
  background: rgba(154, 151, 170, 0.3);
}

/* 日历卡片 */
.calendar-card {
  background: #F5F0FF;
  border-radius: 44rpx;
  padding: 40rpx 32rpx;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.calendar-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.calendar-nav {
  display: flex;
  gap: 16rpx;
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFF9F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn text {
  font-size: 32rpx;
  color: #4A4A4A;
  font-weight: bold;
}

/* 日历星期标题 */
.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.weekday {
  text-align: center;
  font-size: 24rpx;
  color: #9A97AA;
  padding: 8rpx 0;
}

/* 日历日期 */
.calendar-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.day-item {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 24rpx;
  position: relative;
  gap: 8rpx;
}

.day-item.other-month {
  opacity: 0.3;
}

.day-item.today {
  background: #E8D4F8;
}

.day-item.checked {
  background: #A7FBF5;
}

.day-number {
  font-size: 28rpx;
  color: #4A4A4A;
  font-weight: 600;
}

.check-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #FFB6C1;
}

/* 今日打卡按钮 */
.checkin-button {
  width: 100%;
  padding: 32rpx 0;
  background: #A7FBF5;
  border-radius: 60rpx;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.checkin-button.checked {
  background: #F5F0FF;
  color: #9A97AA;
}

/* 打卡动态卡片 */
.feed-card {
  background: #F5F0FF;
  border-radius: 44rpx;
  padding: 40rpx 32rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
}

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feed-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.feed-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E8D4F8;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 32rpx;
}

.feed-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.feed-name {
  font-size: 26rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
}

.feed-text {
  font-size: 22rpx;
  color: #9A97AA;
  display: block;
}

.feed-time {
  font-size: 20rpx;
  color: #9A97AA;
  flex-shrink: 0;
}
