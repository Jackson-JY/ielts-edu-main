/* pages/checkin/checkin.wxss */

.page {
  background: #F5F5F7;
  min-height: 100vh;
  padding: 0 32rpx 180rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}

/* 标题区域 */
.header {
  padding: 48rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  animation: page-enter 250ms ease-out;
}

.title {
  font-size: 44rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.02em;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #6E6E73;
  display: block;
}

/* 打卡统计卡片 */
.stats-card {
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-around;
}

.stat-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  flex: 1;
}

.stat-value {
  font-size: 48rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.02em;
  display: block;
}

.stat-label {
  font-size: 22rpx;
  color: #6E6E73;
  display: block;
}

.stat-divider {
  width: 1rpx;
  height: 64rpx;
  background: #E5E5EA;
}

/* 日历卡片 */
.calendar-card {
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
}

.calendar-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32rpx;
}

.calendar-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.01em;
}

.calendar-nav {
  display: flex;
  gap: 16rpx;
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-btn-active {
  background: #E5E5EA;
}

/* 日历星期标题 */
.calendar-weekdays {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.weekday {
  text-align: center;
  font-size: 24rpx;
  color: #8E8E93;
  padding: 8rpx 0;
}

/* 日历日期 */
.calendar-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.day-item {
  aspect-ratio: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border-radius: 16rpx;
  position: relative;
  gap: 8rpx;
}

.day-item.other-month {
  opacity: 0.3;
}

.day-item.today {
  background: #E6F7F5;
}

.day-item.checked {
  background: #E6F7F5;
}

.day-number {
  font-size: 28rpx;
  color: #1D1D1F;
  font-weight: 500;
}

.day-item.today .day-number,
.day-item.checked .day-number {
  color: #0E8C81;
  font-weight: 600;
}

.check-dot {
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: #12B7A8;
}

/* 今日打卡按钮 */
.checkin-button {
  width: 100%;
  height: 88rpx;
  padding: 0 48rpx;
  background: #12B7A8;
  border-radius: 999px;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 12rpx;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  box-sizing: border-box;
}

.btn-press {
  filter: brightness(0.92);
}

.checkin-button.checked {
  background: #F2F2F7;
  color: #6E6E73;
}

/* 打卡动态卡片 */
.feed-card {
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.01em;
  display: block;
}

.feed-list {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}

.feed-item {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.feed-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background: #E6F7F5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.avatar-text {
  font-size: 28rpx;
  color: #0E8C81;
  font-weight: 600;
}

.feed-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.feed-name {
  font-size: 26rpx;
  font-weight: 500;
  color: #1D1D1F;
  display: block;
}

.feed-text {
  font-size: 24rpx;
  color: #6E6E73;
  display: block;
}

.feed-time {
  font-size: 22rpx;
  color: #8E8E93;
  flex-shrink: 0;
}

/* 入场动画 */
@keyframes page-enter {
  from {
    opacity: 0;
    transform: translateY(8rpx);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}
