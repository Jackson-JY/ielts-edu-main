<!-- pages/checkin/checkin.wxml -->
<view class="page">
  <!-- 标题区域 -->
  <view class="header">
    <text class="title">打卡记录</text>
    <text class="subtitle">坚持学习，见证进步</text>
  </view>

  <!-- 打卡统计 -->
  <view class="stats-card">
    <view class="stat-item">
      <text class="stat-value">{{currentStreak}}</text>
      <text class="stat-label">连续打卡</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{totalDays}}</text>
      <text class="stat-label">累计天数</text>
    </view>
    <view class="stat-divider"></view>
    <view class="stat-item">
      <text class="stat-value">{{achievementCount}}</text>
      <text class="stat-label">获得成就</text>
    </view>
  </view>

  <!-- 日历视图 -->
  <view class="calendar-card">
    <view class="calendar-header">
      <text class="calendar-title">{{currentMonth}}月</text>
      <view class="calendar-nav">
        <view class="nav-btn" bindtap="prevMonth" hover-class="nav-btn-active">
          <icon name="chevron-left" color="#1D1D1F" size="32rpx"/>
        </view>
        <view class="nav-btn" bindtap="nextMonth" hover-class="nav-btn-active">
          <icon name="chevron-right" color="#1D1D1F" size="32rpx"/>
        </view>
      </view>
    </view>

    <view class="calendar-weekdays">
      <text class="weekday" wx:for="{{weekDays}}" wx:key="index">{{item}}</text>
    </view>

    <view class="calendar-days">
      <block wx:for="{{calendarDays}}" wx:key="index">
        <view
          class="day-item {{item.isCurrentMonth ? '' : 'other-month'}} {{item.isToday ? 'today' : ''}} {{item.isChecked ? 'checked' : ''}}"
        >
          <text class="day-number">{{item.day}}</text>
          <view class="check-dot" wx:if="{{item.isChecked}}"></view>
        </view>
      </block>
    </view>
  </view>

  <!-- 今日打卡按钮 -->
  <view class="checkin-button {{todayChecked ? 'checked' : ''}}" bindtap="doCheckin" hover-class="btn-press">
    <icon wx:if="{{todayChecked}}" name="check" color="#6E6E73" size="32rpx"/>
    <text>{{todayChecked ? '今日已打卡' : '立即打卡'}}</text>
  </view>

  <!-- 打卡动态 -->
  <view class="feed-card">
    <text class="card-title">打卡动态</text>
    <view class="feed-list">
      <view class="feed-item" wx:for="{{checkinFeed}}" wx:key="index">
        <view class="feed-avatar">
          <text class="avatar-text">{{item.avatar}}</text>
        </view>
        <view class="feed-content">
          <text class="feed-name">{{item.name}}</text>
          <text class="feed-text">{{item.text}}</text>
        </view>
        <text class="feed-time">{{item.time}}</text>
      </view>
    </view>
  </view>
</view>
