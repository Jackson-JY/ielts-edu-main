<!-- pages/learning-report/learning-report.wxml -->
<view class="page">
  <!-- 标题区域 -->
  <view class="header">
    <text class="title">学习报告</text>
    <text class="subtitle">查看你的学习进度和成果</text>
  </view>

  <!-- 时间筛选 -->
  <view class="time-filter">
    <view 
      class="filter-btn {{timeRange === 'week' ? 'active' : ''}}" 
      bindtap="switchTimeRange" 
      data-range="week"
    >
      <text>本周</text>
    </view>
    <view 
      class="filter-btn {{timeRange === 'month' ? 'active' : ''}}" 
      bindtap="switchTimeRange" 
      data-range="month"
    >
      <text>本月</text>
    </view>
    <view 
      class="filter-btn {{timeRange === 'all' ? 'active' : ''}}" 
      bindtap="switchTimeRange" 
      data-range="all"
    >
      <text>全部</text>
    </view>
  </view>

  <!-- 学习时长统计 -->
  <view class="section-card">
    <text class="card-title">学习时长</text>
    <view class="study-time">
      <view class="time-circle">
        <text class="time-value">{{totalHours}}</text>
        <text class="time-unit">小时</text>
      </view>
      <view class="time-details">
        <view class="time-item">
          <text class="time-label">本周</text>
          <text class="time-value-small">{{weekHours}}小时</text>
        </view>
        <view class="time-item">
          <text class="time-label">本月</text>
          <text class="time-value-small">{{monthHours}}小时</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 学习趋势图 -->
  <view class="section-card">
    <text class="card-title">学习趋势</text>
    <view class="trend-chart">
      <block wx:for="{{trendData}}" wx:key="index">
        <view class="trend-bar-wrap">
          <view class="trend-bar" style="height: {{item.hours / 5 * 100}}%;"></view>
          <text class="trend-label">{{item.label}}</text>
        </view>
      </block>
    </view>
  </view>

  <!-- 技能提升 -->
  <view class="section-card">
    <text class="card-title">技能提升</text>
    <view class="skill-list">
      <view class="skill-item" wx:for="{{skillImprovements}}" wx:key="index">
        <view class="skill-info">
          <text class="skill-name">{{item.name}}</text>
          <text class="skill-score">当前：{{item.currentScore}}</text>
        </view>
        <view class="skill-progress">
          <view class="progress-bar">
            <view class="progress-fill" style="width: {{item.progress}}%;"></view>
          </view>
          <text class="progress-text">+{{item.improvement}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 学习建议 -->
  <view class="section-card">
    <text class="card-title">学习建议</text>
    <view class="suggestion-list">
      <view class="suggestion-item" wx:for="{{suggestions}}" wx:key="index">
        <view class="suggestion-icon">
          <text>{{item.icon}}</text>
        </view>
        <view class="suggestion-content">
          <text class="suggestion-title">{{item.title}}</text>
          <text class="suggestion-desc">{{item.desc}}</text>
        </view>
      </view>
    </view>
  </view>
</view>
