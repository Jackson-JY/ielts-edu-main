/* 学习报告页面样式 */
page {
  background: linear-gradient(180deg, #F8F4FF 0%, #F5F0FF 100%);
  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif;
}

.page {
  padding: 0 32rpx 60rpx;
  min-height: 100vh;
}

/* 顶部标题区 */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 40rpx 0 32rpx;
}

.header-content {
  flex: 1;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
  color: #4A4A4A;
  display: block;
  margin-bottom: 12rpx;
  letter-spacing: -0.5rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #9A97AA;
  display: block;
}

.header-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
}

.date-badge {
  background: linear-gradient(135deg, #6C5CE7 0%, #A29BFE 100%);
  border-radius: 32rpx;
  padding: 16rpx 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(108, 92, 231, 0.3);
}

.date-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 分享按钮 */
.share-btn {
  display: flex;
  align-items: center;
  gap: 8rpx;
  background: linear-gradient(135deg, #FF6B6B 0%, #FF8E8E 100%);
  border-radius: 32rpx;
  padding: 12rpx 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 107, 0.3);
  border: none;
  margin: 0;
  line-height: 1;
}

.share-btn::after {
  border: none;
}

.share-icon {
  font-size: 28rpx;
}

.share-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* 核心数据概览 */
.stats-overview {
  margin-bottom: 32rpx;
}

.stat-card {
  background: linear-gradient(145deg, #6C5CE7 0%, #8B7FE8 100%);
  border-radius: 32rpx;
  padding: 40rpx;
  display: flex;
  align-items: center;
  gap: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(108, 92, 231, 0.25);
}

.stat-icon {
  width: 88rpx;
  height: 88rpx;
  background: rgba(255, 255, 255, 0.2);
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 44rpx;
}

.stat-content {
  flex: 1;
}

.stat-value {
  font-size: 64rpx;
  font-weight: 800;
  color: #FFFFFF;
  display: block;
  line-height: 1.1;
}

.stat-label {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  display: block;
  margin-top: 8rpx;
}

/* 迷你统计网格 */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 16rpx;
}

.stat-mini {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 24rpx 16rpx;
  text-align: center;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.06);
}

.mini-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #6C5CE7;
  display: block;
  margin-bottom: 8rpx;
}

.mini-label {
  font-size: 22rpx;
  color: #9A97AA;
  display: block;
}

.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  margin-bottom: 28rpx;
}

.header-left {
  flex: 1;
}

.card-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
  margin-bottom: 8rpx;
}

.card-subtitle {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
}

/* 趋势图图例 */
.trend-legend {
  display: flex;
  align-items: center;
  gap: 12rpx;
  background: #F8F4FF;
  padding: 12rpx 20rpx;
  border-radius: 24rpx;
}

.legend-dot {
  width: 16rpx;
  height: 16rpx;
  background: #6C5CE7;
  border-radius: 50%;
}

.legend-text {
  font-size: 22rpx;
  color: #6C5CE7;
  font-weight: 500;
}

/* 图表容器 */
.chart-container {
  background: linear-gradient(180deg, #FAFAFA 0%, #F5F5F5 100%);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.trend-canvas {
  width: 100%;
  height: 280rpx;
}

.trend-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 20rpx;
}

.trend-label {
  font-size: 22rpx;
  color: #9A97AA;
  text-align: center;
  flex: 1;
}

/* 科目趋势图 - 两科一行 */
.subject-charts-row {
  display: flex;
  gap: 20rpx;
  margin-bottom: 24rpx;
}

.subject-chart-item {
  flex: 1;
  background: linear-gradient(145deg, #FAFAFA 0%, #F5F5F5 100%);
  border-radius: 20rpx;
  padding: 20rpx;
}

.subject-chart-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.subject-icon {
  font-size: 32rpx;
}

.subject-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A4A;
}

.mini-chart-container {
  height: 160rpx;
}

.mini-chart-canvas {
  width: 100%;
  height: 100%;
}

/* 总成绩趋势 */
.total-score-section {
  margin-top: 32rpx;
  padding-top: 24rpx;
  border-top: 2rpx dashed #E8E8E8;
}

.total-score-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 20rpx;
}

.total-score-icon {
  font-size: 36rpx;
}

.total-score-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #4A4A4A;
}

.total-chart-container {
  background: linear-gradient(145deg, #FFF8E7 0%, #FFF3D9 100%);
  border-radius: 20rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.total-chart-canvas {
  width: 100%;
  height: 240rpx;
}

.total-chart-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 20rpx;
}

.total-chart-label {
  font-size: 20rpx;
  color: #9A97AA;
  text-align: center;
  flex: 1;
}

/* 底部留白 */
.footer-space {
  height: 40rpx;
}

/* 空状态 */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-icon {
  font-size: 80rpx;
  margin-bottom: 24rpx;
  display: block;
}

.empty-text {
  font-size: 30rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #B8B5C4;
}

/* 隐藏的画布 - 使用 visibility 而不是移出屏幕 */
.share-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 750px;
  height: 1500px;
  visibility: hidden;
  z-index: -1;
}
