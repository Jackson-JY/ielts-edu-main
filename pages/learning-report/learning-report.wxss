/* 学习报告页面样式 */
page {
  background: #F5F5F7;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'SF Pro Text', 'Helvetica Neue', Arial, sans-serif;
}

.page {
  padding: 0 32rpx 60rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ==================== 顶部标题区 ==================== */
.header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  padding: 40rpx 0 32rpx;
  gap: 24rpx;
}

.header-content {
  flex: 1;
  min-width: 0;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1D1D1F;
  display: block;
  margin-bottom: 8rpx;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.title-row,
.card-title-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
}

.subtitle {
  font-size: 26rpx;
  color: #6E6E73;
  display: block;
}

.header-actions {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 16rpx;
  flex-shrink: 0;
}

.date-badge {
  background: #F2F2F7;
  border-radius: 999px;
  padding: 12rpx 24rpx;
}

.date-text {
  font-size: 24rpx;
  color: #6E6E73;
  font-weight: 600;
}

/* 分享按钮：薄荷绿胶囊 + share 图标 */
.share-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  background: #12B7A8;
  border-radius: 999px;
  padding: 0 24rpx;
  height: 64rpx;
  border: none;
  margin: 0;
  line-height: 1;
  box-sizing: border-box;
  transition: filter 0.18s ease;
}

.share-btn::after {
  border: none;
}

.share-btn:active {
  filter: brightness(0.92);
}

.share-text {
  font-size: 24rpx;
  color: #FFFFFF;
  font-weight: 600;
}

/* ==================== 核心数据概览 ==================== */
.stats-overview {
  margin-bottom: 24rpx;
}

/* 总时长超大数字卡片 */
.stat-card.primary {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 24rpx;
  margin-bottom: 16rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
}

.stat-primary-content {
  flex: 1;
  min-width: 0;
}

.stat-eyebrow {
  font-size: 20rpx;
  font-weight: 600;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  display: block;
  margin-bottom: 8rpx;
}

.stat-primary-row {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.stat-value-big {
  font-size: 72rpx;
  font-weight: 700;
  color: #1D1D1F;
  line-height: 1.1;
  letter-spacing: -0.02em;
}

.stat-unit {
  font-size: 28rpx;
  color: #6E6E73;
  font-weight: 500;
}

.stat-primary-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 16rpx;
  background: #E6F7F5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

/* 迷你统计网格 2×2 */
.stat-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.stat-mini {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 24rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
}

.mini-value {
  font-size: 36rpx;
  font-weight: 700;
  color: #1D1D1F;
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: -0.01em;
  line-height: 1.1;
}

.mini-label {
  font-size: 22rpx;
  color: #8E8E93;
  display: block;
}

/* ==================== 卡片头部 ==================== */
.card-header {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  gap: 16rpx;
  margin-bottom: 28rpx;
}

.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
  margin-bottom: 6rpx;
  letter-spacing: -0.01em;
  line-height: 1.2;
}

.card-subtitle {
  font-size: 24rpx;
  color: #8E8E93;
  display: block;
}

/* ==================== 听说读写打卡统计 ==================== */
.subject-checkin-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 16rpx;
}

.subject-checkin-item {
  background: #FFFFFF;
  border-radius: 16rpx;
  padding: 28rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
}

.subject-checkin-count {
  font-size: 36rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.01em;
  line-height: 1.1;
}

.subject-checkin-label {
  font-size: 22rpx;
  color: #8E8E93;
}

/* ==================== 科目趋势图 ==================== */
.subject-charts-row {
  display: flex;
  gap: 16rpx;
  margin-bottom: 16rpx;
}

.subject-chart-item {
  flex: 1;
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 20rpx;
}

.subject-chart-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 12rpx;
}

.subject-name {
  font-size: 28rpx;
  font-weight: 600;
  color: #1D1D1F;
}

.mini-chart-container {
  height: 160rpx;
}

.mini-chart-canvas {
  width: 100%;
  height: 100%;
}

/* ==================== 总成绩趋势 ==================== */
.total-score-section {
  margin-top: 24rpx;
  padding-top: 24rpx;
  border-top: 1rpx solid #E5E5EA;
}

.total-score-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}

.total-score-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.01em;
}

.total-chart-container {
  background: #F2F2F7;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 16rpx;
}

.total-chart-canvas {
  width: 100%;
  height: 240rpx;
}

.total-chart-labels {
  display: flex;
  justify-content: space-between;
  padding: 0 20rpx;
}

.total-chart-label {
  font-size: 20rpx;
  color: #8E8E93;
  text-align: center;
  flex: 1;
}

/* ==================== 底部留白 ==================== */
.footer-space {
  height: 40rpx;
}

/* ==================== 空状态 ==================== */
.empty-state {
  text-align: center;
  padding: 80rpx 40rpx;
}

.empty-text {
  font-size: 30rpx;
  color: #6E6E73;
  display: block;
  margin-bottom: 12rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #8E8E93;
}

/* 隐藏的画布用于生成分享图片 */
.share-canvas {
  position: absolute;
  left: 0;
  top: 0;
  width: 750px;
  height: 1500px;
  visibility: hidden;
  z-index: -1;
}

/* ==================== 成绩详情表格 ==================== */
.score-table-wrapper {
  overflow-x: auto;
  margin: 0 -16rpx;
  padding: 0 16rpx;
}

.score-table {
  display: inline-block;
  min-width: 100%;
}

/* 表头：浅灰背景 */
.table-header {
  display: flex;
  background: #F2F2F7;
  border-radius: 16rpx 16rpx 0 0;
  padding: 16rpx 0;
}

.table-row {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #E5E5EA;
}

.table-row:last-child {
  border-bottom: none;
  border-radius: 0 0 16rpx 16rpx;
}

.table-cell {
  font-size: 24rpx;
  color: #1D1D1F;
  text-align: center;
  flex: 1;
  min-width: 80rpx;
}

.header-cell {
  color: #6E6E73;
  font-weight: 600;
  font-size: 24rpx;
}

.subject-cell {
  min-width: 140rpx;
  flex: none;
  text-align: left;
  padding-left: 16rpx;
  font-weight: 500;
}

.subject-cell-with-icon {
  display: flex;
  align-items: center;
  gap: 8rpx;
  box-sizing: border-box;
}

.date-col {
  min-width: 100rpx;
  flex: none;
}

.improve-col {
  min-width: 100rpx;
  flex: none;
  text-align: right;
  padding-right: 16rpx;
  font-weight: 600;
}

/* 总分行高亮 */
.total-row {
  background: #F2F2F7;
}

.total-cell {
  font-weight: 700;
  color: #12B7A8;
}

.subject-improve {
  font-weight: 600;
}

.total-improve {
  font-weight: 700;
}

/* 提高/下降：薄荷绿 / 系统红 */
.improve-positive {
  color: #12B7A8;
}

.improve-negative {
  color: #FF3B30;
}

/* 最新成绩列高亮 */
.latest-col {
  background: #E6F7F5;
  font-weight: 600;
}
