<!-- pages/courses/courses.wxml -->
<view class="page">
  <!-- 顶部标题 -->
  <view class="header">
    <text class="title">课程安排</text>
  </view>

  <!-- 视图切换：胶囊形 Segmented Control -->
  <view class="view-mode-switch">
    <view
      class="mode-btn {{viewMode === 'day' ? 'active' : ''}}"
      bindtap="switchViewMode"
      data-mode="day"
    >
      <text>日</text>
    </view>
    <view
      class="mode-btn {{viewMode === 'week' ? 'active' : ''}}"
      bindtap="switchViewMode"
      data-mode="week"
    >
      <text>周</text>
    </view>
    <view
      class="mode-btn {{viewMode === 'month' ? 'active' : ''}}"
      bindtap="switchViewMode"
      data-mode="month"
    >
      <text>月</text>
    </view>
  </view>

  <!-- 日期导航：chevron 图标 + 加粗居中文字 -->
  <view class="date-nav">
    <view class="nav-btn" bindtap="changeDate" data-direction="-1">
      <icon name="chevron-left" color="#1D1D1F" size="36rpx"/>
    </view>
    <text class="date-text">{{dateRangeText}}</text>
    <view class="nav-btn" bindtap="changeDate" data-direction="1">
      <icon name="chevron-right" color="#1D1D1F" size="36rpx"/>
    </view>
  </view>

  <!-- 日视图 -->
  <view class="day-view" wx:if="{{viewMode === 'day'}}">
    <scroll-view scroll-y class="course-list">
      <block wx:if="{{filteredCourses.length > 0}}">
        <block wx:for="{{filteredCourses}}" wx:key="_id">
          <view class="course-card">
            <view class="course-header" bindtap="toggleExpand" data-id="{{item._id}}">
              <view class="course-time">
                <text class="course-start">{{item.startTime}}</text>
                <text class="course-end">{{item.endTime}}</text>
              </view>
              <view class="course-type-icon-wrap">
                <icon name="{{item.iconName || 'book'}}" color="#12B7A8" size="32rpx"/>
              </view>
              <view class="course-info">
                <text class="course-name">{{item.title}}</text>
                <view class="course-student" wx:if="{{item.studentName}}">
                  <icon name="user" color="#12B7A8" size="22rpx"/>
                  <text class="course-student-text">{{item.studentName}}</text>
                </view>
                <view class="course-meta">
                  <text class="meta-item">{{item.date}}</text>
                  <text class="meta-item">{{item.duration}}</text>
                  <view class="status-badge {{item.status === '已完成' ? 'status-completed' : 'status-pending'}}">
                    <text>{{item.status}}</text>
                  </view>
                </view>
                <text class="course-desc" wx:if="{{item.description}}">{{item.description}}</text>
              </view>
              <view class="expand-icon" wx:if="{{expandedCourse === item._id}}">
                <icon name="chevron-up" color="#8E8E93" size="32rpx"/>
              </view>
              <view class="expand-icon" wx:else>
                <icon name="chevron-down" color="#8E8E93" size="32rpx"/>
              </view>
            </view>

            <!-- 展开的作业区域 -->
            <view class="homework-section" wx:if="{{expandedCourse === item._id}}">
              <view class="homework-form">
                <view class="hw-items-header">
                  <text class="hw-col-content">作业内容</text>
                  <text class="hw-col-time">预估完成(分钟)</text>
                </view>
                <view class="hw-item-row" wx:for="{{homework[item._id].items}}" wx:for-item="hw" wx:for-index="hwIndex" wx:key="hwIndex">
                  <input class="hw-item-content" placeholder="请输入作业内容"
                         value="{{hw.content}}" bindinput="onHomeworkItemContentInput"
                         data-id="{{item._id}}" data-index="{{hwIndex}}" />
                  <input class="hw-item-time" type="number" placeholder="分钟"
                         value="{{hw.estimatedTime}}" bindinput="onHomeworkItemTimeInput"
                         data-id="{{item._id}}" data-index="{{hwIndex}}" />
                  <view class="hw-item-del" wx:if="{{homework[item._id].items.length > 1}}"
                        catchtap="removeHomeworkItem" data-id="{{item._id}}" data-index="{{hwIndex}}">
                    <icon name="close" color="#8E8E93" size="24rpx"/>
                  </view>
                </view>

                <view class="hw-add-row" bindtap="addHomeworkItem" data-id="{{item._id}}">
                  <icon name="plus" color="#12B7A8" size="24rpx"/>
                  <text>继续添加作业项</text>
                </view>

                <view class="save-button" bindtap="saveHomework" data-id="{{item._id}}">
                  <text>保存作业</text>
                </view>
              </view>
            </view>
          </view>
        </block>
      </block>

      <!-- 空状态 -->
      <view class="empty-state" wx:else>
        <view class="empty-icon-wrap">
          <icon name="calendar" color="#8E8E93" size="48rpx"/>
        </view>
        <text class="empty-text">暂无课程安排</text>
      </view>
    </scroll-view>
  </view>

  <!-- 周视图 -->
  <view class="week-view" wx:if="{{viewMode === 'week'}}">
    <view class="week-grid">
      <block wx:for="{{weekDays}}" wx:key="index">
        <view
          class="week-day {{selectedDay === item.day ? 'selected' : ''}} {{item.isToday ? 'today' : ''}}"
          bindtap="selectDay"
          data-day="{{item.day}}"
          data-date="{{item.date}}"
        >
          <text class="day-name">周{{item.dayName}}</text>
          <text class="day-number">{{item.day}}</text>
          <text class="day-courses" wx:if="{{item.courseCount > 0}}">{{item.courseCount}}节课</text>
        </view>
      </block>
    </view>

    <view class="selected-day-courses" wx:if="{{selectedDay && filteredCourses.length > 0}}">
      <text class="section-subtitle">{{selectedDateText}}课程</text>
      <block wx:for="{{filteredCourses}}" wx:key="_id">
        <view class="course-card">
          <view class="course-header" bindtap="toggleExpand" data-id="{{item._id}}">
            <view class="course-time">
              <text class="course-start">{{item.startTime}}</text>
              <text class="course-end">{{item.endTime}}</text>
            </view>
            <view class="course-type-icon-wrap">
              <icon name="{{item.iconName || 'book'}}" color="#12B7A8" size="32rpx"/>
            </view>
            <view class="course-info">
              <text class="course-name">{{item.title}}</text>
              <view class="course-student" wx:if="{{item.studentName}}">
                <icon name="user" color="#12B7A8" size="22rpx"/>
                <text class="course-student-text">{{item.studentName}}</text>
              </view>
              <view class="course-meta">
                <text class="meta-item">{{item.date}}</text>
                <text class="meta-item">{{item.duration}}</text>
                <view class="status-badge {{item.status === '已完成' ? 'status-completed' : 'status-pending'}}">
                  <text>{{item.status}}</text>
                </view>
              </view>
              <text class="course-desc" wx:if="{{item.description}}">{{item.description}}</text>
            </view>
            <view class="expand-icon" wx:if="{{expandedCourse === item._id}}">
              <icon name="chevron-up" color="#8E8E93" size="32rpx"/>
            </view>
            <view class="expand-icon" wx:else>
              <icon name="chevron-down" color="#8E8E93" size="32rpx"/>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 月视图 -->
  <view class="month-view" wx:if="{{viewMode === 'month'}}">
    <view class="month-grid">
      <view class="month-header">
        <text class="month-day-name" wx:for="{{dayNames}}" wx:key="index">{{item}}</text>
      </view>
      <view class="month-days">
        <block wx:for="{{monthDays}}" wx:key="index">
          <view
            class="month-day {{item.day ? '' : 'empty'}} {{selectedDay === item.day ? 'selected' : ''}} {{item.isToday ? 'today' : ''}} {{item.courseCount > 0 ? 'has-courses' : ''}}"
            bindtap="selectDay"
            data-day="{{item.day}}"
            data-date="{{item.date}}"
            wx:if="{{item}}"
          >
            <text class="day-number">{{item.day}}</text>
            <view class="day-dot" wx:if="{{item.courseCount > 0}}"></view>
          </view>
          <view class="month-day empty" wx:else></view>
        </block>
      </view>
    </view>

    <view class="selected-day-courses" wx:if="{{selectedDay && filteredCourses.length > 0}}">
      <text class="section-subtitle">{{selectedDateText}}课程</text>
      <block wx:for="{{filteredCourses}}" wx:key="_id">
        <view class="course-card">
          <view class="course-header" bindtap="toggleExpand" data-id="{{item._id}}">
            <view class="course-type-icon-wrap">
              <icon name="{{item.iconName || 'book'}}" color="#12B7A8" size="32rpx"/>
            </view>
            <view class="course-info">
              <text class="course-name">{{item.title}}</text>
              <view class="course-student" wx:if="{{item.studentName}}">
                <icon name="user" color="#12B7A8" size="22rpx"/>
                <text class="course-student-text">{{item.studentName}}</text>
              </view>
              <view class="course-meta">
                <text class="meta-item">{{item.date}} {{item.startTime}}-{{item.endTime}}</text>
                <text class="meta-item">{{item.duration}}</text>
                <view class="status-badge {{item.status === '已完成' ? 'status-completed' : 'status-pending'}}">
                  <text>{{item.status}}</text>
                </view>
              </view>
              <text class="course-desc" wx:if="{{item.description}}">{{item.description}}</text>
            </view>
            <view class="expand-icon" wx:if="{{expandedCourse === item._id}}">
              <icon name="chevron-up" color="#8E8E93" size="32rpx"/>
            </view>
            <view class="expand-icon" wx:else>
              <icon name="chevron-down" color="#8E8E93" size="32rpx"/>
            </view>
          </view>
        </view>
      </block>
    </view>
  </view>

  <!-- 成功提示：薄荷绿对勾 -->
  <view class="success-toast-overlay" wx:if="{{showSuccessToast}}">
    <view class="success-toast-card">
      <icon name="check-circle" color="#12B7A8" size="96rpx"/>
      <text class="success-toast-text">{{successToastText}}</text>
    </view>
  </view>
</view>
