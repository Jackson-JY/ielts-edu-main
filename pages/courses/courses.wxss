/* pages/courses/courses.wxss */

.page {
  background: #FFF9F5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* 顶部标题 */
.header {
  padding: 36rpx 32rpx 20rpx;
  border-bottom: 1rpx solid rgba(154, 151, 170, 0.2);
}

.title {
  font-size: 36rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
  margin-bottom: 24rpx;
}

/* 视图切换按钮 */
.view-mode-switch {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(154, 151, 170, 0.2);
}

.mode-btn {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 24rpx;
  text-align: center;
  font-size: 28rpx;
  background: #F5F0FF;
  color: #4A4A4A;
  border: none;
}

.mode-btn.active {
  background: #A7FBF5;
}

.mode-btn::after {
  border: none;
}

/* 日期导航 */
.date-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(154, 151, 170, 0.2);
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: #F5F0FF;
}

.arrow {
  font-size: 36rpx;
  color: #4A4A4A;
  font-weight: bold;
}

.date-text {
  font-size: 28rpx;
  color: #4A4A4A;
  font-weight: 600;
}

/* 课程列表 */
.course-list {
  flex: 1;
  padding: 24rpx 32rpx;
}

.course-card {
  background: #F5F0FF;
  border-radius: 44rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.course-header {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
}

.course-info {
  flex: 1;
}

.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
  margin-bottom: 12rpx;
}

.course-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #9A97AA;
}

.status-badge {
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
}

.status-completed {
  background: #A7FBF5;
  color: #4A4A4A;
}

.status-pending {
  background: #E8D4F8;
  color: #4A4A4A;
}

.expand-icon {
  font-size: 32rpx;
  color: #9A97AA;
  margin-left: 16rpx;
}

/* 作业区域 */
.homework-section {
  padding: 0 32rpx 32rpx;
}

.homework-form {
  background: #FFF9F5;
  border-radius: 24rpx;
  padding: 24rpx;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  font-size: 28rpx;
  color: #4A4A4A;
  border: none;
}

.form-textarea {
  width: 100%;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  font-size: 28rpx;
  color: #4A4A4A;
  min-height: 200rpx;
  border: none;
}

.save-button {
  width: 100%;
  padding: 24rpx 0;
  background: #A7FBF5;
  border-radius: 60rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A4A;
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #9A97AA;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #9A97AA;
  margin-bottom: 48rpx;
}

.empty-button {
  padding: 24rpx 64rpx;
  background: #A7FBF5;
  border-radius: 60rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A4A;
}

/* 周视图 */
.week-view {
  flex: 1;
  padding: 24rpx 32rpx;
}

.week-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.week-day {
  padding: 16rpx 8rpx;
  border-radius: 24rpx;
  text-align: center;
  background: #F5F0FF;
  border: none;
}

.week-day.today {
  background: #E8D4F8;
}

.week-day.selected {
  background: #A7FBF5;
}

.day-name {
  font-size: 20rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 8rpx;
}

.day-number {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
  margin-bottom: 8rpx;
}

.day-courses {
  font-size: 20rpx;
  color: #E8D4F8;
}

.week-day.selected .day-courses {
  color: #4A4A4A;
}

/* 月视图 */
.month-view {
  flex: 1;
  padding: 24rpx 32rpx;
}

.month-grid {
  margin-bottom: 32rpx;
}

.month-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.month-day-name {
  text-align: center;
  font-size: 24rpx;
  color: #9A97AA;
  padding: 8rpx 0;
}

.month-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.month-day {
  aspect-ratio: 1;
  padding: 8rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
}

.month-day.has-courses {
  background: #F5F0FF;
}

.month-day.today {
  background: #E8D4F8;
}

.month-day.selected {
  background: #A7FBF5;
}

.month-day.empty {
  background: transparent;
}

.day-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #E8D4F8;
  margin-top: 8rpx;
}

.month-day.selected .day-dot {
  background: #4A4A4A;
}

/* 选中日期的课程列表 */
.selected-day-courses {
  margin-top: 32rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 24rpx;
}

.course-card.compact {
  padding: 24rpx;
  margin-bottom: 16rpx;
}
