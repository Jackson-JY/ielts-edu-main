/* pages/courses/courses.wxss */

.page {
  background: #F6F8FB;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  width: 100vw;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 顶部标题 */
.header {
  padding: 40rpx 32rpx 20rpx;
}

.title {
  font-size: 38rpx;
  font-weight: 800;
  color: #17212B;
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: 0;
}

/* 视图切换按钮 */
.view-mode-switch {
  display: flex;
  gap: 8rpx;
  padding: 8rpx;
  margin: 0 32rpx 20rpx;
  border-radius: 18rpx;
  background: #EAF0F5;
}

.mode-btn {
  flex: 1;
  min-height: 64rpx;
  padding: 14rpx 0;
  border-radius: 14rpx;
  text-align: center;
  font-size: 28rpx;
  background: transparent;
  color: #64717F;
  border: none;
  box-shadow: none;
  transition: all 0.2s ease;
}

.mode-btn.active {
  background: #FFFFFF;
  color: #12B7A8;
  font-weight: 700;
  box-shadow: 0 4rpx 14rpx rgba(23, 33, 43, 0.07);
}

.mode-btn::after {
  border: none;
}

/* 日期导航 */
.date-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 32rpx 24rpx;
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
  box-shadow: 0 6rpx 18rpx rgba(23, 33, 43, 0.04);
  transition: all 0.2s ease;
}

.nav-btn:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(154, 151, 170, 0.08);
}

.arrow {
  font-size: 36rpx;
  color: #17212B;
  font-weight: bold;
}

.date-text {
  font-size: 28rpx;
  color: #17212B;
  font-weight: 700;
}

/* 日视图 */
.day-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
}

/* 课程列表 */
.course-list {
  flex: 1;
  padding: 8rpx 32rpx 32rpx;
  box-sizing: border-box;
  width: 100%;
}

.course-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
  box-shadow: 0 10rpx 28rpx rgba(23, 33, 43, 0.05);
  position: relative;
}

.course-card::before {
  display: none;
}

.course-header {
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  width: 100%;
}

.course-time {
  width: 84rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.course-start {
  font-size: 28rpx;
  font-weight: 800;
  color: #17212B;
  line-height: 1.1;
}

.course-end {
  font-size: 22rpx;
  color: #7A8794;
}

.course-type-icon {
  width: 52rpx;
  height: 52rpx;
  border-radius: 16rpx;
  background: rgba(18, 183, 168, 0.08);
  padding: 10rpx;
  box-shadow: none;
  flex-shrink: 0;
}

.course-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #17212B;
  display: block;
  margin-bottom: 10rpx;
  word-wrap: break-word;
  word-break: break-all;
}

.course-desc {
  font-size: 24rpx;
  color: #7A8794;
  margin-top: 8rpx;
  line-height: 1.4;
}

.course-student {
  font-size: 22rpx;
  color: #12B7A8;
  font-weight: 700;
  margin-top: 8rpx;
  line-height: 1.4;
}

.course-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.meta-item {
  font-size: 24rpx;
  color: #7A8794;
}

.status-badge {
  padding: 6rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 700;
  box-shadow: none;
}

.status-completed {
  background: rgba(18, 183, 168, 0.1);
  color: #087C72;
}

.status-pending {
  background: #FFF7E8;
  color: #B45309;
}

.expand-icon {
  font-size: 32rpx;
  color: #A6B0BB;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 作业区域 */
.homework-section {
  padding: 0 32rpx 32rpx;
}

.homework-form {
  background: #F8FAFC;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
  box-shadow: none;
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 24rpx;
  color: #64717F;
  display: block;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  font-size: 28rpx;
  color: #17212B;
  border: none;
  box-shadow: none;
  box-sizing: border-box;
}

.form-textarea {
  width: 100%;
  padding: 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  font-size: 28rpx;
  color: #17212B;
  min-height: 200rpx;
  border: none;
  box-shadow: none;
  box-sizing: border-box;
}

/* Picker 选择器样式 */
.form-picker {
  width: 100%;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  font-size: 28rpx;
  color: #17212B;
  display: flex;
  justify-content: space-between;
  align-items: center;
  box-shadow: none;
  box-sizing: border-box;
}
.picker-arrow {
  font-size: 32rpx;
  color: #A6B0BB;
}

.save-button {
  width: 100%;
  padding: 24rpx 0;
  background: #12B7A8;
  border-radius: 18rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(18, 183, 168, 0.22);
  transition: all 0.2s ease;
}

.save-button:active {
  transform: translateY(2rpx);
  box-shadow: 0 4rpx 12rpx rgba(18, 183, 168, 0.18);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #64717F;
}

/* 周视图 */
.week-view {
  flex: 1;
  padding: 24rpx 32rpx;
}

.week-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.week-day {
  padding: 16rpx 8rpx;
  border-radius: 18rpx;
  text-align: center;
  background: #FFFFFF;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
  box-shadow: 0 6rpx 18rpx rgba(23, 33, 43, 0.04);
  transition: all 0.2s ease;
}

.week-day:active {
  transform: scale(0.95);
}

.week-day.today {
  background: #ECFFFC;
  border-color: rgba(18, 183, 168, 0.28);
  box-shadow: 0 6rpx 18rpx rgba(18, 183, 168, 0.08);
}

.week-day.selected {
  background: #12B7A8;
  border-color: #12B7A8;
  box-shadow: 0 10rpx 24rpx rgba(18, 183, 168, 0.22);
}

.day-name {
  font-size: 20rpx;
  color: #7A8794;
  display: block;
  margin-bottom: 8rpx;
}

.day-number {
  font-size: 32rpx;
  font-weight: 600;
  color: #17212B;
  display: block;
  margin-bottom: 8rpx;
}

.day-courses {
  font-size: 20rpx;
  color: #12B7A8;
}

.week-day.selected .day-name,
.week-day.selected .day-number,
.week-day.selected .day-courses {
  color: #FFFFFF;
}

/* 月视图 */
.month-view {
  flex: 1;
  padding: 24rpx 32rpx;
}

.month-grid {
  margin-bottom: 32rpx;
}

.month-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.month-day-name {
  text-align: center;
  font-size: 24rpx;
  color: #7A8794;
  padding: 8rpx 0;
}

.month-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.month-day {
  aspect-ratio: 1;
  padding: 8rpx;
  border-radius: 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  transition: all 0.2s ease;
}

.month-day:active {
  transform: scale(0.92);
}

.month-day.has-courses {
  background: #FFFFFF;
  box-shadow: 0 6rpx 18rpx rgba(23, 33, 43, 0.04);
}

.month-day.today {
  background: #ECFFFC;
  box-shadow: 0 6rpx 18rpx rgba(18, 183, 168, 0.08);
}

.month-day.selected {
  background: #12B7A8;
  box-shadow: 0 10rpx 24rpx rgba(18, 183, 168, 0.22);
}

.month-day.empty {
  background: transparent;
}

.day-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #12B7A8;
  margin-top: 8rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.1);
}

.month-day.selected .day-dot {
  background: #FFFFFF;
}

/* 选中日期的课程列表 */
.selected-day-courses {
  margin-top: 32rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #64717F;
  display: block;
  margin-bottom: 24rpx;
}

.course-card.compact {
  padding: 24rpx;
  margin-bottom: 16rpx;
}

.compact-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 12rpx;
}

.course-type-icon-small {
  width: 48rpx;
  height: 48rpx;
  border-radius: 12rpx;
  background: rgba(18, 183, 168, 0.08);
  padding: 6rpx;
  box-shadow: none;
  flex-shrink: 0;
}
