/* pages/courses/courses.wxss */

.page {
  background: linear-gradient(180deg, #FFF9F5 0%, #FFF5F0 100%);
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  width: 100vw;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 顶部标题 */
.header {
  padding: 36rpx 32rpx 20rpx;
  border-bottom: 1rpx solid rgba(154, 151, 170, 0.15);
}

.title {
  font-size: 38rpx;
  font-weight: 700;
  color: #4A4A4A;
  display: block;
  margin-bottom: 24rpx;
  letter-spacing: 1rpx;
}

/* 视图切换按钮 */
.view-mode-switch {
  display: flex;
  gap: 16rpx;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(154, 151, 170, 0.15);
}

.mode-btn {
  flex: 1;
  padding: 16rpx 0;
  border-radius: 24rpx;
  text-align: center;
  font-size: 28rpx;
  background: linear-gradient(180deg, #F8F4FF 0%, #F0E8FF 100%);
  color: #4A4A4A;
  border: none;
  box-shadow: 0 2rpx 8rpx rgba(154, 151, 170, 0.1);
  transition: all 0.2s ease;
}

.mode-btn.active {
  background: linear-gradient(180deg, #B8FFF7 0%, #A7FBF5 50%, #96F0E8 100%);
  box-shadow: 0 4rpx 12rpx rgba(167, 251, 245, 0.4);
}

.mode-btn::after {
  border: none;
}

/* 日期导航 */
.date-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  border-bottom: 1rpx solid rgba(154, 151, 170, 0.15);
}

.nav-btn {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  background: linear-gradient(180deg, #F8F4FF 0%, #F0E8FF 100%);
  box-shadow: 0 2rpx 8rpx rgba(154, 151, 170, 0.1);
  transition: all 0.2s ease;
}

.nav-btn:active {
  transform: scale(0.95);
  box-shadow: 0 1rpx 4rpx rgba(154, 151, 170, 0.08);
}

.arrow {
  font-size: 36rpx;
  color: #4A4A4A;
  font-weight: bold;
}

.date-text {
  font-size: 28rpx;
  color: #4A4A4A;
  font-weight: 600;
}

/* 日视图 */
.day-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
}

/* 课程列表 */
.course-list {
  flex: 1;
  padding: 24rpx 32rpx;
  box-sizing: border-box;
  width: 100%;
}

.course-card {
  background: linear-gradient(145deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 44rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
  width: 100%;
  box-sizing: border-box;
  box-shadow: 
    0 4rpx 20rpx rgba(154, 151, 170, 0.15),
    0 1rpx 3rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  position: relative;
}

.course-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
}

.course-header {
  padding: 32rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  box-sizing: border-box;
  width: 100%;
}

.course-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
  margin-bottom: 12rpx;
  word-wrap: break-word;
  word-break: break-all;
}

.course-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  flex-wrap: wrap;
}

.meta-item {
  font-size: 24rpx;
  color: #9A97AA;
}

.status-badge {
  padding: 4rpx 16rpx;
  border-radius: 12rpx;
  font-size: 22rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.05);
}

.status-completed {
  background: linear-gradient(180deg, #B8FFF7 0%, #A7FBF5 100%);
  color: #4A4A4A;
}

.status-pending {
  background: linear-gradient(180deg, #F0D8FA 0%, #E8D4F8 100%);
  color: #4A4A4A;
}

.expand-icon {
  font-size: 32rpx;
  color: #9A97AA;
  margin-left: 16rpx;
  flex-shrink: 0;
}

/* 作业区域 */
.homework-section {
  padding: 0 32rpx 32rpx;
}

.homework-form {
  background: linear-gradient(145deg, #FFFDFB 0%, #FFF9F5 100%);
  border-radius: 24rpx;
  padding: 24rpx;
  box-shadow: 
    0 2rpx 12rpx rgba(154, 151, 170, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
}

.form-group {
  margin-bottom: 24rpx;
}

.form-label {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 12rpx;
}

.form-input {
  width: 100%;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  font-size: 28rpx;
  color: #4A4A4A;
  border: none;
  box-shadow: inset 0 1rpx 3rpx rgba(0,0,0,0.05);
}

.form-textarea {
  width: 100%;
  padding: 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  font-size: 28rpx;
  color: #4A4A4A;
  min-height: 200rpx;
  border: none;
  box-shadow: inset 0 1rpx 3rpx rgba(0,0,0,0.05);
}

.save-button {
  width: 100%;
  padding: 24rpx 0;
  background: linear-gradient(180deg, #B8FFF7 0%, #A7FBF5 50%, #96F0E8 100%);
  border-radius: 60rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A4A;
  box-shadow: 
    0 4rpx 12rpx rgba(167, 251, 245, 0.4),
    0 2rpx 4rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  transition: all 0.2s ease;
}

.save-button:active {
  transform: translateY(2rpx);
  box-shadow: 
    0 2rpx 6rpx rgba(167, 251, 245, 0.3),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.4);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
}

.empty-text {
  font-size: 28rpx;
  color: #9A97AA;
  margin-bottom: 16rpx;
}

.empty-sub {
  font-size: 24rpx;
  color: #9A97AA;
  margin-bottom: 48rpx;
}

.empty-button {
  padding: 24rpx 64rpx;
  background: linear-gradient(180deg, #B8FFF7 0%, #A7FBF5 50%, #96F0E8 100%);
  border-radius: 60rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #4A4A4A;
  box-shadow: 
    0 4rpx 12rpx rgba(167, 251, 245, 0.4),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

/* 周视图 */
.week-view {
  flex: 1;
  padding: 24rpx 32rpx;
}

.week-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 12rpx;
  margin-bottom: 32rpx;
}

.week-day {
  padding: 16rpx 8rpx;
  border-radius: 24rpx;
  text-align: center;
  background: linear-gradient(180deg, #F8F4FF 0%, #F0E8FF 100%);
  border: none;
  box-shadow: 0 2rpx 8rpx rgba(154, 151, 170, 0.08);
  transition: all 0.2s ease;
}

.week-day:active {
  transform: scale(0.95);
}

.week-day.today {
  background: linear-gradient(180deg, #F0D8FA 0%, #E8D4F8 100%);
  box-shadow: 0 2rpx 12rpx rgba(232, 212, 248, 0.3);
}

.week-day.selected {
  background: linear-gradient(180deg, #B8FFF7 0%, #A7FBF5 100%);
  box-shadow: 0 4rpx 16rpx rgba(167, 251, 245, 0.4);
}

.day-name {
  font-size: 20rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 8rpx;
}

.day-number {
  font-size: 32rpx;
  font-weight: 600;
  color: #4A4A4A;
  display: block;
  margin-bottom: 8rpx;
}

.day-courses {
  font-size: 20rpx;
  color: #E8D4F8;
}

.week-day.selected .day-courses {
  color: #4A4A4A;
}

/* 月视图 */
.month-view {
  flex: 1;
  padding: 24rpx 32rpx;
}

.month-grid {
  margin-bottom: 32rpx;
}

.month-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.month-day-name {
  text-align: center;
  font-size: 24rpx;
  color: #9A97AA;
  padding: 8rpx 0;
}

.month-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.month-day {
  aspect-ratio: 1;
  padding: 8rpx;
  border-radius: 24rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: none;
  background: transparent;
  transition: all 0.2s ease;
}

.month-day:active {
  transform: scale(0.92);
}

.month-day.has-courses {
  background: linear-gradient(180deg, #F8F4FF 0%, #F0E8FF 100%);
  box-shadow: 0 2rpx 8rpx rgba(154, 151, 170, 0.08);
}

.month-day.today {
  background: linear-gradient(180deg, #F0D8FA 0%, #E8D4F8 100%);
  box-shadow: 0 2rpx 12rpx rgba(232, 212, 248, 0.3);
}

.month-day.selected {
  background: linear-gradient(180deg, #B8FFF7 0%, #A7FBF5 100%);
  box-shadow: 0 4rpx 16rpx rgba(167, 251, 245, 0.4);
}

.month-day.empty {
  background: transparent;
}

.day-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(180deg, #F0D8FA 0%, #E8D4F8 100%);
  margin-top: 8rpx;
  box-shadow: 0 1rpx 3rpx rgba(0,0,0,0.1);
}

.month-day.selected .day-dot {
  background: #4A4A4A;
}

/* 选中日期的课程列表 */
.selected-day-courses {
  margin-top: 32rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #9A97AA;
  display: block;
  margin-bottom: 24rpx;
}

.course-card.compact {
  padding: 24rpx;
  margin-bottom: 16rpx;
}
