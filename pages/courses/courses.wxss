/* pages/courses/courses.wxss */

.page {
  background: #F5F5F7;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  width: 100vw;
  box-sizing: border-box;
  overflow-x: hidden;
}

/* 顶部标题 */
.header {
  padding: 32rpx 32rpx 16rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1D1D1F;
  display: block;
  margin-bottom: 20rpx;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

/* 视图切换：胶囊形 Segmented Control */
.view-mode-switch {
  display: flex;
  gap: 4rpx;
  padding: 4rpx;
  margin: 0 32rpx 20rpx;
  border-radius: 999px;
  background: #F2F2F7;
}

.mode-btn {
  flex: 1;
  min-height: 64rpx;
  line-height: 64rpx;
  border-radius: 999px;
  text-align: center;
  font-size: 28rpx;
  background: transparent;
  color: #6E6E73;
  font-weight: 500;
  transition: all 0.18s ease;
}

.mode-btn.active {
  background: #FFFFFF;
  color: #1D1D1F;
  font-weight: 600;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
}

.mode-btn::after {
  border: none;
}

/* 日期导航 */
.date-nav {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 8rpx 32rpx 24rpx;
}

.nav-btn {
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  transition: filter 0.18s ease;
}

.nav-btn:active {
  filter: brightness(0.96);
  background: #F2F2F7;
}

.date-text {
  font-size: 28rpx;
  color: #1D1D1F;
  font-weight: 600;
  letter-spacing: -0.01em;
}

/* 日视图 */
.day-view {
  flex: 1;
  display: flex;
  flex-direction: column;
  width: 100%;
  box-sizing: border-box;
}

.course-list {
  flex: 1;
  padding: 8rpx 32rpx 32rpx;
  box-sizing: border-box;
  width: 100%;
}

.course-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 16rpx;
  width: 100%;
  box-sizing: border-box;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  position: relative;
}

.course-card::before {
  display: none;
}

.course-header {
  padding: 28rpx;
  display: flex;
  align-items: center;
  gap: 18rpx;
  box-sizing: border-box;
  width: 100%;
}

.course-time {
  width: 84rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  gap: 4rpx;
}

.course-start {
  font-size: 30rpx;
  font-weight: 700;
  color: #1D1D1F;
  line-height: 1.1;
  letter-spacing: -0.01em;
}

.course-end {
  font-size: 22rpx;
  color: #8E8E93;
}

.course-type-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #E6F7F5;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.course-info {
  flex: 1;
  min-width: 0;
  overflow: hidden;
}

.course-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
  margin-bottom: 8rpx;
  word-wrap: break-word;
  word-break: break-all;
  letter-spacing: -0.01em;
}

.course-desc {
  font-size: 24rpx;
  color: #6E6E73;
  margin-top: 8rpx;
  line-height: 1.4;
}

.course-student {
  display: flex;
  align-items: center;
  gap: 6rpx;
  margin-top: 6rpx;
}

.course-student-text {
  font-size: 22rpx;
  color: #12B7A8;
  font-weight: 500;
}

.course-meta {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
  margin-top: 8rpx;
}

.meta-item {
  font-size: 24rpx;
  color: #8E8E93;
}

.status-badge {
  padding: 4rpx 16rpx;
  border-radius: 999px;
  font-size: 22rpx;
  font-weight: 500;
}

.status-completed {
  background: #E6F7F5;
  color: #0E8C81;
}

.status-pending {
  background: #FFF7E8;
  color: #B45309;
}

.expand-icon {
  margin-left: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 作业区域 */
.homework-section {
  padding: 0 32rpx 32rpx;
}

.homework-form {
  background: #F8F8FA;
  border-radius: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #E5E5EA;
}

.hw-items-header {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
  padding: 0 4rpx;
}

.hw-col-content {
  flex: 1;
  min-width: 0;
  font-size: 22rpx;
  color: #8E8E93;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.hw-col-time {
  width: 180rpx;
  flex-shrink: 0;
  font-size: 22rpx;
  color: #8E8E93;
  text-align: center;
  text-transform: uppercase;
  letter-spacing: 0.06em;
}

.hw-item-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-bottom: 14rpx;
}

.hw-item-content {
  flex: 1;
  min-width: 0;
  height: 84rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  font-size: 28rpx;
  color: #1D1D1F;
  box-sizing: border-box;
}

.hw-item-time {
  width: 180rpx;
  flex-shrink: 0;
  height: 84rpx;
  padding: 0 16rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  font-size: 28rpx;
  color: #1D1D1F;
  text-align: center;
  box-sizing: border-box;
}

.hw-item-del {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: filter 0.18s ease;
}

.hw-item-del:active {
  filter: brightness(0.95);
  background: #E5E5EA;
}

.hw-add-row {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  margin: 4rpx 0 24rpx;
  padding: 18rpx 0;
  border-radius: 16rpx;
  border: 1rpx dashed #12B7A8;
  color: #12B7A8;
  font-size: 26rpx;
  font-weight: 500;
  background: #E6F7F5;
  transition: filter 0.18s ease;
}

.hw-add-row:active {
  filter: brightness(0.96);
}

.save-button {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #12B7A8;
  border-radius: 999px;
  text-align: center;
  font-size: 30rpx;
  font-weight: 600;
  color: #FFFFFF;
  transition: filter 0.18s ease;
}

.save-button:active {
  filter: brightness(0.92);
}

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 120rpx 0;
  gap: 16rpx;
}

.empty-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 28rpx;
  color: #8E8E93;
}

/* 周视图 */
.week-view {
  flex: 1;
  padding: 0 32rpx 32rpx;
}

.week-grid {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 32rpx;
}

.week-day {
  padding: 16rpx 4rpx;
  border-radius: 16rpx;
  text-align: center;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  transition: filter 0.18s ease;
}

.week-day:active {
  filter: brightness(0.97);
}

.week-day.today {
  background: #E6F7F5;
  border-color: #80DED5;
}

.week-day.selected {
  background: #12B7A8;
  border-color: #12B7A8;
}

.day-name {
  font-size: 20rpx;
  color: #8E8E93;
  display: block;
  margin-bottom: 6rpx;
}

.day-number {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  display: block;
  margin-bottom: 6rpx;
}

.day-courses {
  font-size: 20rpx;
  color: #12B7A8;
}

.week-day.today .day-number {
  color: #0E8C81;
}

.week-day.selected .day-name,
.week-day.selected .day-number,
.week-day.selected .day-courses {
  color: #FFFFFF;
}

/* 月视图 */
.month-view {
  flex: 1;
  padding: 0 32rpx 32rpx;
}

.month-grid {
  margin-bottom: 32rpx;
}

.month-header {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
  margin-bottom: 12rpx;
}

.month-day-name {
  text-align: center;
  font-size: 22rpx;
  color: #8E8E93;
  padding: 8rpx 0;
  font-weight: 500;
}

.month-days {
  display: grid;
  grid-template-columns: repeat(7, 1fr);
  gap: 8rpx;
}

.month-day {
  aspect-ratio: 1;
  padding: 8rpx;
  border-radius: 50%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  background: transparent;
  transition: filter 0.18s ease;
}

.month-day:active {
  filter: brightness(0.97);
}

.month-day.has-courses {
  background: #FFFFFF;
}

.month-day.today {
  background: #E6F7F5;
}

.month-day.selected {
  background: #12B7A8;
}

.month-day.empty {
  background: transparent;
}

.day-dot {
  width: 8rpx;
  height: 8rpx;
  border-radius: 50%;
  background: #12B7A8;
  margin-top: 4rpx;
}

.month-day.selected .day-dot {
  background: #FFFFFF;
}

/* 选中日期的课程列表 */
.selected-day-courses {
  margin-top: 32rpx;
}

.section-subtitle {
  font-size: 24rpx;
  color: #6E6E73;
  display: block;
  margin-bottom: 20rpx;
  font-weight: 500;
}

/* 成功提示 */
.success-toast-overlay {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.2);
}

.success-toast-card {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
  padding: 48rpx 56rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  box-shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.12);
  animation: success-in 0.25s ease-out;
}

.success-toast-text {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
}

@keyframes success-in {
  0% { opacity: 0; transform: scale(0.92); }
  100% { opacity: 1; transform: scale(1); }
}
