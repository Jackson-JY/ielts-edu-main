<!--pages/homework/homework.wxml - 作业页面（听说读写四模块）-->
<view class="page">

  <!-- Header -->
  <view class="header">
    <text class="title">作业</text>
    <text class="subtitle" wx:if="{{!activeSubject}}">选择一个模块，查看对应作业</text>
  </view>

  <!-- 听说读写模块宫格 -->
  <view class="subject-grid" wx:if="{{!activeSubject}}">
    <view class="subject-module-item"
          wx:for="{{subjectModules}}"
          wx:key="id"
          data-id="{{item.id}}"
          data-label="{{item.label}}"
          bindtap="onTapSubjectModule">
      <view class="subject-module-top">
        <view class="subject-module-icon-wrap">
          <icon name="{{item.iconName}}" color="#12B7A8" size="36rpx"/>
        </view>
        <view class="subject-module-arrow-wrap">
          <icon name="chevron-right" color="#8E8E93" size="28rpx"/>
        </view>
      </view>
      <text class="subject-module-label">{{item.label}}</text>
      <text class="subject-module-count" wx:if="{{item.total > 0}}">{{item.completed}}/{{item.total}} 已完成</text>
      <text class="subject-module-count" wx:else>暂无作业</text>
      <view class="subject-module-progress" wx:if="{{item.total > 0}}">
        <view class="subject-module-progress-fill" style="width: {{item.progress}}%;"></view>
      </view>
    </view>
  </view>

  <!-- 我的任务区域 -->
  <view class="task-section" wx:if="{{!activeSubject}}">
    <view class="task-section-header">
      <view class="task-section-titles">
        <text class="task-section-title">我的任务</text>
        <text class="task-section-sub">自己安排的小目标，完成即勾选</text>
      </view>
      <view class="task-add-btn" bindtap="onTapAddTask">
        <icon name="plus" color="#FFFFFF" size="24rpx"/>
        <text>添加</text>
      </view>
    </view>

    <view class="task-list" wx:if="{{tasks.length > 0}}">
      <view class="task-item {{item.isCompleted ? 'task-item-done' : ''}}"
            wx:for="{{tasks}}"
            wx:key="id">
        <!-- 勾选：未完成空心圆，已完成薄荷绿填充 + 白对勾 -->
        <view class="task-check {{item.isCompleted ? 'checked' : ''}}"
              data-id="{{item.id}}"
              data-completed="{{item.isCompleted}}"
              catchtap="onToggleTaskComplete">
          <icon wx:if="{{item.isCompleted}}" name="check" color="#FFFFFF" size="24rpx"/>
        </view>
        <!-- 内容 -->
        <view class="task-body">
          <text class="task-content">{{item.content}}</text>
          <view class="task-meta">
            <text class="task-duration {{item.timeSpent > 0 ? 'spent' : ''}}">{{item.duration}} 分钟</text>
            <text class="task-duration-label">{{item.durationLabel}}</text>
          </view>
        </view>
        <!-- 专注 + 删除 -->
        <view class="task-actions">
          <view class="task-focus-btn"
                data-id="{{item.id}}"
                data-content="{{item.content}}"
                catchtap="onTapStartTaskPomodoro">
            <icon name="clock" color="#12B7A8" size="22rpx"/>
            <text>专注</text>
          </view>
          <view class="task-del-btn" data-id="{{item.id}}" catchtap="onTapDeleteTask">
            <icon name="trash" color="#8E8E93" size="24rpx"/>
          </view>
        </view>
      </view>
    </view>

    <view class="task-empty" wx:else>
      <view class="task-empty-icon-wrap">
        <icon name="check-circle" color="#8E8E93" size="48rpx"/>
      </view>
      <text class="task-empty-text">暂无任务，点击添加</text>
    </view>
  </view>

  <!-- 模块作业明细列表 -->
  <view class="subject-detail" wx:if="{{activeSubject}}">
    <view class="detail-header">
      <view class="back-btn" bindtap="onBackToModules">
        <icon name="chevron-left" color="#1D1D1F" size="28rpx"/>
        <text>返回</text>
      </view>
      <text class="detail-title">{{activeSubjectLabel}}作业</text>
      <text class="detail-count">共 {{activeSubjectItems.length}} 项</text>
    </view>

    <view class="detail-list" wx:if="{{activeSubjectItems.length > 0}}">
      <view class="detail-item {{item.isCompleted ? 'detail-item-completed' : ''}}"
            wx:for="{{activeSubjectItems}}"
            wx:key="id"
            data-id="{{item.id}}"
            bindtap="onHomeworkTap">
        <!-- 左栏：作业内容 -->
        <view class="detail-col detail-col-left">
          <view class="detail-student" wx:if="{{item.studentName}}">
            <icon name="user" color="#12B7A8" size="20rpx"/>
            <text class="detail-student-text">{{item.studentName}}</text>
          </view>
          <text class="detail-content">{{item.content}}</text>
          <view class="detail-tags" wx:if="{{item.courseName}}">
            <text class="detail-tag">{{item.courseName}}</text>
          </view>
        </view>

        <!-- 右栏：时长 / 完成度 / 打卡选项 / 番茄按钮 -->
        <view class="detail-col detail-col-right">
          <view class="detail-duration">
            <text class="detail-duration-value {{item.timeSpent > 0 ? 'spent' : ''}}">{{item.duration}}</text>
            <text class="detail-duration-unit">分钟</text>
          </view>
          <text class="detail-duration-label">{{item.durationLabel}}</text>
          <view class="detail-progress-wrap">
            <view class="detail-progress-track">
              <view class="detail-progress-fill" style="width: {{item.completion}}%;"></view>
            </view>
            <text class="detail-progress-text">完成度 {{item.completion}}%</text>
          </view>

          <!-- 打卡按钮行：仅本人作业可操作（管理员对自己名下作业同样开放） -->
          <view class="detail-actions-row" wx:if="{{item.isMine}}">
            <view class="detail-checkin {{item.isCompleted ? 'checked' : ''}}"
                  data-id="{{item.id}}"
                  data-completed="{{item.isCompleted}}"
                  catchtap="onToggleHomeworkComplete">
              <icon wx:if="{{item.isCompleted}}" name="check" color="#0E8C81" size="20rpx"/>
              <text wx:else>完成</text>
            </view>
            <!-- 专注按钮 -->
            <view class="detail-focus-btn"
                  data-id="{{item.id}}"
                  data-content="{{item.content}}"
                  data-subject="{{activeSubjectLabel}}"
                  catchtap="onTapStartPomodoro">
              <icon name="clock" color="#12B7A8" size="20rpx"/>
              <text>专注</text>
            </view>
          </view>
          <!-- 他人作业（管理员视角）：仅展示状态 -->
          <view class="detail-status-tag {{item.isCompleted ? 'completed' : ''}}" wx:else>
            <text>{{item.isCompleted ? '已完成' : '进行中'}}</text>
          </view>
        </view>
      </view>
    </view>

    <view class="empty-homework" wx:else>
      <view class="empty-icon-wrap">
        <icon name="book" color="#8E8E93" size="48rpx"/>
      </view>
      <text class="empty-text">该模块暂无作业</text>
    </view>
  </view>

  <!-- 添加任务弹窗 -->
  <view class="task-modal-overlay" wx:if="{{showTaskInput}}">
    <view class="task-modal-mask" bindtap="closeTaskInput"></view>
    <view class="task-modal-card">
      <text class="task-modal-title">添加任务</text>
      <text class="task-modal-label">任务信息</text>
      <textarea class="task-modal-textarea"
                placeholder="要做点什么呢"
                placeholder-class="task-modal-ph"
                value="{{taskInputContent}}"
                bindinput="onTaskInputContent"
                maxlength="200"
                auto-height
                show-confirm-bar="{{false}}" />
      <text class="task-modal-label">预估完成时间</text>
      <view class="task-modal-time">
        <input class="task-modal-time-input" type="number" placeholder="如 30"
               value="{{taskInputTime}}" bindinput="onTaskInputTime" />
        <text class="task-modal-time-unit">分钟</text>
      </view>
      <view class="task-modal-actions">
        <view class="task-modal-btn cancel" bindtap="closeTaskInput">取消</view>
        <view class="task-modal-btn confirm {{taskSubmitting ? 'disabled' : ''}}" bindtap="onConfirmAddTask">
          {{taskSubmitting ? '添加中' : '添加任务'}}
        </view>
      </view>
    </view>
  </view>

</view>

<!-- 番茄时钟组件（全局弹出，不在滚动容器内） -->
<pomodoro
  visible="{{showPomodoro}}"
  linkedHomeworkId="{{pomodoroHomeworkId}}"
  linkedContent="{{pomodoroHomeworkContent}}"
  linkedSubject="{{pomodoroHomeworkSubject}}"
  homeworkOptions="{{pomodoroHomeworkOptions}}"
  taskOptions="{{pomodoroTaskOptions}}"
  bind:close="onPomodoroClose"
  bind:sessionSaved="onPomodoroSessionSaved"
  bind:taskCreated="onPomodoroTaskCreated"
/>
