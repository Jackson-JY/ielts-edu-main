<!--pages/homework/homework.wxml - 作业页面-->
<view class="page">

  <!-- Header -->
  <view class="header">
    <text class="title" bindlongpress="onTitleLongPress">作业</text>
  </view>

  <!-- 未完成作业区域 -->
  <view class="section-card">
    <view class="section-header">
      <text class="section-title">📚 待完成作业</text>
      <text class="section-subtitle" wx:if="{{pendingHomework.length > 0}}">{{pendingHomework.length}} 个待完成</text>
      <text class="section-subtitle" wx:else>暂无待完成作业</text>
    </view>
    <view class="homework-list" wx:if="{{pendingHomework.length > 0}}">
      <view class="homework-item {{item.isOverdue ? 'homework-overdue' : ''}} {{item.isUrgent ? 'homework-urgent' : ''}}" wx:for="{{pendingHomework}}" wx:key="id" data-id="{{item.id}}" bindtap="onHomeworkTap">
        <view class="homework-main">
          <view class="homework-info">
            <text class="homework-title">{{item.title}}</text>
            <text class="homework-desc" wx:if="{{item.description}}">{{item.description}}</text>
            <text class="homework-course" wx:if="{{item.courseName}}">📖 {{item.courseName}}</text>
          </view>
          <view class="homework-meta">
            <view class="homework-subject">
              <text class="subject-tag">{{item.subjectLabel}}</text>
            </view>
            <view class="homework-deadline {{item.isOverdue ? 'deadline-overdue' : ''}} {{item.isUrgent ? 'deadline-urgent' : ''}}">
              <text class="deadline-icon">⏰</text>
              <text class="deadline-text">{{item.isOverdue ? '已逾期' : (item.daysLeft === 0 ? '今天截止' : item.daysLeft + '天后截止')}}</text>
            </view>
          </view>
        </view>
        <view class="homework-arrow">›</view>
      </view>
    </view>
    <view class="empty-homework" wx:else>
      <text class="empty-text">🎉 太棒了！当前没有待完成的作业</text>
    </view>
  </view>

</view>
