/* pages/homework/homework.wxss */

.page {
  min-height: 100vh;
  padding: 0 32rpx 80rpx;
  background: #F5F5F7;
  box-sizing: border-box;
}

.header {
  padding: 32rpx 0 24rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
  color: #1D1D1F;
  letter-spacing: -0.02em;
  line-height: 1.2;
}

.subtitle {
  font-size: 24rpx;
  color: #6E6E73;
}

/* ====================== 听说读写模块宫格 ====================== */
.subject-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 16rpx;
}

.subject-module-item {
  position: relative;
  padding: 28rpx 24rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  box-sizing: border-box;
  transition: filter 0.18s ease;
}

.subject-module-item:active {
  filter: brightness(0.97);
}

.subject-module-top {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  margin-bottom: 4rpx;
}

.subject-module-icon-wrap {
  width: 64rpx;
  height: 64rpx;
  border-radius: 16rpx;
  background: #E6F7F5;
  display: flex;
  align-items: center;
  justify-content: center;
}

.subject-module-arrow-wrap {
  width: 32rpx;
  height: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.subject-module-label {
  font-size: 30rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.01em;
}

.subject-module-count {
  font-size: 22rpx;
  color: #8E8E93;
}

.subject-module-progress {
  height: 6rpx;
  border-radius: 999rpx;
  background: #F2F2F7;
  overflow: hidden;
}

.subject-module-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #12B7A8;
  transition: width 0.3s ease;
}

/* ====================== 模块作业明细 ====================== */
.subject-detail {
  display: flex;
  flex-direction: column;
}

.detail-header {
  padding: 8rpx 4rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 8rpx 20rpx 8rpx 8rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  color: #1D1D1F;
  font-size: 26rpx;
  font-weight: 500;
  transition: filter 0.18s ease;
}

.back-btn:active {
  filter: brightness(0.97);
}

.detail-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.01em;
}

.detail-count {
  font-size: 22rpx;
  color: #8E8E93;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.detail-item {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
  transition: filter 0.18s ease;
}

.detail-item:active {
  filter: brightness(0.98);
}

.detail-item-completed {
  opacity: 0.7;
}

.detail-col {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.detail-col-left {
  flex: 1;
  gap: 8rpx;
  justify-content: center;
}

.detail-col-right {
  flex-shrink: 0;
  width: 192rpx;
  gap: 10rpx;
  align-items: flex-end;
  border-left: 1rpx solid #E5E5EA;
  padding-left: 20rpx;
  justify-content: center;
}

.detail-student {
  display: flex;
  align-items: center;
  gap: 6rpx;
}

.detail-student-text {
  font-size: 22rpx;
  font-weight: 500;
  color: #12B7A8;
}

.detail-content {
  font-size: 28rpx;
  font-weight: 500;
  color: #1D1D1F;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.detail-item-completed .detail-content {
  color: #8E8E93;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.detail-tag {
  font-size: 20rpx;
  color: #6E6E73;
  background: #F2F2F7;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.detail-duration {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.detail-duration-value {
  font-size: 32rpx;
  font-weight: 700;
  color: #1D1D1F;
  line-height: 1;
  letter-spacing: -0.01em;
}

.detail-duration-value.spent {
  color: #12B7A8;
}

.detail-duration-unit {
  font-size: 20rpx;
  color: #8E8E93;
}

.detail-duration-label {
  font-size: 18rpx;
  color: #8E8E93;
  margin-top: -4rpx;
}

.detail-progress-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.detail-progress-track {
  width: 100%;
  height: 6rpx;
  border-radius: 999rpx;
  background: #F2F2F7;
  overflow: hidden;
}

.detail-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #12B7A8;
  transition: width 0.3s ease;
}

.detail-progress-text {
  font-size: 19rpx;
  color: #8E8E93;
}

/* ─── 打卡 + 专注按钮行 ─── */
.detail-actions-row {
  display: flex;
  align-items: center;
  gap: 8rpx;
  width: 100%;
}

.detail-checkin {
  flex: 1;
  min-width: 0;
  height: 56rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #F2F2F7;
  color: #6E6E73;
  font-size: 22rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  box-sizing: border-box;
  transition: filter 0.18s ease;
}

.detail-checkin:active {
  filter: brightness(0.96);
}

.detail-checkin.checked {
  background: #E6F7F5;
  color: #0E8C81;
}

/* 专注按钮：薄荷绿描边胶囊 */
.detail-focus-btn {
  flex-shrink: 0;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #E6F7F5;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 4rpx;
  color: #12B7A8;
  font-size: 22rpx;
  font-weight: 600;
  box-sizing: border-box;
  transition: filter 0.18s ease;
}

.detail-focus-btn:active {
  filter: brightness(0.95);
}

.detail-status-tag {
  min-width: 132rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #F2F2F7;
  color: #6E6E73;
  font-size: 22rpx;
  font-weight: 500;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.detail-status-tag.completed {
  background: #E6F7F5;
  color: #0E8C81;
}

.empty-homework {
  padding: 64rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
}

.empty-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.empty-text {
  font-size: 26rpx;
  color: #8E8E93;
}

/* ====================== 我的任务区域 ====================== */
.task-section {
  margin-top: 36rpx;
}

.task-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.task-section-titles {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.task-section-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  letter-spacing: -0.01em;
}

.task-section-sub {
  font-size: 22rpx;
  color: #8E8E93;
}

.task-add-btn {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 64rpx;
  padding: 0 24rpx;
  border-radius: 999rpx;
  background: #12B7A8;
  color: #FFFFFF;
  font-size: 26rpx;
  font-weight: 600;
  transition: filter 0.18s ease;
}

.task-add-btn:active {
  filter: brightness(0.92);
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  box-shadow: 0 1px 2px 0 rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}

.task-item-done {
  opacity: 0.7;
}

.task-check {
  flex-shrink: 0;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  border: 2rpx solid #D1D1D6;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: filter 0.18s ease;
}

.task-check:active {
  filter: brightness(0.95);
}

.task-check.checked {
  background: #12B7A8;
  border-color: #12B7A8;
}

.task-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}

.task-content {
  font-size: 28rpx;
  font-weight: 500;
  color: #1D1D1F;
  line-height: 1.4;
}

.task-item-done .task-content {
  text-decoration: line-through;
  color: #8E8E93;
}

.task-meta {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.task-duration {
  font-size: 22rpx;
  font-weight: 600;
  color: #6E6E73;
}

.task-duration.spent {
  color: #12B7A8;
}

.task-duration-label {
  font-size: 19rpx;
  color: #8E8E93;
}

.task-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 8rpx;
}

/* 专注按钮：薄荷绿描边胶囊 */
.task-focus-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  height: 56rpx;
  padding: 0 16rpx;
  border-radius: 999rpx;
  background: #E6F7F5;
  color: #12B7A8;
  font-size: 22rpx;
  font-weight: 600;
  transition: filter 0.18s ease;
}

.task-focus-btn:active {
  filter: brightness(0.95);
}

.task-del-btn {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #F2F2F7;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: filter 0.18s ease;
}

.task-del-btn:active {
  filter: brightness(0.95);
  background: #E5E5EA;
}

.task-empty {
  padding: 64rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  background: #FFFFFF;
  border-radius: 24rpx;
  border: 1rpx solid #E5E5EA;
}

.task-empty-icon-wrap {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-empty-text {
  font-size: 26rpx;
  color: #8E8E93;
}

/* ====================== 添加任务弹窗 ====================== */
.task-modal-overlay {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 950;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-modal-mask {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(0, 0, 0, 0.4);
}

.task-modal-card {
  position: relative;
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 24px 64px -12px rgba(0, 0, 0, 0.12);
  animation: modal-in 0.25s ease-out;
  box-sizing: border-box;
}

@keyframes modal-in {
  0% { opacity: 0; transform: translateY(20rpx); }
  100% { opacity: 1; transform: translateY(0); }
}

.task-modal-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #1D1D1F;
  margin-bottom: 28rpx;
  letter-spacing: -0.01em;
}

.task-modal-label {
  display: block;
  font-size: 22rpx;
  color: #8E8E93;
  font-weight: 500;
  text-transform: uppercase;
  letter-spacing: 0.06em;
  margin-bottom: 12rpx;
}

.task-modal-textarea {
  width: 100%;
  min-height: 120rpx;
  max-height: 300rpx;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  font-size: 28rpx;
  color: #1D1D1F;
  line-height: 1.5;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.task-modal-ph {
  color: #8E8E93;
}

.task-modal-time {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 32rpx;
}

.task-modal-time-input {
  flex: 1;
  height: 88rpx;
  padding: 0 24rpx;
  border-radius: 16rpx;
  background: #FFFFFF;
  border: 1rpx solid #E5E5EA;
  font-size: 28rpx;
  color: #1D1D1F;
  box-sizing: border-box;
}

.task-modal-time-unit {
  font-size: 26rpx;
  color: #8E8E93;
}

.task-modal-actions {
  display: flex;
  gap: 16rpx;
}

.task-modal-btn {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 999px;
  font-size: 30rpx;
  font-weight: 600;
  transition: filter 0.18s ease;
}

.task-modal-btn:active {
  filter: brightness(0.96);
}

.task-modal-btn.cancel {
  background: #F2F2F7;
  color: #6E6E73;
}

.task-modal-btn.confirm {
  background: #12B7A8;
  color: #FFFFFF;
}

.task-modal-btn.confirm.disabled {
  opacity: 0.42;
}
