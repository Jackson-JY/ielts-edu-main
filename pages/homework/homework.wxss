/* pages/homework/homework.wxss - 打卡记录页面 */
.page {
  background: #FFF9F5;
  min-height: 100vh;
  padding: 0 32rpx 40rpx;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 0 32rpx;
}
.title { font-size: 36rpx; font-weight: 700; color: #4A4A4A; }
.settings-btn { padding: 12rpx; }
.icon-settings { font-size: 40rpx; color: #9A97AA; }

/* Stats */
.stats-card {
  background: #F5F0FF;
  border-radius: 24rpx;
  padding: 48rpx 40rpx;
  text-align: center;
  margin-bottom: 32rpx;
}
.streak-num { display: block; font-size: 96rpx; font-weight: 800; color: #E8D4F8; line-height: 1.1; }
.streak-label { display: block; font-size: 30rpx; color: #4A4A4A; margin-bottom: 36rpx; }
.stats-row { display: flex; align-items: center; justify-content: center; gap: 40rpx; }
.stats-item { display: flex; flex-direction: column; align-items: center; gap: 8rpx; }
.stats-value { font-size: 32rpx; font-weight: 700; color: #4A4A4A; }
.stats-label { font-size: 24rpx; color: #9A97AA; }
.stats-divider { width: 2rpx; height: 60rpx; background: rgba(154,151,170,0.3); }

/* Section Cards */
.section-card {
  background: #F5F0FF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
}
.section-title { display: block; font-size: 28rpx; color: #9A97AA; margin-bottom: 24rpx; }

/* ========== 月份导航 ========== */
.month-nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 40rpx;
  margin-bottom: 28rpx;
}
.month-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #FFF9F5;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: opacity 0.15s, transform 0.15s;
}
.month-btn:active { opacity: 0.6; transform: scale(0.9); }
.month-btn-disabled {
  opacity: 0.3;
  pointer-events: none;
}
.month-arrow { font-size: 36rpx; color: #4A4A4A; line-height: 1; }
.month-label { font-size: 30rpx; font-weight: 600; color: #4A4A4A; min-width: 200rpx; text-align: center; }

/* ========== 日历（含热力图背景） ========== */
/* 图例 */
.heatmap-legend {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  gap: 8rpx;
  margin-top: 12rpx;
}
.legend-label {
  font-size: 20rpx;
  color: #9A97AA;
}
.legend-cell {
  width: 28rpx;
  height: 28rpx;
  border-radius: 4rpx;
}

/* Calendar（热力图背景合并） */
.calendar-header { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; margin-bottom: 12rpx; }
.cal-day-label { text-align: center; font-size: 24rpx; color: #9A97AA; }
.calendar-grid { display: grid; grid-template-columns: repeat(7, 1fr); gap: 8rpx; }
.calendar-cell {
  aspect-ratio: 1;
  padding: 8rpx 4rpx 4rpx;
  border-radius: 12rpx;
  border: 1rpx solid rgba(0,0,0,0.05);
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.15s, opacity 0.15s;
  overflow: hidden;
}
.calendar-cell:active { opacity: 0.7; transform: scale(0.92); }
.cal-day-num { font-size: 24rpx; font-weight: 600; margin-bottom: 4rpx; }
.cal-day-active { color: #4A4A4A; }
.cal-day-inactive { color: #9A97AA; }
.cal-day-empty { color: transparent; }
.cal-type-bars { display: flex; flex-direction: column; gap: 3rpx; width: 85%; flex: 1; justify-content: flex-end; }
.cal-type-bar { height: 6rpx; border-radius: 6rpx; width: 100%; }

/* Checkin List */
.checkin-list { display: flex; flex-direction: column; gap: 20rpx; }
.checkin-item {
  display: flex;
  gap: 20rpx;
  align-items: flex-start;
  padding-bottom: 20rpx;
  border-bottom: 1rpx solid rgba(154,151,170,0.15);
}
.checkin-item:last-child { border-bottom: none; padding-bottom: 0; }
.checkin-date-col { display: flex; flex-direction: column; align-items: center; min-width: 80rpx; }
.checkin-date-day { font-size: 36rpx; font-weight: 700; color: #4A4A4A; line-height: 1; }
.checkin-date-month { font-size: 22rpx; color: #9A97AA; }
.checkin-content-col { flex: 1; }
.checkin-types { display: flex; flex-wrap: wrap; gap: 8rpx; margin-bottom: 8rpx; }
.checkin-type-tag { font-size: 20rpx; padding: 4rpx 16rpx; border-radius: 20rpx; color: #4A4A4A; }
.checkin-text { font-size: 26rpx; color: #4A4A4A; line-height: 1.5; display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden; }
.empty-tip { text-align: center; font-size: 26rpx; color: #9A97AA; padding: 40rpx 0; }

/* FAB Button */
.fab-btn {
  position: fixed;
  right: 48rpx;
  bottom: 200rpx;
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  background: #A7FBF5;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 32rpx rgba(167,251,245,0.5);
  z-index: 100;
}
.fab-btn:active { transform: scale(0.92); }
.fab-icon { font-size: 52rpx; color: #4A4A4A; font-weight: 300; }

/* Modal */
.modal-mask {
  position: fixed;
  top: 0; left: 0; right: 0; bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
  padding: 48rpx;
}
.modal-content {
  width: 100%;
  max-width: 640rpx;
  background: #FFF9F5;
  border-radius: 28rpx;
  padding: 48rpx 40rpx;
  display: flex;
  flex-direction: column;
  gap: 32rpx;
}
.modal-title { font-size: 36rpx; font-weight: 700; color: #4A4A4A; }
.form-group { display: flex; flex-direction: column; gap: 16rpx; }
.form-label { font-size: 26rpx; color: #9A97AA; }
.type-options { display: flex; flex-wrap: wrap; gap: 16rpx; }
.type-option {
  padding: 16rpx 28rpx;
  border-radius: 20rpx;
  font-size: 26rpx;
  background: #F5F0FF;
  color: #4A4A4A;
}
.type-option-active { font-weight: 600; }
.form-textarea {
  width: 100%;
  min-height: 200rpx;
  background: #F5F0FF;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 26rpx;
  color: #4A4A4A;
  box-sizing: border-box;
}
.modal-btns { display: flex; gap: 24rpx; }
.modal-btn-cancel {
  flex: 1;
  padding: 28rpx;
  border-radius: 48rpx;
  background: #F5F0FF;
  text-align: center;
  font-size: 28rpx;
  color: #4A4A4A;
}
.modal-btn-confirm {
  flex: 1;
  padding: 28rpx;
  border-radius: 48rpx;
  background: #A7FBF5;
  text-align: center;
  font-size: 28rpx;
  color: #4A4A4A;
  font-weight: 600;
}
.modal-btn-cancel:active { opacity: 0.8; }
.modal-btn-confirm:active { opacity: 0.8; }
