/* pages/homework/homework.wxss */

.page {
  min-height: 100vh;
  padding: 0 32rpx 80rpx;
  background: #F6F8FB;
  box-sizing: border-box;
}

.header {
  padding: 40rpx 0 28rpx;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 800;
  color: #17212B;
  letter-spacing: 0;
}

.subtitle {
  font-size: 24rpx;
  color: #7A8794;
}

/* ====================== 听说读写模块宫格 ====================== */
.subject-grid {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
}

.subject-module-item {
  position: relative;
  padding: 32rpx 28rpx;
  border-radius: 24rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
  box-shadow: 0 8rpx 24rpx rgba(23, 33, 43, 0.04);
  display: flex;
  flex-direction: column;
  gap: 14rpx;
  box-sizing: border-box;
}

.subject-module-item:active {
  transform: scale(0.97);
}

.subject-module-icon-wrap {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}

.subject-module-icon {
  width: 44rpx;
  height: 44rpx;
}

.subject-module-label {
  font-size: 30rpx;
  font-weight: 800;
  color: #17212B;
}

.subject-module-count {
  font-size: 22rpx;
  color: #7A8794;
}

.subject-module-progress {
  height: 10rpx;
  border-radius: 999rpx;
  background: #F2F5F8;
  overflow: hidden;
}

.subject-module-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #12B7A8;
  transition: width 0.3s ease;
}

.subject-module-arrow {
  position: absolute;
  right: 24rpx;
  top: 28rpx;
  font-size: 32rpx;
  color: #C4CDD6;
}

/* ====================== 模块作业明细 ====================== */
.subject-detail {
  display: flex;
  flex-direction: column;
}

.detail-header {
  padding: 8rpx 4rpx 24rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.back-btn {
  display: flex;
  align-items: center;
  gap: 4rpx;
  padding: 10rpx 20rpx 10rpx 12rpx;
  border-radius: 999rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(23, 33, 43, 0.08);
  color: #17212B;
  font-size: 24rpx;
  font-weight: 600;
}

.back-arrow {
  font-size: 32rpx;
  line-height: 1;
}

.detail-title {
  flex: 1;
  font-size: 32rpx;
  font-weight: 800;
  color: #17212B;
}

.detail-count {
  font-size: 22rpx;
  color: #7A8794;
}

.detail-list {
  display: flex;
  flex-direction: column;
  gap: 18rpx;
}

.detail-item {
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  padding: 28rpx;
  border-radius: 22rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
  box-shadow: 0 8rpx 24rpx rgba(23, 33, 43, 0.04);
  box-sizing: border-box;
}

.detail-item:active {
  background: #F8FAFC;
}

.detail-item-completed {
  opacity: 0.8;
}

.detail-col {
  min-width: 0;
  display: flex;
  flex-direction: column;
}

.detail-col-left {
  flex: 1;
  gap: 10rpx;
  justify-content: center;
}

.detail-col-right {
  flex-shrink: 0;
  width: 192rpx;
  gap: 12rpx;
  align-items: flex-end;
  border-left: 1rpx solid rgba(23, 33, 43, 0.06);
  padding-left: 20rpx;
  justify-content: center;
}

.detail-student {
  font-size: 22rpx;
  font-weight: 700;
  color: #12B7A8;
}

.detail-content {
  font-size: 27rpx;
  font-weight: 600;
  color: #17212B;
  line-height: 1.5;
  display: -webkit-box;
  -webkit-line-clamp: 3;
  -webkit-box-orient: vertical;
  overflow: hidden;
}

.detail-item-completed .detail-content {
  color: #64717F;
}

.detail-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}

.detail-tag {
  font-size: 20rpx;
  color: #7A8794;
  background: #F2F5F8;
  border-radius: 999rpx;
  padding: 4rpx 14rpx;
}

.detail-duration {
  display: flex;
  align-items: baseline;
  gap: 4rpx;
}

.detail-duration-value {
  font-size: 34rpx;
  font-weight: 800;
  color: #17212B;
  line-height: 1;
}

/* 已有实际专注时长时，数字显示为品牌绿色 */
.detail-duration-value.spent {
  color: #12B7A8;
}

.detail-duration-unit {
  font-size: 20rpx;
  color: #7A8794;
}

/* "已专注" / "预估" 小标签 */
.detail-duration-label {
  font-size: 18rpx;
  color: #9AA5B1;
  margin-top: -6rpx;
}

.detail-progress-wrap {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  gap: 6rpx;
}

.detail-progress-track {
  width: 100%;
  height: 8rpx;
  border-radius: 999rpx;
  background: #F2F5F8;
  overflow: hidden;
}

.detail-progress-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #12B7A8;
  transition: width 0.3s ease;
}

.detail-progress-text {
  font-size: 19rpx;
  color: #9AA5B1;
}

/* ─── 打卡 + 番茄按钮行 ─── */
.detail-actions-row {
  display: flex;
  align-items: center;
  gap: 10rpx;
  width: 100%;
}

.detail-checkin {
  flex: 1;
  height: 56rpx;
  padding: 0 12rpx;
  border-radius: 999rpx;
  background: #F6F8FB;
  border: 1rpx solid rgba(23, 33, 43, 0.1);
  color: #64717F;
  font-size: 21rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

/* 🍅 番茄时钟按钮 */
.pomodoro-btn {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 99, 71, 0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  box-sizing: border-box;
}

.pomodoro-btn:active {
  transform: scale(0.90);
  background: rgba(255, 99, 71, 0.18);
}

.detail-checkin:active {
  transform: scale(0.96);
}

.detail-checkin.checked {
  background: rgba(18, 183, 168, 0.12);
  border-color: transparent;
  color: #12B7A8;
}

.detail-status-tag {
  min-width: 132rpx;
  height: 56rpx;
  padding: 0 18rpx;
  border-radius: 999rpx;
  background: #F2F5F8;
  color: #64717F;
  font-size: 22rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
}

.detail-status-tag.completed {
  background: rgba(18, 183, 168, 0.12);
  color: #12B7A8;
}

.empty-homework {
  padding: 64rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 22rpx;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
}

.empty-text {
  font-size: 26rpx;
  color: #7A8794;
}

/* ====================== 我的任务区域 ====================== */
.task-section {
  margin-top: 36rpx;
}

.task-section-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 4rpx;
}

.task-section-titles {
  display: flex;
  flex-direction: column;
  gap: 4rpx;
}

.task-section-title {
  font-size: 32rpx;
  font-weight: 800;
  color: #17212B;
}

.task-section-sub {
  font-size: 22rpx;
  color: #9AA5B1;
}

.task-add-btn {
  flex-shrink: 0;
  padding: 14rpx 28rpx;
  border-radius: 999rpx;
  background: #12B7A8;
  color: #FFFFFF;
  font-size: 25rpx;
  font-weight: 700;
  box-shadow: 0 8rpx 20rpx rgba(18, 183, 168, 0.24);
}

.task-add-btn:active {
  transform: scale(0.95);
}

.task-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}

.task-item {
  display: flex;
  align-items: center;
  gap: 18rpx;
  padding: 24rpx;
  border-radius: 20rpx;
  background: #FFFFFF;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
  box-shadow: 0 8rpx 24rpx rgba(23, 33, 43, 0.04);
  box-sizing: border-box;
}

.task-item-done {
  opacity: 0.7;
}

.task-check {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  border: 2rpx solid #C4CDD6;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #FFFFFF;
  font-size: 28rpx;
  font-weight: 800;
}

.task-check.checked {
  background: #12B7A8;
  border-color: #12B7A8;
}

.task-check:active {
  transform: scale(0.9);
}

.task-body {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}

.task-content {
  font-size: 28rpx;
  font-weight: 600;
  color: #17212B;
  line-height: 1.45;
}

.task-item-done .task-content {
  text-decoration: line-through;
  color: #9AA5B1;
}

.task-meta {
  display: flex;
  align-items: baseline;
  gap: 8rpx;
}

.task-duration {
  font-size: 23rpx;
  font-weight: 700;
  color: #64717F;
}

.task-duration.spent {
  color: #12B7A8;
}

.task-duration-label {
  font-size: 19rpx;
  color: #9AA5B1;
}

.task-actions {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  gap: 10rpx;
}

.task-pomodoro-btn {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 99, 71, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.task-pomodoro-btn:active {
  transform: scale(0.9);
}

.task-del-btn {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: rgba(23, 33, 43, 0.06);
  color: #9AA5B1;
  font-size: 32rpx;
  line-height: 44rpx;
  text-align: center;
}

.task-del-btn:active {
  transform: scale(0.9);
}

.task-empty {
  padding: 48rpx 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  border: 1rpx dashed rgba(23, 33, 43, 0.12);
}

.task-empty-text {
  font-size: 25rpx;
  color: #9AA5B1;
}

/* ====================== 添加任务弹窗 ====================== */
.task-modal-overlay {
  position: fixed;
  left: 0; top: 0; right: 0; bottom: 0;
  z-index: 950;
  display: flex;
  align-items: center;
  justify-content: center;
}

.task-modal-mask {
  position: absolute;
  left: 0; top: 0; right: 0; bottom: 0;
  background: rgba(23, 33, 43, 0.5);
}

.task-modal-card {
  position: relative;
  width: 600rpx;
  background: #FFFFFF;
  border-radius: 32rpx;
  padding: 40rpx;
  box-shadow: 0 30rpx 80rpx rgba(23, 33, 47, 0.28);
  animation: task-modal-pop 0.3s cubic-bezier(0.34, 1.56, 0.64, 1);
  box-sizing: border-box;
}

@keyframes task-modal-pop {
  0% { transform: scale(0.8); opacity: 0; }
  100% { transform: scale(1); opacity: 1; }
}

.task-modal-title {
  display: block;
  font-size: 34rpx;
  font-weight: 800;
  color: #17212B;
  margin-bottom: 28rpx;
}

.task-modal-label {
  display: block;
  font-size: 24rpx;
  color: #7A8794;
  font-weight: 600;
  margin-bottom: 12rpx;
}

.task-modal-textarea {
  width: 100%;
  min-height: 120rpx;
  max-height: 300rpx;
  padding: 22rpx;
  border-radius: 18rpx;
  background: #F6F8FB;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
  font-size: 28rpx;
  color: #17212B;
  line-height: 1.6;
  box-sizing: border-box;
  margin-bottom: 24rpx;
}

.task-modal-ph {
  color: #B5BEC8;
}

.task-modal-time {
  display: flex;
  align-items: center;
  gap: 14rpx;
  margin-bottom: 32rpx;
}

.task-modal-time-input {
  flex: 1;
  height: 84rpx;
  padding: 0 22rpx;
  border-radius: 18rpx;
  background: #F6F8FB;
  border: 1rpx solid rgba(23, 33, 43, 0.06);
  font-size: 28rpx;
  color: #17212B;
  box-sizing: border-box;
}

.task-modal-time-unit {
  font-size: 26rpx;
  color: #7A8794;
}

.task-modal-actions {
  display: flex;
  gap: 16rpx;
}

.task-modal-btn {
  flex: 1;
  height: 88rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 18rpx;
  font-size: 28rpx;
  font-weight: 700;
}

.task-modal-btn:active {
  transform: scale(0.97);
}

.task-modal-btn.cancel {
  background: #F6F8FB;
  color: #64717F;
  border: 1rpx solid rgba(23, 33, 43, 0.08);
}

.task-modal-btn.confirm {
  background: #12B7A8;
  color: #FFFFFF;
  box-shadow: 0 10rpx 24rpx rgba(18, 183, 168, 0.22);
}

.task-modal-btn.confirm.disabled {
  opacity: 0.6;
}
