/* pages/homework/homework.wxss - 作业页面 */
.page {
  background: linear-gradient(180deg, #FFF9F5 0%, #FFF5F0 100%);
  min-height: 100vh;
  padding: 0 32rpx 40rpx;
  overflow-y: auto;
  box-sizing: border-box;
}

.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 40rpx 0 32rpx;
}
.title { font-size: 38rpx; font-weight: 700; color: #4A4A4A; letter-spacing: 1rpx; }

/* Section Cards */
.section-card {
  background: linear-gradient(145deg, #F8F4FF 0%, #F0E8FF 100%);
  border-radius: 32rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 
    0 4rpx 20rpx rgba(154, 151, 170, 0.15),
    0 1rpx 3rpx rgba(0, 0, 0, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.8);
  position: relative;
  overflow: hidden;
}
.section-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 20%;
  right: 20%;
  height: 2rpx;
  background: linear-gradient(90deg, transparent, rgba(255,255,255,0.8), transparent);
}
.section-title { display: block; font-size: 28rpx; color: #9A97AA; margin-bottom: 24rpx; }

/* Section Header */
.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}
.section-header .section-title {
  margin-bottom: 0;
}
.section-subtitle {
  font-size: 24rpx;
  color: #6C5CE7;
  font-weight: 500;
}

/* Homework List */
.homework-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.homework-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: linear-gradient(180deg, #FFFDFB 0%, #FFF9F5 100%);
  border-radius: 24rpx;
  padding: 28rpx 24rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.05);
  border: 2rpx solid transparent;
  transition: all 0.2s ease;
}
.homework-item:active {
  transform: scale(0.98);
  opacity: 0.9;
}
.homework-urgent {
  border-color: #FF9800;
  background: linear-gradient(180deg, #FFF8E7 0%, #FFF3D9 100%);
}
.homework-overdue {
  border-color: #FF6B6B;
  background: linear-gradient(180deg, #FFF0F0 0%, #FFE8E8 100%);
}
.homework-main {
  flex: 1;
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}
.homework-info {
  display: flex;
  flex-direction: column;
  gap: 8rpx;
}
.homework-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #4A4A4A;
  line-height: 1.3;
}
.homework-desc {
  font-size: 24rpx;
  color: #9A97AA;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.homework-course {
  font-size: 22rpx;
  color: #6C5CE7;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-line-clamp: 1;
  -webkit-box-orient: vertical;
  overflow: hidden;
}
.homework-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.subject-tag {
  font-size: 22rpx;
  color: #6C5CE7;
  background: rgba(108, 92, 231, 0.1);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}
.homework-deadline {
  display: flex;
  align-items: center;
  gap: 6rpx;
  font-size: 22rpx;
  color: #9A97AA;
}
.deadline-icon {
  font-size: 20rpx;
}
.deadline-urgent {
  color: #FF9800;
  font-weight: 500;
}
.deadline-overdue {
  color: #FF6B6B;
  font-weight: 500;
}
.homework-arrow {
  font-size: 36rpx;
  color: #9A97AA;
  margin-left: 16rpx;
}

/* 空作业提示 */
.empty-homework {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 48rpx 32rpx;
  background: linear-gradient(180deg, #FFFDFB 0%, #FFF9F5 100%);
  border-radius: 24rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #9A97AA;
}
